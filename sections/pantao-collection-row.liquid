{%- comment -%}
  PANTAO collection row
  ----------------------------------------------------------------
  A homepage product row from a chosen collection, using the house card
  language (hover zoom). Real products
  and images. Theme tokens for type/colour so it matches the site.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign coll = s.collection
  if coll == blank
    assign coll = collections.all
  endif
  assign count = s.count | default: 4
-%}

<div class="pantao-collrow" data-section-id="{{ section.id }}">
  <div class="pantao-collrow__wrap">
    <div class="pantao-collrow__head">
      {%- if s.eyebrow != blank -%}<span class="pantao-collrow__eyebrow">{{ s.eyebrow | escape }}</span>{%- endif -%}
      {%- if s.view_all_link != blank and s.view_all_label != blank -%}
        <a class="pantao-collrow__all" href="{{ s.view_all_link }}">{{ s.view_all_label | escape }}</a>
      {%- endif -%}
    </div>

    <div class="pantao-collrow__grid" style="--collrow-count: {{ count }};">
      {%- for product in coll.products limit: count -%}
        <a class="pantao-collrow__card" href="{{ product.url }}">
          <div class="pantao-collrow__media">
            {%- if product.featured_media != blank -%}
              <img class="pantao-collrow__img"
                src="{{ product.featured_media | image_url: width: 700 }}"
                srcset="{{ product.featured_media | image_url: width: 500 }} 500w, {{ product.featured_media | image_url: width: 800 }} 800w, {{ product.featured_media | image_url: width: 1100 }} 1100w"
                sizes="(min-width: 990px) 22vw, (min-width: 750px) 45vw, 90vw"
                alt="{{ product.featured_media.alt | default: product.title | escape }}" loading="lazy"
                width="{{ product.featured_media.width }}" height="{{ product.featured_media.height }}">
            {%- else -%}
              <div class="pantao-collrow__ph">{{ 'product-1' | placeholder_svg_tag: 'pantao-collrow__ph-svg' }}</div>
            {%- endif -%}
            <div class="pantao-collrow__info">
              <p class="pantao-collrow__title">{{ product.title | escape }}</p>
              <span class="pantao-collrow__price">{{ product.price | money }}</span>
            </div>
          </div>
        </a>
      {%- else -%}
        <p class="pantao-collrow__empty">Add a collection to show products here.</p>
      {%- endfor -%}
    </div>
  </div>
</div>

<style>
  #shopify-section-{{ section.id }} { margin: 0; }
  .pantao-collrow{
    --cr-ink: var(--color-foreground, #16181c);
    --cr-muted: color-mix(in srgb, var(--color-foreground, #16181c) 54%, transparent);
    --cr-line: color-mix(in srgb, var(--color-foreground, #16181c) 12%, transparent);
    --cr-surface: color-mix(in srgb, var(--color-foreground, #16181c) 8%, var(--color-background, #f4f4f2));
    --cr-sans: var(--font-body--family, -apple-system, system-ui, sans-serif);
    background: var(--color-background, #f4f4f2); color: var(--cr-ink); font-family: var(--cr-sans);
  }
  /* Acne "Discover more" layout: edge-to-edge row, 30px gutters, 10px gaps,
     tall 2:3 tiles, small caps heading, labels set inside the tile bottom-left. */
  .pantao-collrow__wrap{ padding: 60px 30px 90px; }
  .pantao-collrow__head{ display:flex; align-items:baseline; justify-content:space-between; gap:20px; margin-bottom:18px; }
  .pantao-collrow__eyebrow{ font-size:12px; font-weight:400; letter-spacing:.02em; text-transform:uppercase; color:var(--cr-ink); }
  .pantao-collrow__all{ font-size:12px; letter-spacing:.02em; text-transform:uppercase; color:var(--cr-ink); text-decoration:none; }
  .pantao-collrow__all:hover{ text-decoration:underline; text-underline-offset:3px; }
  .pantao-collrow__grid{ display:grid; grid-template-columns:repeat(var(--collrow-count,4),1fr); gap:10px; }
  @media(max-width:860px){
    .pantao-collrow__wrap{ padding: 40px 10px 60px; }
    .pantao-collrow__grid{ grid-template-columns:1fr 1fr; gap:6px; }
  }
  .pantao-collrow__card{ text-decoration:none; color:inherit; display:block; }
  .pantao-collrow__media{ position:relative; container:pantao-card / inline-size; aspect-ratio:2/3; border-radius:0; overflow:hidden; background:var(--cr-surface); }
  .pantao-collrow__img, .pantao-collrow__ph{ position:absolute; inset:0; width:100%; height:100%; object-fit:cover; transition:transform .6s cubic-bezier(.22,1,.36,1); }
  .pantao-collrow__ph{ display:flex; }
  .pantao-collrow__ph-svg{ width:100%; height:100%; object-fit:cover; opacity:.4; }
  @media(hover:hover){ .pantao-collrow__card:hover .pantao-collrow__img, .pantao-collrow__card:hover .pantao-collrow__ph{ transform:scale(1.03); } }
  .pantao-collrow__info{ position:absolute; left:12px; right:12px; bottom:12px; z-index:2; display:flex; justify-content:space-between; align-items:baseline; gap:12px; color:#141414; pointer-events:none; }
  .pantao-collrow__title{ font-size:11px; font-weight:400; letter-spacing:.02em; text-transform:uppercase; margin:0; min-width:0; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .pantao-collrow__price{ font-size:11px; letter-spacing:.02em; white-space:nowrap; flex-shrink:0; }
  .pantao-collrow__empty{ color:var(--cr-muted); grid-column:1/-1; }
  @media(prefers-reduced-motion:reduce){ .pantao-collrow__img,.pantao-collrow__ph{ transition:none!important; } }
</style>

{% schema %}
{
  "name": "PANTAO Collection row",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Collection" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "count", "label": "Products to show", "min": 2, "max": 8, "step": 1, "default": 4 },
    { "type": "text", "id": "view_all_label", "label": "View-all label", "default": "View all" },
    { "type": "url", "id": "view_all_link", "label": "View-all link" }
  ],
  "presets": [ { "name": "PANTAO Collection row" } ]
}
{% endschema %}
