{%- comment -%} PANTAO Help / FAQ page: quiet Acne-style list of questions that open in place. {%- endcomment -%}
<section class="pantao-faq">
  <div class="pantao-faq__inner">
    <h1 class="pantao-faq__title">{{ section.settings.heading }}</h1>
    {%- if section.settings.intro != blank -%}<div class="pantao-faq__intro">{{ section.settings.intro }}</div>{%- endif -%}
    {%- assign current_group = '' -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'group' -%}
        <h2 class="pantao-faq__group" {{ block.shopify_attributes }}>{{ block.settings.title }}</h2>
      {%- else -%}
        <details class="pantao-faq__item" {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question }}</summary>
          <div class="pantao-faq__answer">{{ block.settings.answer }}</div>
        </details>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

<style>
  .pantao-faq { padding: 56px 40px 96px; }
  .pantao-faq__inner { max-width: 720px; }
  .pantao-faq__title { margin: 0 0 8px; font-family: var(--font-body--family); font-size: 12px !important; font-weight: 400; letter-spacing: 0.02em; text-transform: uppercase; }
  .pantao-faq__intro { font-size: 12px; line-height: 1.6; color: rgb(20 20 20 / 0.7); margin-bottom: 32px; }
  .pantao-faq__intro p { margin: 0; }
  .pantao-faq__intro a, .pantao-faq__answer a { color: #141414; text-underline-offset: 3px; }
  .pantao-faq__group { margin: 40px 0 0; padding-bottom: 10px; border-bottom: 1px solid #141414; font-family: var(--font-body--family); font-size: 11px !important; font-weight: 400; letter-spacing: 0.04em; text-transform: uppercase; }
  .pantao-faq__item { border-bottom: 1px solid #ececec; }
  .pantao-faq__item summary {
    list-style: none; display: flex; justify-content: space-between; gap: 16px;
    padding: 14px 0; font-size: 12px; letter-spacing: 0.02em; text-transform: uppercase; cursor: pointer;
  }
  .pantao-faq__item summary::-webkit-details-marker { display: none; }
  .pantao-faq__item summary::after { content: '+'; font-size: 14px; line-height: 1; }
  .pantao-faq__item[open] summary::after { content: '–'; }
  .pantao-faq__answer { padding: 0 0 18px; font-size: 12px; line-height: 1.65; color: rgb(20 20 20 / 0.8); max-width: 60ch; }
  .pantao-faq__answer p { margin: 0 0 8px; }
  @media screen and (max-width: 749px) { .pantao-faq { padding: 32px 16px 64px; } }
</style>

{% schema %}
{
  "name": "Help / FAQ",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Help" },
    { "type": "richtext", "id": "intro", "label": "Intro" }
  ],
  "blocks": [
    { "type": "group", "name": "Group heading", "settings": [ { "type": "text", "id": "title", "label": "Title", "default": "Orders" } ] },
    { "type": "question", "name": "Question", "settings": [
      { "type": "text", "id": "question", "label": "Question", "default": "Question" },
      { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Answer</p>" }
    ] }
  ],
  "presets": [ { "name": "Help / FAQ" } ]
}
{% endschema %}
