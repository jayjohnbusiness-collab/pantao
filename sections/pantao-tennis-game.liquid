</style>

<script>
  // === Stepper / email gate ===
  (function () {
    const STORAGE_KEY = 'pantao-gate-passed';
    const steppers = document.querySelectorAll('[data-pantao-stepper]');
    steppers.forEach(initStepper);

    function initStepper(stepper) {
      const form = stepper.querySelector('#pantao-stepper-form');
      const emailInput = stepper.querySelector('#pantao-stepper-email');
      const submit = stepper.querySelector('.pantao-stepper__gate-submit');
      const errorEl = stepper.querySelector('[data-gate-error]');

      // No form means gate is disabled — section is in "game" state already.
      if (!form) return;

      // Returning visitor on this browser: skip the gate
      let alreadyPassed = false;
      try {
        alreadyPassed = localStorage.getItem(STORAGE_KEY) === '1';
      } catch (e) { /* private mode etc. */ }
      if (alreadyPassed) {
        revealGame(stepper);
      }

      function showError(msg) {
        if (!errorEl) return;
        errorEl.textContent = msg;
        errorEl.hidden = false;
      }
      function clearError() {
        if (!errorEl) return;
        errorEl.textContent = '';
        errorEl.hidden = true;
      }
      function isValidEmail(v) {
        return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v);
      }

      form.addEventListener('submit', (e) => {
        const email = (emailInput && emailInput.value || '').trim();
        if (!isValidEmail(email)) {
          e.preventDefault();
          showError('Please enter a valid email address.');
          return;
        }
        // Use a native form submission (not AJAX). Shopify's spam protection
        // is much friendlier to native submits — fetch-based POSTs to /contact
        // tend to trigger the human-verification challenge. The form has the
        // right hidden tokens because it's wrapped in a customer form,
        // so the browser will POST it correctly. Shopify will redirect back
        // with ?customer_posted=true, and the Liquid template detects that
        // via customer.posted? to render directly in "game" state.
        clearError();
        if (submit) {
          submit.disabled = true;
          submit.textContent = 'Sending…';
        }
        // Set the localStorage flag now so even if redirect cookies behave
        // oddly, the gate will be skipped on the next visit.
        try { localStorage.setItem(STORAGE_KEY, '1'); } catch (err) {}
        // Let the form submit naturally — do NOT preventDefault.
      });

      if (emailInput) {
        emailInput.addEventListener('input', clearError);
      }
    }

    function revealGame(stepper) {
      stepper.setAttribute('data-step', 'game');
      // Fire a resize so the tennis canvas refreshes its layout if it
      // measured itself while the stepper was in gate state
      if (typeof window !== 'undefined') {
        window.dispatchEvent(new Event('resize'));
      }
    }
  })();

  // === Tennis game ===
  (function () {
    const roots = document.querySelectorAll('[data-pantao-tennis]');
    roots.forEach(initGame);

    function initGame(root) {
      const canvas = root.querySelector('[data-court]');
      const ctx = canvas.getContext('2d');
      const overlay = root.querySelector('[data-overlay]');
      const overlayTitle = root.querySelector('[data-overlay-title]');
      const overlayText = root.querySelector('[data-overlay-text]');
      const startBtn = root.querySelector('[data-start]');
      const resetBtn = root.querySelector('[data-reset]');
      const playerScoreEl = root.querySelector('[data-player-score]');
      const cpuScoreEl = root.querySelector('[data-cpu-score]');
      const playerLabelEl = root.querySelector('[data-player-label]');
      const statusEl = root.querySelector('[data-status]');
      const chips = root.querySelectorAll('[data-difficulty]');
      const nameInput = root.querySelector('[data-name-input]');
      const flagSelect = root.querySelector('[data-flag-select]');

      const WIN_SCORE = {{ section.settings.win_score | default: 5 | json }};
      const CW = canvas.width;        // Full canvas width (includes crowd)
      const CH = canvas.height;       // Full canvas height (includes crowd)
      const PAD = 90;                 // Crowd band thickness around court
      const W = CW - PAD * 2;         // Court width (game logic uses this)
      const H = CH - PAD * 2;         // Court height (game logic uses this)
      const WALL_THICK = 14;          // Stadium courtside wall thickness

      const DIFFICULTY = {
        easy:   { cpuSpeed: 5.6, ballSpeed: 6.2, spin: 0.22 },
        normal: { cpuSpeed: 7.4, ballSpeed: 7.4, spin: 0.28 },
        hard:   { cpuSpeed: 8.8, ballSpeed: 8.6, spin: 0.34 },
        pro:    { cpuSpeed: 10.2, ballSpeed: 9.8, spin: 0.40 }
      };
      const DIFFICULTY_ORDER = ['easy', 'normal', 'hard', 'pro'];
      const DIFFICULTY_LABEL = { easy: 'Easy', normal: 'Normal', hard: 'Hard', pro: 'Pro' };

      const state = {
        running: false,
        paused: false,
        difficulty: 'easy',
        playerName: '',
        playerFlag: '',
        playerScore: 0,
        cpuScore: 0,
        player: { x: 24, y: H / 2 - 50, w: 10, h: 100, vy: 0, prevY: H / 2 - 50 },
        cpu:    { x: W - 24 - 10, y: H / 2 - 50, w: 10, h: 100, vy: 0, prevY: H / 2 - 50 },
        ball:   { x: W / 2, y: H / 2, r: 9, vx: 0, vy: 0, spin: 0, rotation: 0, prevX: W / 2, prevY: H / 2 },
        lastTime: 0,
        keys: { up: false, down: false },
        pointerY: null,
        countdown: 0
      };

      // Knight watermark — preload from inline base64
      const knightImg = new Image();
      let knightReady = false;
      knightImg.onload = () => { knightReady = true; draw(); };
      knightImg.src = 'data:image/png;base64,';

      // ---- Stadium canvas: pre-rendered once on init for performance ----
      // We draw the entire Wimbledon-style stadium frame (walls, crowd, umpire,
      // benches, line judges, ballkids, signage) into an offscreen canvas,
      // then blit it each frame instead of redrawing hundreds of elements.
      const crowdCanvas = document.createElement('canvas');
      crowdCanvas.width = CW;
      crowdCanvas.height = CH;
      buildCrowd();

      function buildCrowd() {
        const cctx = crowdCanvas.getContext('2d');

        // Wimbledon palette
        const WALL = '#1d3d1d';      // dark green courtside wall
        const PURPLE = '#503d6e';    // AELTC purple trim
        const BENCH = '#1a3d1a';     // dark green bench/chair
        const NAVY = '#2a3d5a';      // judge / ballkid uniform navy
        const CREAM = '#e8dcc4';     // pants / Wimbledon cream
        const TOWEL_GREEN = '#2d5a2d';

        // Stadium back-fill (very dark green, behind crowd)
        cctx.fillStyle = '#0d1f0d';
        cctx.fillRect(0, 0, CW, CH);

        // Seeded RNG for consistent visuals
        let seed = 1337;
        const rand = () => { seed = (seed * 9301 + 49297) % 233280; return seed / 233280; };
        const rint = (min, max) => Math.floor(rand() * (max - min + 1)) + min;
        const pick = (arr) => arr[Math.floor(rand() * arr.length)];

        // Wimbledon summer-attire spectator palette — pale, varied, refined
        const bodyColors = [
          '#e8dcc4', '#d4c4a0', '#a8b8c8', '#3a4a6a', '#7a6a4a',
          '#c8b89c', '#e0d4b8', '#5a4a3a', '#b8a89c', '#8a9aaa', '#dcc8a8'
        ];
        const headColors = ['#d4a87c', '#8a6648', '#c08a64', '#5c4030', '#a47854', '#9a7050'];
        const hatColors = ['#e8dcc4', '#d4c4a0', '#c8b89c', null, null, null, null];

        function drawSpectator(cx, cy) {
          const headR = 4, bodyW = 12, bodyH = 10;
          cctx.fillStyle = pick(bodyColors);
          cctx.beginPath();
          cctx.ellipse(cx, cy + headR, bodyW / 2, bodyH / 2, 0, 0, Math.PI * 2);
          cctx.fill();
          cctx.fillStyle = pick(headColors);
          cctx.beginPath();
          cctx.arc(cx, cy - bodyH / 2 + 2, headR, 0, Math.PI * 2);
          cctx.fill();
          // Occasional summer hat
          const hat = pick(hatColors);
          if (hat) {
            cctx.fillStyle = hat;
            cctx.beginPath();
            cctx.ellipse(cx, cy - bodyH / 2 + 1, headR + 1, 1.5, 0, 0, Math.PI * 2);
            cctx.fill();
          }
        }

        // Crowd — three rows wrapping all four sides
        const ROWS = 3, ROW_SPACING = 18, COL_SPACING = 16;
        for (let row = 0; row < ROWS; row++) {
          let y = PAD - 22 - row * ROW_SPACING;
          if (y >= 8) {
            for (let x = 12 + (row % 2) * 8; x < CW - 12; x += COL_SPACING) {
              drawSpectator(x + rint(-2, 2), y + rint(-2, 2));
            }
          }
          y = PAD + H + 22 + row * ROW_SPACING;
          if (y <= CH - 8) {
            for (let x = 12 + (row % 2) * 8; x < CW - 12; x += COL_SPACING) {
              drawSpectator(x + rint(-2, 2), y + rint(-2, 2));
            }
          }
          let x = PAD - 22 - row * ROW_SPACING;
          if (x >= 8) {
            for (let yy = PAD + 8 + (row % 2) * 8; yy < PAD + H - 8; yy += COL_SPACING) {
              drawSpectator(x + rint(-2, 2), yy + rint(-2, 2));
            }
          }
          x = PAD + W + 22 + row * ROW_SPACING;
          if (x <= CW - 8) {
            for (let yy = PAD + 8 + (row % 2) * 8; yy < PAD + H - 8; yy += COL_SPACING) {
              drawSpectator(x + rint(-2, 2), yy + rint(-2, 2));
            }
          }
        }

        // ===== Dark green courtside wall (with purple AELTC trim) =====
        cctx.fillStyle = WALL;
        cctx.fillRect(PAD - WALL_THICK, PAD - WALL_THICK, W + WALL_THICK * 2, WALL_THICK);             // top
        cctx.fillRect(PAD - WALL_THICK, PAD + H, W + WALL_THICK * 2, WALL_THICK);                       // bottom
        cctx.fillRect(PAD - WALL_THICK, PAD - WALL_THICK, WALL_THICK, H + WALL_THICK * 2);             // left
        cctx.fillRect(PAD + W, PAD - WALL_THICK, WALL_THICK, H + WALL_THICK * 2);                       // right

        // Purple trim line on outer edge of wall
        cctx.fillStyle = PURPLE;
        cctx.fillRect(PAD - WALL_THICK, PAD - WALL_THICK, W + WALL_THICK * 2, 3);
        cctx.fillRect(PAD - WALL_THICK, PAD + H + WALL_THICK - 3, W + WALL_THICK * 2, 3);
        cctx.fillRect(PAD - WALL_THICK, PAD - WALL_THICK, 3, H + WALL_THICK * 2);
        cctx.fillRect(PAD + W + WALL_THICK - 3, PAD - WALL_THICK, 3, H + WALL_THICK * 2);

        // Inner thin black line where wall meets court
        cctx.strokeStyle = '#000';
        cctx.lineWidth = 1;
        cctx.strokeRect(PAD - 0.5, PAD - 0.5, W + 1, H + 1);

        // ===== Signage on the walls =====
        cctx.fillStyle = '#ffffff';
        cctx.font = 'bold 9px sans-serif';
        cctx.textAlign = 'center';
        cctx.textBaseline = 'middle';
        // Top wall: "THE CHAMPIONSHIPS"
        cctx.fillText('THE CHAMPIONSHIPS', PAD + W / 2, PAD - WALL_THICK / 2 - 1);
        // Bottom wall: "WIMBLEDON"
        cctx.font = 'bold 11px sans-serif';
        cctx.fillText('WIMBLEDON', PAD + W / 2, PAD + H + WALL_THICK / 2 + 1);

        // Scoreboard is drawn separately each frame in draw() so it can update
        // with the live score, name, and flag.

        // ===== Umpire chair (top sideline, at the net) =====
        // Wimbledon umpire chair sits raised above the courtside wall.
        const umpCx = PAD + W / 2;
        const umpCy = PAD - WALL_THICK - 22;
        // Chair platform (dark green)
        cctx.fillStyle = BENCH;
        cctx.fillRect(umpCx - 25, umpCy - 16, 50, 36);
        cctx.strokeStyle = '#000';
        cctx.lineWidth = 1.5;
        cctx.strokeRect(umpCx - 25, umpCy - 16, 50, 36);
        // Chair backrest (top edge — visible high back)
        cctx.fillStyle = '#0d2510';
        cctx.fillRect(umpCx - 22, umpCy - 16, 44, 8);
        // Side armrests
        cctx.fillStyle = '#0d2510';
        cctx.fillRect(umpCx - 25, umpCy - 8, 4, 28);
        cctx.fillRect(umpCx + 21, umpCy - 8, 4, 28);
        // Umpire figure — navy blazer
        cctx.fillStyle = NAVY;
        cctx.beginPath();
        cctx.ellipse(umpCx, umpCy + 5, 10, 8, 0, 0, Math.PI * 2);
        cctx.fill();
        // White shirt collar visible
        cctx.fillStyle = '#ffffff';
        cctx.fillRect(umpCx - 3, umpCy + 1, 6, 4);
        // Head
        cctx.fillStyle = '#d4a87c';
        cctx.beginPath();
        cctx.arc(umpCx, umpCy - 3, 5, 0, Math.PI * 2);
        cctx.fill();
        // Visor / hair shadow
        cctx.fillStyle = '#3a2a1a';
        cctx.beginPath();
        cctx.arc(umpCx, umpCy - 5, 5, Math.PI, Math.PI * 2);
        cctx.fill();
        // Microphone arm extending toward court
        cctx.strokeStyle = '#1a1a1a';
        cctx.lineWidth = 2;
        cctx.beginPath();
        cctx.moveTo(umpCx, umpCy + 13);
        cctx.lineTo(umpCx, umpCy + 28);
        cctx.stroke();
        cctx.fillStyle = '#1a1a1a';
        cctx.beginPath();
        cctx.arc(umpCx, umpCy + 28, 2.5, 0, Math.PI * 2);
        cctx.fill();

        // ===== Player benches (bottom sideline, one each side of net) =====
        function drawBench(cx, cy) {
          const bw = 92, bh = 30;
          // Frame
          cctx.fillStyle = BENCH;
          cctx.fillRect(cx - bw / 2, cy - bh / 2, bw, bh);
          cctx.strokeStyle = '#000';
          cctx.lineWidth = 1.5;
          cctx.strokeRect(cx - bw / 2, cy - bh / 2, bw, bh);
          // Backrest
          cctx.fillStyle = '#0d2510';
          cctx.fillRect(cx - bw / 2 + 2, cy + bh / 2 - 6, bw - 4, 4);
          // Folded towel — purple/green Wimbledon stripe
          const tx = cx - 38, ty = cy - 11;
          cctx.fillStyle = PURPLE;
          cctx.fillRect(tx, ty, 30, 22);
          cctx.fillStyle = TOWEL_GREEN;
          cctx.fillRect(tx + 10, ty, 10, 22);
          cctx.fillStyle = PURPLE;
          cctx.fillRect(tx + 14, ty, 2, 22);
          // Water bottle — clear-blue with cap
          cctx.fillStyle = '#a8c8e8';
          cctx.beginPath();
          cctx.ellipse(cx + 6, cy + 2, 4, 7, 0, 0, Math.PI * 2);
          cctx.fill();
          cctx.fillStyle = '#1a3d1a';
          cctx.fillRect(cx + 4, cy - 6, 4, 3);
          // Sports drink (orange)
          cctx.fillStyle = '#e87a3a';
          cctx.beginPath();
          cctx.ellipse(cx + 16, cy + 2, 4, 7, 0, 0, Math.PI * 2);
          cctx.fill();
          cctx.fillStyle = '#1a1a1a';
          cctx.fillRect(cx + 14, cy - 6, 4, 3);
          // Tennis bag at the end
          cctx.fillStyle = '#1a1a1a';
          cctx.fillRect(cx + 24, cy - 13, 22, 26);
          cctx.strokeStyle = PURPLE;
          cctx.lineWidth = 1.5;
          cctx.strokeRect(cx + 24, cy - 13, 22, 26);
          // Racket handle sticking out of bag
          cctx.fillStyle = '#3a2a1a';
          cctx.fillRect(cx + 32, cy - 18, 3, 6);
          cctx.fillStyle = '#1a1a1a';
          cctx.fillRect(cx + 31, cy - 19, 5, 2);
        }
        const benchY = PAD + H + WALL_THICK + 22;
        drawBench(PAD + W * 0.32, benchY);
        drawBench(PAD + W * 0.68, benchY);

        // ===== Line judges =====
        // Wimbledon line judges in cream pants + navy/cream Polo Ralph Lauren tops,
        // sitting on small dark green chairs at sideline positions
        function drawLineJudge(cx, cy) {
          // Small chair under the judge
          cctx.fillStyle = BENCH;
          cctx.fillRect(cx - 8, cy + 2, 16, 12);
          cctx.strokeStyle = '#000';
          cctx.lineWidth = 1;
          cctx.strokeRect(cx - 8, cy + 2, 16, 12);
          // Cream pants (lower body)
          cctx.fillStyle = CREAM;
          cctx.beginPath();
          cctx.ellipse(cx, cy + 4, 6, 5, 0, 0, Math.PI * 2);
          cctx.fill();
          // Navy top
          cctx.fillStyle = NAVY;
          cctx.beginPath();
          cctx.ellipse(cx, cy - 2, 6, 5, 0, 0, Math.PI * 2);
          cctx.fill();
          // Polo collar (cream stripe at neck)
          cctx.fillStyle = CREAM;
          cctx.fillRect(cx - 2, cy - 5, 4, 2);
          // Head
          cctx.fillStyle = '#d4a87c';
          cctx.beginPath();
          cctx.arc(cx, cy - 9, 3.5, 0, Math.PI * 2);
          cctx.fill();
          // Cap (navy with white peak)
          cctx.fillStyle = NAVY;
          cctx.beginPath();
          cctx.arc(cx, cy - 11, 4, Math.PI, Math.PI * 2);
          cctx.fill();
          cctx.fillStyle = '#ffffff';
          cctx.fillRect(cx - 4, cy - 8, 8, 1);
        }
        const courtMargin = 28;
        const courtSinglesInset = 26;
        const judgeOffset = WALL_THICK + 18;
        // Baseline judges (left/right ends of court)
        drawLineJudge(PAD - judgeOffset, PAD + H / 2);
        drawLineJudge(PAD + W + judgeOffset, PAD + H / 2);
        // Sideline judges at corners (top + bottom)
        drawLineJudge(PAD + courtMargin, PAD - judgeOffset);
        drawLineJudge(PAD + W - courtMargin, PAD - judgeOffset);
        drawLineJudge(PAD + courtMargin, PAD + H + judgeOffset);
        drawLineJudge(PAD + W - courtMargin, PAD + H + judgeOffset);
        // Service line judges (top + bottom — top-center skipped, umpire is there)
        drawLineJudge(PAD + W * 0.25, PAD - judgeOffset);
        drawLineJudge(PAD + W * 0.75, PAD - judgeOffset);
        drawLineJudge(PAD + W * 0.25, PAD + H + judgeOffset);
        drawLineJudge(PAD + W * 0.75, PAD + H + judgeOffset);

        // ===== Ballkids =====
        // Smaller, kneeling, in dark navy Wimbledon ballkid uniforms
        function drawBallkid(cx, cy) {
          // Body — kneeling navy
          cctx.fillStyle = NAVY;
          cctx.beginPath();
          cctx.ellipse(cx, cy + 2, 5, 4.5, 0, 0, Math.PI * 2);
          cctx.fill();
          // Head
          cctx.fillStyle = '#d4a87c';
          cctx.beginPath();
          cctx.arc(cx, cy - 4, 3, 0, Math.PI * 2);
          cctx.fill();
          // Hair / cap
          cctx.fillStyle = '#3a2a1a';
          cctx.beginPath();
          cctx.arc(cx, cy - 5, 3, Math.PI, Math.PI * 2);
          cctx.fill();
          // Tennis ball in hand
          cctx.fillStyle = '#c8ff00';
          cctx.beginPath();
          cctx.arc(cx + 5, cy + 2, 2, 0, Math.PI * 2);
          cctx.fill();
        }
        const kidOffset = WALL_THICK + 8;
        // At each corner of the court
        drawBallkid(PAD - kidOffset, PAD - kidOffset);
        drawBallkid(PAD + W + kidOffset, PAD - kidOffset);
        drawBallkid(PAD - kidOffset, PAD + H + kidOffset);
        drawBallkid(PAD + W + kidOffset, PAD + H + kidOffset);
        // At the net on each side
        drawBallkid(PAD + W / 2 - 38, PAD - kidOffset);
        drawBallkid(PAD + W / 2 + 38, PAD - kidOffset);
        drawBallkid(PAD + W / 2 - 38, PAD + H + kidOffset);
        drawBallkid(PAD + W / 2 + 38, PAD + H + kidOffset);
      }

      function resetBall(direction) {
        const d = DIFFICULTY[state.difficulty];
        state.ball.x = W / 2;
        state.ball.y = H / 2;
        state.ball.prevX = W / 2;
        state.ball.prevY = H / 2;
        const angle = (Math.random() * 0.6 - 0.3); // -0.3..0.3 rad
        const dir = direction || (Math.random() < 0.5 ? -1 : 1);
        state.ball.vx = Math.cos(angle) * d.ballSpeed * dir;
        state.ball.vy = Math.sin(angle) * d.ballSpeed;
        state.ball.spin = 0;
        state.ball.rotation = 0;
        state.countdown = 60; // ~1s pause before serve
      }

      function fullReset() {
        stopFireworks();
        state.playerScore = 0;
        state.cpuScore = 0;
        state.player.y = H / 2 - state.player.h / 2;
        state.cpu.y = H / 2 - state.cpu.h / 2;
        updateScores();
        resetBall();
        state.running = false;
        state.paused = false;
        showOverlay('PANTAO MINI', 'Move your paddle with the mouse, touch, or arrow keys.', 'Start match');
        statusEl.textContent = 'Press start';
      }

      function updateScores() {
        playerScoreEl.textContent = String(state.playerScore).padStart(2, '0');
        cpuScoreEl.textContent = String(state.cpuScore).padStart(2, '0');
      }

      function showOverlay(title, text, btnLabel) {
        overlayTitle.textContent = title;
        overlayText.textContent = text;
        startBtn.textContent = btnLabel || 'Start match';
        overlay.classList.remove('is-hidden');
      }

      function hideOverlay() {
        overlay.classList.add('is-hidden');
      }

      function step(dt) {
        const d = DIFFICULTY[state.difficulty];

        // Track previous paddle Y so we can compute velocity at moment of contact
        state.player.prevY = state.player.y;
        state.cpu.prevY = state.cpu.y;

        // Player input — keys
        const keySpeed = 8;
        if (state.keys.up) state.player.y -= keySpeed;
        if (state.keys.down) state.player.y += keySpeed;

        // Player input — pointer (overrides keys when active)
        if (state.pointerY !== null) {
          const target = state.pointerY - state.player.h / 2;
          state.player.y += (target - state.player.y) * 0.35;
        }

        // Clamp player
        state.player.y = Math.max(0, Math.min(H - state.player.h, state.player.y));

        // Compute paddle velocities (px per frame)
        state.player.vy = state.player.y - state.player.prevY;

        // CPU AI — chase ball with limited speed and a deadzone
        const cpuTarget = state.ball.y - state.cpu.h / 2;
        const cpuDelta = cpuTarget - state.cpu.y;
        const cpuMove = Math.max(-d.cpuSpeed, Math.min(d.cpuSpeed, cpuDelta));
        // Add slight imperfection
        state.cpu.y += cpuMove * (0.85 + Math.random() * 0.15);
        state.cpu.y = Math.max(0, Math.min(H - state.cpu.h, state.cpu.y));
        state.cpu.vy = state.cpu.y - state.cpu.prevY;

        // Countdown before serve
        if (state.countdown > 0) {
          state.countdown -= 1;
          return;
        }

        // Apply spin: Magnus-effect-style sideways force on the ball
        // Spin is in radians/frame; positive spin curves ball downward, negative upward
        // (since ball travels horizontally, vy is the curve axis)
        const magnusForce = state.ball.spin * 0.35;
        state.ball.vy += magnusForce;

        // Spin decay (air resistance) — slows over time so it doesn't compound forever
        state.ball.spin *= 0.992;

        // Visual rotation tracks accumulated spin
        state.ball.rotation += state.ball.spin * 1.6;

        // Move ball — record prev position first for swept collision detection
        state.ball.prevX = state.ball.x;
        state.ball.prevY = state.ball.y;
        state.ball.x += state.ball.vx;
        state.ball.y += state.ball.vy;

        // Top / bottom walls — wall bounce dampens spin
        if (state.ball.y - state.ball.r < 0) {
          state.ball.y = state.ball.r;
          state.ball.vy *= -1;
          state.ball.spin *= -0.5;
        } else if (state.ball.y + state.ball.r > H) {
          state.ball.y = H - state.ball.r;
          state.ball.vy *= -1;
          state.ball.spin *= -0.5;
        }

        // --- Paddle collision helper ---
        // Returns spin imparted by the hit, given:
        //   hit01: position on paddle from -1 (top edge) to +1 (bottom edge)
        //   paddleVy: paddle velocity at time of contact
        function computeSpin(hit01, paddleVy) {
          // Edge factor: hits near top/bottom 25% of paddle generate extra spin
          // matching the side they hit (top edge = upward spin, bottom = downward)
          let edgeSpin = 0;
          const absHit = Math.abs(hit01);
          if (absHit > 0.55) {
            // Past the 55% mark = "edge zone" — ramp from 0 at 0.55 to full at 1.0
            const edgeStrength = (absHit - 0.55) / 0.45; // 0..1
            edgeSpin = Math.sign(hit01) * edgeStrength * 0.18;
          }
          // Slide factor: paddle was moving when it hit the ball — clamp paddle vy
          // to a reasonable range so absurd values don't dominate
          const clampedVy = Math.max(-12, Math.min(12, paddleVy));
          const slideSpin = clampedVy * 0.022;
          return edgeSpin + slideSpin;
        }

        // --- Swept paddle collision ---
        // Standard intersection checks tunnel through paddles when ball speed
        // exceeds paddle thickness per frame. Instead we check whether the ball's
        // path between prevX/prevY and current X/Y crossed the paddle's hit plane,
        // and whether the Y at that crossing point is within the paddle's height.

        // Player paddle (left side; ball moving leftward hits the right edge)
        if (state.ball.vx < 0) {
          const hitPlane = state.player.x + state.player.w + state.ball.r;
          // Ball was on the right of the plane and is now on or past it
          if (state.ball.prevX >= hitPlane && state.ball.x <= hitPlane) {
            const dx = state.ball.x - state.ball.prevX;
            const t = dx === 0 ? 0 : (hitPlane - state.ball.prevX) / dx;
            const crossY = state.ball.prevY + t * (state.ball.y - state.ball.prevY);
            if (crossY >= state.player.y - state.ball.r && crossY <= state.player.y + state.player.h + state.ball.r) {
              const clampedY = Math.max(state.player.y, Math.min(state.player.y + state.player.h, crossY));
              const hit = (clampedY - (state.player.y + state.player.h / 2)) / (state.player.h / 2);
              const speed = Math.hypot(state.ball.vx, state.ball.vy) * 1.04;
              const angle = hit * (Math.PI / 3);
              state.ball.vx = Math.abs(Math.cos(angle) * speed);
              state.ball.vy = Math.sin(angle) * speed;
              state.ball.x = hitPlane;        // park ball on the contact plane
              state.ball.y = crossY;
              state.ball.spin = computeSpin(hit, state.player.vy);
            }
          }
        }

        // CPU paddle (right side; ball moving rightward hits the left edge)
        if (state.ball.vx > 0) {
          const hitPlane = state.cpu.x - state.ball.r;
          if (state.ball.prevX <= hitPlane && state.ball.x >= hitPlane) {
            const dx = state.ball.x - state.ball.prevX;
            const t = dx === 0 ? 0 : (hitPlane - state.ball.prevX) / dx;
            const crossY = state.ball.prevY + t * (state.ball.y - state.ball.prevY);
            if (crossY >= state.cpu.y - state.ball.r && crossY <= state.cpu.y + state.cpu.h + state.ball.r) {
              const clampedY = Math.max(state.cpu.y, Math.min(state.cpu.y + state.cpu.h, crossY));
              const hit = (clampedY - (state.cpu.y + state.cpu.h / 2)) / (state.cpu.h / 2);
              const speed = Math.hypot(state.ball.vx, state.ball.vy) * 1.04;
              const angle = hit * (Math.PI / 3);
              state.ball.vx = -Math.abs(Math.cos(angle) * speed);
              state.ball.vy = Math.sin(angle) * speed;
              state.ball.x = hitPlane;
              state.ball.y = crossY;
              state.ball.spin = computeSpin(hit, state.cpu.vy);
            }
          }
        }

        // Cap top speed
        const maxSpeed = 14;
        const cur = Math.hypot(state.ball.vx, state.ball.vy);
        if (cur > maxSpeed) {
          state.ball.vx = (state.ball.vx / cur) * maxSpeed;
          state.ball.vy = (state.ball.vy / cur) * maxSpeed;
        }

        // Scoring
        if (state.ball.x < -20) {
          state.cpuScore += 1;
          updateScores();
          if (state.cpuScore >= WIN_SCORE) return endMatch(false);
          statusEl.textContent = 'CPU scored';
          resetBall(1);
        } else if (state.ball.x > W + 20) {
          state.playerScore += 1;
          updateScores();
          if (state.playerScore >= WIN_SCORE) return endMatch(true);
          statusEl.textContent = 'Point';
          resetBall(-1);
        }
      }

      function endMatch(playerWon) {
        state.running = false;
        if (playerWon) {
          const beaten = state.difficulty;
          const idx = DIFFICULTY_ORDER.indexOf(beaten);
          const nextIdx = idx + 1;
          if (idx >= 0 && nextIdx < DIFFICULTY_ORDER.length) {
            const next = DIFFICULTY_ORDER[nextIdx];
            setDifficulty(next);
            showOverlay(
              'GAME — SET — MATCH',
              'You beat ' + DIFFICULTY_LABEL[beaten] + '. Next up: ' + DIFFICULTY_LABEL[next] + '.',
              'Play ' + DIFFICULTY_LABEL[next]
            );
            statusEl.textContent = 'Advanced to ' + DIFFICULTY_LABEL[next];
          } else {
            // Already at top tier (Pro) — no auto-advance, but celebrate with fireworks
            showOverlay('GAME — SET — MATCH', 'You won at Pro. Rematch?', 'Play again');
            statusEl.textContent = 'You won';
            startFireworks(10000); // launch rockets for 10 seconds
          }
        } else {
          showOverlay('Match over', 'CPU took it. Rematch?', 'Play again');
          statusEl.textContent = 'CPU won';
        }
      }

      // ---- Pro-win celebration: fireworks (rockets + bursts) ----
      const FIREWORK_COLORS = ['#c8ff00', '#503d6e', '#1e40af', '#ffffff', '#e87a3a', '#ff4d6d', '#3d7a3d'];
      const fireworks = {
        active: false,
        launchUntil: 0,    // stop launching new rockets after this timestamp
        lastLaunch: 0,
        rockets: [],
        particles: [],
        rafId: null
      };

      function launchRocket() {
        // Random launch X (anywhere along the bottom), targeting an explosion height
        // somewhere in the upper half of the canvas
        const x = 80 + Math.random() * (CW - 160);
        const targetY = 60 + Math.random() * (CH * 0.45);
        const startY = CH - 10;
        // Compute an upward velocity that will decelerate to a stop near targetY
        // Using kinematics with gravity g: vy_initial = -sqrt(2 * g * (startY - targetY))
        const g = 0.06;
        const vy = -Math.sqrt(2 * g * (startY - targetY));
        const vx = (Math.random() - 0.5) * 0.4;
        fireworks.rockets.push({
          x: x,
          y: startY,
          vx: vx,
          vy: vy,
          trailColor: FIREWORK_COLORS[Math.floor(Math.random() * FIREWORK_COLORS.length)],
          burstColor: FIREWORK_COLORS[Math.floor(Math.random() * FIREWORK_COLORS.length)]
        });
      }

      function explodeRocket(rocket) {
        const count = 32 + Math.floor(Math.random() * 16);
        for (let i = 0; i < count; i++) {
          const angle = (i / count) * Math.PI * 2 + Math.random() * 0.1;
          const speed = 1.5 + Math.random() * 2.5;
          fireworks.particles.push({
            x: rocket.x,
            y: rocket.y,
            vx: Math.cos(angle) * speed,
            vy: Math.sin(angle) * speed,
            color: rocket.burstColor,
            life: 1.0,
            decay: 0.012 + Math.random() * 0.01
          });
        }
      }

      function updateFireworks() {
        const g = 0.06;
        // Update rockets
        for (let i = fireworks.rockets.length - 1; i >= 0; i--) {
          const r = fireworks.rockets[i];
          r.x += r.vx;
          r.y += r.vy;
          r.vy += g;
          // Explode at apex (when vy becomes non-negative — rocket starts to fall)
          if (r.vy >= 0) {
            explodeRocket(r);
            fireworks.rockets.splice(i, 1);
          }
        }
        // Update particles
        for (let i = fireworks.particles.length - 1; i >= 0; i--) {
          const p = fireworks.particles[i];
          p.x += p.vx;
          p.y += p.vy;
          p.vy += g * 0.6; // particles fall a bit slower than rockets
          p.vx *= 0.98;
          p.vy *= 0.98;
          p.life -= p.decay;
          if (p.life <= 0) fireworks.particles.splice(i, 1);
        }
      }

      function drawFireworks() {
        if (!fireworks.active && fireworks.rockets.length === 0 && fireworks.particles.length === 0) return;
        // Rocket trails
        for (const r of fireworks.rockets) {
          ctx.fillStyle = r.trailColor;
          ctx.globalAlpha = 0.9;
          ctx.beginPath();
          ctx.arc(r.x, r.y, 2, 0, Math.PI * 2);
          ctx.fill();
          // Trail spark
          ctx.globalAlpha = 0.4;
          ctx.beginPath();
          ctx.arc(r.x - r.vx * 1.5, r.y - r.vy * 1.5, 1.5, 0, Math.PI * 2);
          ctx.fill();
        }
        // Burst particles
        for (const p of fireworks.particles) {
          ctx.globalAlpha = Math.max(0, Math.min(1, p.life));
          ctx.fillStyle = p.color;
          ctx.beginPath();
          ctx.arc(p.x, p.y, 2, 0, Math.PI * 2);
          ctx.fill();
        }
        ctx.globalAlpha = 1;
      }

      function startFireworks(durationMs) {
        fireworks.active = true;
        fireworks.launchUntil = performance.now() + durationMs;
        fireworks.lastLaunch = 0;
        // Run an independent rAF loop so the celebration animates even though
        // the main game loop has stopped (state.running = false on win)
        if (fireworks.rafId !== null) return;
        const tick = () => {
          const now = performance.now();
          if (fireworks.active && now < fireworks.launchUntil) {
            // Throttle to ~one rocket every 350ms
            if (now - fireworks.lastLaunch > 350) {
              launchRocket();
              fireworks.lastLaunch = now;
            }
          }
          updateFireworks();
          draw();
          // Continue if still launching or any particles/rockets remain
          if (
            (fireworks.active && now < fireworks.launchUntil) ||
            fireworks.rockets.length > 0 ||
            fireworks.particles.length > 0
          ) {
            fireworks.rafId = requestAnimationFrame(tick);
          } else {
            fireworks.rafId = null;
            fireworks.active = false;
          }
        };
        fireworks.rafId = requestAnimationFrame(tick);
      }

      function stopFireworks() {
        fireworks.active = false;
        fireworks.rockets.length = 0;
        fireworks.particles.length = 0;
        if (fireworks.rafId !== null) {
          cancelAnimationFrame(fireworks.rafId);
          fireworks.rafId = null;
        }
      }

      // ---- Pro mode: bunting banners + confetti ----
      // Particles are persistent; they keep falling whenever the player is on Pro.
      const CONFETTI_COLORS = ['#503d6e', '#1e40af', '#c8ff00', '#ffffff', '#e87a3a', '#3d7a3d'];
      const confetti = [];
      const CONFETTI_COUNT = 80;
      for (let i = 0; i < CONFETTI_COUNT; i++) {
        confetti.push({
          x: Math.random() * CW,
          y: Math.random() * CH - CH, // start above canvas, staggered
          vx: (Math.random() - 0.5) * 0.6,
          vy: 0.7 + Math.random() * 1.4,
          size: 4 + Math.random() * 4,
          color: CONFETTI_COLORS[Math.floor(Math.random() * CONFETTI_COLORS.length)],
          rotation: Math.random() * Math.PI * 2,
          rotationSpeed: (Math.random() - 0.5) * 0.18
        });
      }

      // Bunting: pre-compute triangle positions along top + bottom walls
      const BUNTING_COLORS = ['#503d6e', '#c8ff00', '#1e40af', '#ffffff'];
      const buntingTriangles = (() => {
        const triangles = [];
        const triCount = 18;
        const spacing = (CW - 24) / triCount;
        for (let i = 0; i <= triCount; i++) {
          triangles.push({
            x: 12 + i * spacing,
            color: BUNTING_COLORS[i % BUNTING_COLORS.length]
          });
        }
        return triangles;
      })();

      function drawProDecorations() {
        if (state.difficulty !== 'pro') return;

        // ===== Bunting banners along top + bottom walls =====
        const triHalfWidth = 7;
        const triHeight = 14;

        // Top bunting — hanging down from just above the top wall, into the upper crowd zone
        const topY = PAD - WALL_THICK - 6;
        // String line connecting them
        ctx.strokeStyle = 'rgba(20, 30, 20, 0.6)';
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.moveTo(buntingTriangles[0].x, topY);
        for (let i = 1; i < buntingTriangles.length; i++) {
          // Slight sag between triangles
          const prev = buntingTriangles[i - 1];
          const cur = buntingTriangles[i];
          const midX = (prev.x + cur.x) / 2;
          ctx.quadraticCurveTo(midX, topY + 3, cur.x, topY);
        }
        ctx.stroke();
        // Triangles hanging from string
        for (const tri of buntingTriangles) {
          ctx.fillStyle = tri.color;
          ctx.beginPath();
          ctx.moveTo(tri.x - triHalfWidth, topY);
          ctx.lineTo(tri.x + triHalfWidth, topY);
          ctx.lineTo(tri.x, topY + triHeight);
          ctx.closePath();
          ctx.fill();
          // Subtle outline
          ctx.strokeStyle = 'rgba(0, 0, 0, 0.35)';
          ctx.lineWidth = 0.5;
          ctx.stroke();
        }

        // Bottom bunting — hanging up from just below the bottom wall, into the lower crowd zone
        const botY = PAD + H + WALL_THICK + 6;
        ctx.strokeStyle = 'rgba(20, 30, 20, 0.6)';
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.moveTo(buntingTriangles[0].x, botY);
        for (let i = 1; i < buntingTriangles.length; i++) {
          const prev = buntingTriangles[i - 1];
          const cur = buntingTriangles[i];
          const midX = (prev.x + cur.x) / 2;
          ctx.quadraticCurveTo(midX, botY - 3, cur.x, botY);
        }
        ctx.stroke();
        for (const tri of buntingTriangles) {
          ctx.fillStyle = tri.color;
          ctx.beginPath();
          ctx.moveTo(tri.x - triHalfWidth, botY);
          ctx.lineTo(tri.x + triHalfWidth, botY);
          ctx.lineTo(tri.x, botY - triHeight);
          ctx.closePath();
          ctx.fill();
          ctx.strokeStyle = 'rgba(0, 0, 0, 0.35)';
          ctx.lineWidth = 0.5;
          ctx.stroke();
        }

        // ===== Confetti =====
        for (const p of confetti) {
          // Update only when game is running so confetti freezes on pause/idle
          if (state.running) {
            p.x += p.vx;
            p.y += p.vy;
            p.rotation += p.rotationSpeed;
            if (p.y > CH + 10) {
              p.y = -10 - Math.random() * 40;
              p.x = Math.random() * CW;
              p.vy = 0.7 + Math.random() * 1.4;
              p.vx = (Math.random() - 0.5) * 0.6;
              p.color = CONFETTI_COLORS[Math.floor(Math.random() * CONFETTI_COLORS.length)];
            }
          }
          ctx.save();
          ctx.translate(p.x, p.y);
          ctx.rotate(p.rotation);
          ctx.fillStyle = p.color;
          ctx.fillRect(-p.size / 2, -p.size / 4, p.size, p.size / 2);
          ctx.restore();
        }
      }

      // Live scoreboard drawn on top of the pre-rendered stadium each frame
      function drawStadiumScoreboard() {
        const sbX = PAD - WALL_THICK + 8;
        const sbY = PAD - WALL_THICK - 38;
        const sbW = 160;
        const sbH = 34;
        if (sbY < 4) return;

        // Box
        ctx.fillStyle = '#0a1a0a';
        ctx.fillRect(sbX, sbY, sbW, sbH);
        ctx.strokeStyle = '#503d6e'; // Wimbledon purple trim
        ctx.lineWidth = 1;
        ctx.strokeRect(sbX + 0.5, sbY + 0.5, sbW - 1, sbH - 1);

        // Divider line between rows
        ctx.beginPath();
        ctx.moveTo(sbX + 1, sbY + sbH / 2);
        ctx.lineTo(sbX + sbW - 1, sbY + sbH / 2);
        ctx.strokeStyle = '#1d3d1d';
        ctx.lineWidth = 1;
        ctx.stroke();

        // Compose player label: optional flag + name (or "PLAYER")
        const rawName = (state.playerName || '').trim();
        const displayName = (rawName ? rawName : 'PLAYER').toUpperCase();
        const flag = state.playerFlag || '';
        // PG (Pantao Galeriya) gets a double-space to match the CPU's "PG  CPU" format
        const flagSep = flag === 'PG' ? '  ' : ' ';
        const playerLabel = flag ? flag + flagSep + displayName : displayName;
        // CPU represents the Pantao house — abbreviation "PG"
        const cpuLabel = 'PG  CPU';

        // Player row
        ctx.fillStyle = '#ffffff';
        ctx.font = 'bold 11px system-ui, -apple-system, "Segoe UI Emoji", "Apple Color Emoji", "Noto Color Emoji", sans-serif';
        ctx.textAlign = 'left';
        ctx.textBaseline = 'middle';
        // Truncate label if too wide for the box (leave room for score)
        const maxLabelWidth = sbW - 38;
        let label = playerLabel;
        while (ctx.measureText(label).width > maxLabelWidth && label.length > 1) {
          label = label.slice(0, -1);
        }
        ctx.fillText(label, sbX + 6, sbY + sbH / 4 + 1);

        // CPU row
        ctx.fillText(cpuLabel, sbX + 6, sbY + (sbH * 3) / 4 + 1);

        // Scores (right-aligned, lime green)
        ctx.fillStyle = '#c8ff00';
        ctx.font = 'bold 13px sans-serif';
        ctx.textAlign = 'right';
        const playerScoreStr = String(state.playerScore).padStart(2, '0');
        const cpuScoreStr = String(state.cpuScore).padStart(2, '0');
        ctx.fillText(playerScoreStr, sbX + sbW - 6, sbY + sbH / 4 + 1);
        ctx.fillText(cpuScoreStr, sbX + sbW - 6, sbY + (sbH * 3) / 4 + 1);
      }

      function draw() {
        // Paint pre-rendered stadium + crowd background
        ctx.drawImage(crowdCanvas, 0, 0);

        // Pro mode adds bunting banners + falling confetti over the stadium
        // (drawn before the court, so the court fill cleanly covers any
        // confetti that has fallen onto the playing surface)
        drawProDecorations();

        // Live scoreboard (drawn each frame so score, name, and flag are current)
        drawStadiumScoreboard();

        // Translate so all subsequent court drawing uses court-local coords (0..W, 0..H)
        ctx.save();
        ctx.translate(PAD, PAD);

        // Court surface — Wimbledon grass with mowing stripes
        ctx.fillStyle = '#3d7a3d';
        ctx.fillRect(0, 0, W, H);
        // Alternating lighter horizontal mowing stripes
        ctx.fillStyle = '#4d8c4d';
        const stripeCount = 8;
        const stripeH = H / stripeCount;
        for (let i = 0; i < stripeCount; i += 2) {
          ctx.fillRect(0, i * stripeH, W, stripeH);
        }

        // Knight watermark — centered in each side's vertical service rectangle
        if (knightReady) {
          const courtMargin = 28;
          const courtSinglesInset = 26;
          const rectTop = courtMargin + courtSinglesInset;
          const rectBottom = H - courtMargin - courtSinglesInset;
          const rectHeight = rectBottom - rectTop;
          const rectCenterY = (rectTop + rectBottom) / 2;

          // Left rectangle: from courtMargin to W*0.25
          const leftRectCenterX = (courtMargin + W * 0.25) / 2;
          // Right rectangle: from W*0.75 to W-courtMargin
          const rightRectCenterX = (W * 0.75 + (W - courtMargin)) / 2;
          const rectWidth = (W * 0.25) - courtMargin;

          // Fit watermark to ~75% of rect, preserving aspect ratio
          const aspect = knightImg.width / knightImg.height;
          const maxW = rectWidth * 0.75;
          const maxH = rectHeight * 0.75;
          let targetW = maxW;
          let targetH = targetW / aspect;
          if (targetH > maxH) {
            targetH = maxH;
            targetW = targetH * aspect;
          }

          ctx.save();
          ctx.globalAlpha = 0.18;
          // Left
          ctx.drawImage(knightImg, leftRectCenterX - targetW / 2, rectCenterY - targetH / 2, targetW, targetH);
          // Right — mirrored so knights face each other
          ctx.translate(rightRectCenterX, rectCenterY);
          ctx.scale(-1, 1);
          ctx.drawImage(knightImg, -targetW / 2, -targetH / 2, targetW, targetH);
          ctx.restore();
        }

        // Court markings — white
        ctx.strokeStyle = '#ffffff';
        ctx.lineCap = 'butt';

        // Outer boundary (doubles court)
        const margin = 28;
        ctx.lineWidth = 3;
        ctx.strokeRect(margin, margin, W - margin * 2, H - margin * 2);

        // Singles sidelines (inset on top and bottom — net runs vertically here)
        const singlesInset = 26;
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.moveTo(margin, margin + singlesInset);
        ctx.lineTo(W - margin, margin + singlesInset);
        ctx.moveTo(margin, H - margin - singlesInset);
        ctx.lineTo(W - margin, H - margin - singlesInset);
        ctx.stroke();

        // Service lines (vertical, at 1/4 and 3/4)
        const serviceLeftX = W * 0.25;
        const serviceRightX = W * 0.75;
        ctx.beginPath();
        ctx.moveTo(serviceLeftX, margin + singlesInset);
        ctx.lineTo(serviceLeftX, H - margin - singlesInset);
        ctx.moveTo(serviceRightX, margin + singlesInset);
        ctx.lineTo(serviceRightX, H - margin - singlesInset);
        ctx.stroke();

        // Center service line (between the two service lines)
        ctx.beginPath();
        ctx.moveTo(serviceLeftX, H / 2);
        ctx.lineTo(serviceRightX, H / 2);
        ctx.stroke();

        // Center marks on baselines
        ctx.beginPath();
        ctx.moveTo(margin, H / 2);
        ctx.lineTo(margin + 10, H / 2);
        ctx.moveTo(W - margin - 10, H / 2);
        ctx.lineTo(W - margin, H / 2);
        ctx.stroke();

        // Net — vertical line down the middle with band
        ctx.strokeStyle = '#1a1a1a';
        ctx.lineWidth = 2;
        ctx.setLineDash([4, 6]);
        ctx.beginPath();
        ctx.moveTo(W / 2, 0);
        ctx.lineTo(W / 2, H);
        ctx.stroke();
        ctx.setLineDash([]);

        // Net band (white strip across the top of the net)
        ctx.fillStyle = '#ffffff';
        ctx.fillRect(W / 2 - 2, 0, 4, 12);
        ctx.fillRect(W / 2 - 2, H - 12, 4, 12);

        // Paddles
        function drawPaddle(p, isPG) {
          if (isPG) {
            // Light wood backing
            ctx.fillStyle = '#e8d4a8';
            ctx.fillRect(p.x, p.y, p.w, p.h);
            // Wood grain — a few faint vertical streaks
            ctx.strokeStyle = 'rgba(120, 90, 50, 0.32)';
            ctx.lineWidth = 1;
            for (let i = 0; i < 3; i++) {
              const gx = p.x + 2 + (i + 1) * (p.w / 4);
              ctx.beginPath();
              ctx.moveTo(gx, p.y + 2);
              ctx.lineTo(gx, p.y + p.h - 2);
              ctx.stroke();
            }
            // Wood edge shadow (top + bottom)
            ctx.fillStyle = 'rgba(80, 55, 25, 0.35)';
            ctx.fillRect(p.x, p.y, p.w, 2);
            ctx.fillRect(p.x, p.y + p.h - 2, p.w, 2);
            // Royal blue face, inset
            ctx.fillStyle = '#1e40af';
            ctx.fillRect(p.x + 2, p.y + 4, p.w - 4, p.h - 8);
            // Highlight strip down the left side of the face for subtle depth
            ctx.fillStyle = 'rgba(255, 255, 255, 0.12)';
            ctx.fillRect(p.x + 2, p.y + 4, 1, p.h - 8);
          } else {
            ctx.fillStyle = '#000';
            ctx.fillRect(p.x, p.y, p.w, p.h);
          }
        }
        const playerIsPG = state.playerFlag === 'PG';
        drawPaddle(state.player, playerIsPG);
        drawPaddle(state.cpu, true); // CPU is always PG (the house)

        // Ball — optic tennis green with proper seam pattern that rotates with spin
        const bx = state.ball.x;
        const by = state.ball.y;
        const br = state.ball.r;

        ctx.save();
        ctx.translate(bx, by);
        ctx.rotate(state.ball.rotation);

        // Ball body
        ctx.beginPath();
        ctx.arc(0, 0, br, 0, Math.PI * 2);
        ctx.fillStyle = '#c8ff00';
        ctx.fill();
        ctx.lineWidth = 1;
        ctx.strokeStyle = 'rgba(0,0,0,0.35)';
        ctx.stroke();

        // Seam — two opposing curves
        ctx.strokeStyle = '#ffffff';
        ctx.lineWidth = 1.4;
        const seamOffset = br * 1.15;

        ctx.beginPath();
        ctx.arc(0, -seamOffset, br * 1.4, Math.PI * 0.28, Math.PI * 0.72);
        ctx.stroke();

        ctx.beginPath();
        ctx.arc(0, seamOffset, br * 1.4, Math.PI * 1.28, Math.PI * 1.72);
        ctx.stroke();

        ctx.restore();

        // Countdown indicator
        if (state.countdown > 0 && state.running) {
          ctx.fillStyle = 'rgba(255,255,255,0.85)';
          ctx.font = '500 14px sans-serif';
          ctx.textAlign = 'center';
          const sec = Math.ceil(state.countdown / 60);
          ctx.fillText('SERVE IN ' + sec, W / 2, 22);
        }

        ctx.restore();

        // Fireworks render LAST so they appear on top of the court, paddles,
        // and ball — celebrating across the entire scene rather than being
        // hidden by the court fill that paints over the stadium each frame.
        drawFireworks();
      }

      function loop(ts) {
        if (!state.running) return;
        const dt = Math.min(32, ts - state.lastTime);
        state.lastTime = ts;
        step(dt);
        draw();
        requestAnimationFrame(loop);
      }

      function start() {
        // Resuming from a pause: don't reset the ball, just continue
        if (state.paused) {
          state.paused = false;
          hideOverlay();
          state.running = true;
          state.lastTime = performance.now();
          statusEl.textContent = 'Live';
          requestAnimationFrame(loop);
          return;
        }
        // Stop any lingering celebration from the prior match
        stopFireworks();
        if (state.playerScore >= WIN_SCORE || state.cpuScore >= WIN_SCORE) {
          state.playerScore = 0;
          state.cpuScore = 0;
          updateScores();
        }
        hideOverlay();
        state.running = true;
        state.lastTime = performance.now();
        statusEl.textContent = 'Live';
        resetBall();
        requestAnimationFrame(loop);
      }

      function pauseGame() {
        if (!state.running) return; // nothing to pause
        state.running = false;
        state.paused = true;
        statusEl.textContent = 'Paused';
        showOverlay('Paused', 'Press ESC or click Resume to continue.', 'Resume');
      }

      // Pointer / touch input
      function pointerToCanvasY(clientY) {
        const rect = canvas.getBoundingClientRect();
        const scale = CH / rect.height;
        // Map screen Y to canvas Y, then subtract PAD to get court Y
        return (clientY - rect.top) * scale - PAD;
      }

      canvas.addEventListener('mousemove', (e) => {
        state.pointerY = pointerToCanvasY(e.clientY);
      });
      canvas.addEventListener('mouseleave', () => {
        state.pointerY = null;
      });
      canvas.addEventListener('touchmove', (e) => {
        if (e.touches[0]) {
          state.pointerY = pointerToCanvasY(e.touches[0].clientY);
          e.preventDefault();
        }
      }, { passive: false });
      canvas.addEventListener('touchstart', (e) => {
        if (e.touches[0]) {
          state.pointerY = pointerToCanvasY(e.touches[0].clientY);
        }
      }, { passive: true });

      // Keyboard
      function isTyping(e) {
        const t = e.target;
        if (!t) return false;
        const tag = t.tagName;
        return tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT' || t.isContentEditable;
      }
      document.addEventListener('keydown', (e) => {
        if (isTyping(e)) return;
        if (!isInView(root)) return;
        if (e.key === 'ArrowUp' || e.key === 'w' || e.key === 'W') { state.keys.up = true; e.preventDefault(); }
        if (e.key === 'ArrowDown' || e.key === 's' || e.key === 'S') { state.keys.down = true; e.preventDefault(); }
        if (e.key === ' ' && !state.running) { start(); e.preventDefault(); }
        if (e.key === 'Escape' || e.key === 'Esc') {
          if (state.running) { pauseGame(); e.preventDefault(); }
          else if (state.paused) { start(); e.preventDefault(); }
        }
      });
      document.addEventListener('keyup', (e) => {
        if (isTyping(e)) return;
        if (e.key === 'ArrowUp' || e.key === 'w' || e.key === 'W') state.keys.up = false;
        if (e.key === 'ArrowDown' || e.key === 's' || e.key === 'S') state.keys.down = false;
      });

      function isInView(el) {
        const r = el.getBoundingClientRect();
        return r.bottom > 0 && r.top < window.innerHeight;
      }

      // Buttons
      startBtn.addEventListener('click', start);
      resetBtn.addEventListener('click', () => {
        fullReset();
      });

      // Difficulty
      function setDifficulty(name) {
        if (!DIFFICULTY[name]) return;
        state.difficulty = name;
        chips.forEach((c) => {
          const isMatch = c.dataset.difficulty === name;
          c.classList.toggle('is-active', isMatch);
          c.setAttribute('aria-checked', isMatch ? 'true' : 'false');
        });
        // If the user switches difficulty mid-celebration, stop the show
        if (name !== 'pro') stopFireworks();
        if (!state.running) draw();
      }
      chips.forEach((chip) => {
        chip.addEventListener('click', () => setDifficulty(chip.dataset.difficulty));
      });

      // Player customization (name + flag), persisted in localStorage
      const STORAGE_KEY = 'pantao-tennis-player';
      function updatePlayerLabel() {
        if (!playerLabelEl) return;
        const rawName = (state.playerName || '').trim();
        const displayName = rawName ? rawName : 'Player';
        const flag = state.playerFlag || '';
        const flagSep = flag === 'PG' ? '  ' : ' ';
        playerLabelEl.textContent = flag ? flag + flagSep + displayName : displayName;
      }
      function savePlayer() {
        try {
          localStorage.setItem(STORAGE_KEY, JSON.stringify({
            name: state.playerName,
            flag: state.playerFlag
          }));
        } catch (e) { /* storage may be unavailable; fail silently */ }
      }
      function loadPlayer() {
        try {
          const raw = localStorage.getItem(STORAGE_KEY);
          if (!raw) return;
          const data = JSON.parse(raw);
          if (data && typeof data.name === 'string') {
            state.playerName = data.name;
            if (nameInput) nameInput.value = data.name;
          }
          if (data && typeof data.flag === 'string') {
            state.playerFlag = data.flag;
            if (flagSelect) flagSelect.value = data.flag;
          }
        } catch (e) { /* ignore corrupt or unavailable storage */ }
      }
      loadPlayer();
      updatePlayerLabel();

      if (nameInput) {
        nameInput.addEventListener('input', () => {
          state.playerName = nameInput.value.slice(0, 12);
          savePlayer();
          updatePlayerLabel();
          if (!state.running) draw();
        });
      }
      if (flagSelect) {
        flagSelect.addEventListener('change', () => {
          state.playerFlag = flagSelect.value;
          savePlayer();
          updatePlayerLabel();
          if (!state.running) draw();
        });
      }

      // Pause when tab hidden
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) {
          stopFireworks();
          if (state.running) pauseGame();
        }
      });

      // Initial paint
      draw();
    }
  })();
</script>

