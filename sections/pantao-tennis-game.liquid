{% comment %}
  Pantao Mini — Tennis Game
  A monochrome, Acne-Studios-styled Pong-tennis mini game.
  Drop into any page via the theme editor.
{% endcomment %}

<div
  class="section spacing-style {% if section.settings.color_scheme != blank %}color-{{ section.settings.color_scheme }}{% endif %}"
  style="{% render 'spacing-padding', settings: section.settings %}"
>
  {%- assign gate_required = section.settings.gate_required -%}
  {%- assign already_passed = false -%}
  {%- if customer.posted? -%}{%- assign already_passed = true -%}{%- endif -%}
  {%- assign gate_panel_color = section.settings.gate_panel_bg_color | default: '#0d1f0d' -%}
  {%- assign gate_panel_alpha = section.settings.gate_panel_opacity | default: 60 | divided_by: 100.0 -%}

  <div
    class="pantao-stepper"
    data-pantao-stepper
    data-fullscreen="{% if section.settings.gate_fullscreen %}true{% else %}false{% endif %}"
    data-step="{% if gate_required and already_passed == false %}gate{% else %}game{% endif %}"
    style="
      --pg-bg: {{ section.settings.gate_bg_color | default: '#0d1f0d' }};
      --pg-fg: {{ section.settings.gate_fg_color | default: '#ffffff' }};
      --pg-accent: {{ section.settings.gate_accent_color | default: '#c8ff00' }};
      --pg-muted: rgba(255,255,255,0.6);

      --pg-eyebrow-size: {{ section.settings.gate_eyebrow_size | default: 11 }}px;
      --pg-eyebrow-tracking: {{ section.settings.gate_eyebrow_tracking | default: 22 }};
      --pg-eyebrow-color: {{ section.settings.gate_eyebrow_color | default: 'rgba(255,255,255,0.6)' }};
      --pg-eyebrow-align: {{ section.settings.gate_eyebrow_align | default: 'center' }};
      --pg-eyebrow-line: {{ section.settings.gate_eyebrow_line_height | default: 140 | divided_by: 100.0 }};

      --pg-heading-size: {{ section.settings.gate_heading_size | default: 36 }}px;
      --pg-heading-tracking: {{ section.settings.gate_heading_tracking | default: 4 }};
      --pg-heading-color: {{ section.settings.gate_heading_color | default: '#ffffff' }};
      --pg-heading-align: {{ section.settings.gate_heading_align | default: 'center' }};
      --pg-heading-line: {{ section.settings.gate_heading_line_height | default: 105 | divided_by: 100.0 }};

      --pg-subheading-size: {{ section.settings.gate_subheading_size | default: 14 }}px;
      --pg-subheading-color: {{ section.settings.gate_subheading_color | default: 'rgba(255,255,255,0.6)' }};
      --pg-subheading-align: {{ section.settings.gate_subheading_align | default: 'center' }};
      --pg-subheading-line: {{ section.settings.gate_subheading_line_height | default: 150 | divided_by: 100.0 }};

      --pg-fine-size: {{ section.settings.gate_fine_size | default: 11 }}px;
      --pg-fine-color: {{ section.settings.gate_fine_color | default: 'rgba(255,255,255,0.6)' }};
      --pg-fine-align: {{ section.settings.gate_fine_align | default: 'center' }};
      --pg-fine-line: {{ section.settings.gate_fine_line_height | default: 150 | divided_by: 100.0 }};

      --pg-input-size: {{ section.settings.gate_input_size | default: 14 }}px;
      --pg-button-size: {{ section.settings.gate_button_size | default: 12 }}px;
      --pg-input-radius: {{ section.settings.gate_input_radius | default: 0 }}px;
      --pg-panel-radius: {{ section.settings.gate_panel_radius | default: 0 }}px;
      --pg-panel-bg-r: {{ gate_panel_color | color_extract: 'red' }};
      --pg-panel-bg-g: {{ gate_panel_color | color_extract: 'green' }};
      --pg-panel-bg-b: {{ gate_panel_color | color_extract: 'blue' }};
      --pg-panel-bg-alpha: {{ gate_panel_alpha }};
      --pg-panel-max-width: {{ section.settings.gate_panel_max_width | default: 460 }}px;
      --pg-panel-padding: {{ section.settings.gate_panel_padding | default: 36 }}px;
      --pg-bg-overlay: {{ section.settings.gate_bg_overlay_opacity | default: 0 | divided_by: 100.0 }};
      --pg-bg-position: {{ section.settings.gate_bg_position | default: 'center center' }};
      --pg-bg-fit: {{ section.settings.gate_bg_fit | default: 'cover' }};
    "
  >
    {%- if gate_required -%}
      {%- comment -%} Step 1: Email gate (overlay on top of the game) {%- endcomment -%}
      <div class="pantao-stepper__gate" data-step-gate>
        {%- if section.settings.gate_background_image != blank -%}
          <div class="pantao-stepper__gate-bg" aria-hidden="true">
            <img
              src="{{ section.settings.gate_background_image | image_url: width: 1920 }}"
              srcset="
                {{ section.settings.gate_background_image | image_url: width: 960 }} 960w,
                {{ section.settings.gate_background_image | image_url: width: 1920 }} 1920w,
                {{ section.settings.gate_background_image | image_url: width: 2400 }} 2400w
              "
              sizes="100vw"
              alt=""
              loading="eager"
            />
            {%- if section.settings.gate_bg_overlay_opacity > 0 -%}
              <div class="pantao-stepper__gate-bg-overlay" aria-hidden="true"></div>
            {%- endif -%}
          </div>
        {%- endif -%}

        <div class="pantao-stepper__gate-panel">
          {%- if section.settings.gate_eyebrow != blank -%}
            <div class="pantao-stepper__gate-eyebrow">{{ section.settings.gate_eyebrow }}</div>
          {%- endif -%}
          {%- if section.settings.gate_heading != blank -%}
            <div class="pantao-stepper__gate-heading">{{ section.settings.gate_heading }}</div>
          {%- endif -%}
          {%- if section.settings.gate_subheading != blank -%}
            <div class="pantao-stepper__gate-subheading">{{ section.settings.gate_subheading }}</div>
          {%- endif -%}

          {%- form 'customer', class: 'pantao-stepper__gate-form', id: 'pantao-stepper-form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter,pantao-mini">
            {%- assign gate_input_label = section.settings.gate_input_label | default: 'Email' -%}
            {%- if section.settings.gate_input_show_label -%}
              <label class="pantao-stepper__gate-label" for="pantao-stepper-email">{{ gate_input_label }}</label>
            {%- endif -%}
            <div class="pantao-stepper__gate-row">
              <input
                class="pantao-stepper__gate-input"
                id="pantao-stepper-email"
                type="email"
                name="contact[email]"
                placeholder="{{ section.settings.gate_input_placeholder | default: 'you@example.com' }}"
                aria-label="{{ gate_input_label }}"
                autocomplete="email"
                required
                aria-required="true"
              />
              <button class="pantao-stepper__gate-submit" type="submit">
                {{ section.settings.gate_button_label | default: 'Enter' }}
              </button>
            </div>
            <p class="pantao-stepper__gate-error" data-gate-error hidden></p>
            {%- if form.errors -%}
              <p class="pantao-stepper__gate-error">
                {%- for error in form.errors -%}
                  {{ form.errors.messages[error] }}{%- unless forloop.last -%}, {%- endunless -%}
                {%- endfor -%}
              </p>
            {%- endif -%}
            {%- if section.settings.gate_fine_print != blank -%}
              <div class="pantao-stepper__gate-fine">{{ section.settings.gate_fine_print }}</div>
            {%- endif -%}
          {%- endform -%}
        </div>
      </div>
    {%- endif -%}

    {%- comment -%} Step 2: The mini game itself {%- endcomment -%}
    <div class="pantao-stepper__game" data-step-game>
      <div class="pantao-tennis" data-pantao-tennis>
    <div class="pantao-tennis__header">
      <p class="pantao-tennis__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h2 class="pantao-tennis__title">{{ section.settings.heading | escape }}</h2>
      <p class="pantao-tennis__subtitle">{{ section.settings.subheading | escape }}</p>
    </div>

    <div class="pantao-tennis__scoreboard">
      <div class="pantao-tennis__score-block">
        <span class="pantao-tennis__score-label" data-player-label>Player</span>
        <span class="pantao-tennis__score-value" data-player-score>0</span>
      </div>
      <div class="pantao-tennis__meta">
        <span class="pantao-tennis__meta-label" data-status>Press start</span>
        <span class="pantao-tennis__meta-divider">/</span>
        <span class="pantao-tennis__meta-label">First to {{ section.settings.win_score }}</span>
      </div>
      <div class="pantao-tennis__score-block pantao-tennis__score-block--right">
        <span class="pantao-tennis__score-label">PG  CPU</span>
        <span class="pantao-tennis__score-value" data-cpu-score>0</span>
      </div>
    </div>

    <div class="pantao-tennis__court-wrap">
      <canvas
        class="pantao-tennis__court"
        data-court
        width="980"
        height="680"
        aria-label="Tennis court"
        role="img"
      ></canvas>
      <div class="pantao-tennis__overlay" data-overlay>
        <p class="pantao-tennis__overlay-title" data-overlay-title>PANTAO MINI</p>
        <p class="pantao-tennis__overlay-text" data-overlay-text>
          Move your paddle with the mouse, touch, or arrow keys.
        </p>
        <button class="pantao-tennis__btn" type="button" data-start>Start match</button>
      </div>
    </div>

    <div class="pantao-tennis__customize">
      <div class="pantao-tennis__field">
        <label class="pantao-tennis__control-label" for="pantao-tennis-name">Your name</label>
        <input
          class="pantao-tennis__input"
          id="pantao-tennis-name"
          type="text"
          maxlength="12"
          placeholder="PLAYER"
          autocomplete="off"
          data-name-input
        />
      </div>
      <div class="pantao-tennis__field">
        <label class="pantao-tennis__control-label" for="pantao-tennis-flag">Country</label>
        <select class="pantao-tennis__select" id="pantao-tennis-flag" data-flag-select>
          <option value="">— None —</option>
          <option value="PG">PG  Pantao Galeriya</option>
          <option value="🇦🇷">🇦🇷 Argentina</option>
          <option value="🇦🇺">🇦🇺 Australia</option>
          <option value="🇦🇹">🇦🇹 Austria</option>
          <option value="🇧🇪">🇧🇪 Belgium</option>
          <option value="🇧🇷">🇧🇷 Brazil</option>
          <option value="🇨🇦">🇨🇦 Canada</option>
          <option value="🇨🇱">🇨🇱 Chile</option>
          <option value="🇨🇳">🇨🇳 China</option>
          <option value="🇨🇴">🇨🇴 Colombia</option>
          <option value="🇨🇿">🇨🇿 Czechia</option>
          <option value="🇩🇰">🇩🇰 Denmark</option>
          <option value="🇪🇬">🇪🇬 Egypt</option>
          <option value="🇫🇮">🇫🇮 Finland</option>
          <option value="🇫🇷">🇫🇷 France</option>
          <option value="🇩🇪">🇩🇪 Germany</option>
          <option value="🇬🇷">🇬🇷 Greece</option>
          <option value="🇭🇰">🇭🇰 Hong Kong</option>
          <option value="🇭🇺">🇭🇺 Hungary</option>
          <option value="🇮🇳">🇮🇳 India</option>
          <option value="🇮🇩">🇮🇩 Indonesia</option>
          <option value="🇮🇪">🇮🇪 Ireland</option>
          <option value="🇮🇱">🇮🇱 Israel</option>
          <option value="🇮🇹">🇮🇹 Italy</option>
          <option value="🇯🇵">🇯🇵 Japan</option>
          <option value="🇰🇷">🇰🇷 Korea</option>
          <option value="🇲🇾">🇲🇾 Malaysia</option>
          <option value="🇲🇽">🇲🇽 Mexico</option>
          <option value="🇲🇦">🇲🇦 Morocco</option>
          <option value="🇳🇱">🇳🇱 Netherlands</option>
          <option value="🇳🇿">🇳🇿 New Zealand</option>
          <option value="🇳🇴">🇳🇴 Norway</option>
          <option value="🇵🇭">🇵🇭 Philippines</option>
          <option value="🇵🇱">🇵🇱 Poland</option>
          <option value="🇵🇹">🇵🇹 Portugal</option>
          <option value="🇷🇴">🇷🇴 Romania</option>
          <option value="🇷🇺">🇷🇺 Russia</option>
          <option value="🇸🇦">🇸🇦 Saudi Arabia</option>
          <option value="🇸🇬">🇸🇬 Singapore</option>
          <option value="🇿🇦">🇿🇦 South Africa</option>
          <option value="🇪🇸">🇪🇸 Spain</option>
          <option value="🇸🇪">🇸🇪 Sweden</option>
          <option value="🇨🇭">🇨🇭 Switzerland</option>
          <option value="🇹🇼">🇹🇼 Taiwan</option>
          <option value="🇹🇭">🇹🇭 Thailand</option>
          <option value="🇹🇷">🇹🇷 Turkey</option>
          <option value="🇺🇦">🇺🇦 Ukraine</option>
          <option value="🇦🇪">🇦🇪 UAE</option>
          <option value="🇬🇧">🇬🇧 United Kingdom</option>
          <option value="🇺🇸">🇺🇸 United States</option>
          <option value="🇻🇳">🇻🇳 Vietnam</option>
        </select>
      </div>
    </div>

    <div class="pantao-tennis__controls">
      <div class="pantao-tennis__control-group">
        <span class="pantao-tennis__control-label">Difficulty</span>
        <div class="pantao-tennis__chips" role="radiogroup" aria-label="Difficulty">
          <button class="pantao-tennis__chip is-active" type="button" data-difficulty="easy" role="radio" aria-checked="true">Easy</button>
          <button class="pantao-tennis__chip" type="button" data-difficulty="normal" role="radio" aria-checked="false">Normal</button>
          <button class="pantao-tennis__chip" type="button" data-difficulty="hard" role="radio" aria-checked="false">Hard</button>
          <button class="pantao-tennis__chip" type="button" data-difficulty="pro" role="radio" aria-checked="false">Pro</button>
        </div>
      </div>
      <div class="pantao-tennis__control-group pantao-tennis__control-group--end">
        <button class="pantao-tennis__btn pantao-tennis__btn--ghost" type="button" data-reset>Reset</button>
      </div>
    </div>

  </div>
    </div>{%- comment -%} /.pantao-stepper__game {%- endcomment -%}
  </div>{%- comment -%} /.pantao-stepper {%- endcomment -%}
</div>

<style>
  /* === Stepper / gate styles === */
  .pantao-stepper {
    position: relative;
  }
  .pantao-stepper__game {
    transition: opacity 0.45s ease;
  }
  .pantao-stepper[data-step="gate"] .pantao-stepper__game {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }
  .pantao-stepper[data-step="game"] .pantao-stepper__game {
    opacity: 1;
    visibility: visible;
  }
  .pantao-stepper__gate {
    position: absolute;
    inset: 0;
    z-index: 10;
    background: var(--pg-bg);
    color: var(--pg-fg);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    box-sizing: border-box;
    padding: 60px 24px;
    transition: opacity 0.45s ease, visibility 0s linear 0.45s;
  }
  /* Fullscreen mode: gate covers the entire viewport, breaking out of any
     theme containers/padding. Disabled by default for content pages where
     the gate should be inline; enable for password / hero use. */
  .pantao-stepper[data-fullscreen="true"] .pantao-stepper__gate {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    z-index: 9999;
  }
  /* When the gate is fixed-fullscreen, also lock body scroll so the user
     can't scroll past the gate to see partial game underneath. */
  .pantao-stepper[data-fullscreen="true"][data-step="gate"] {
    /* container itself stays normal flow so game is below it once unlocked */
  }
  .pantao-stepper[data-step="game"] .pantao-stepper__gate {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }
  .pantao-stepper[data-step="gate"] .pantao-stepper__gate {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.45s ease, visibility 0s linear 0s;
  }
  .pantao-stepper__gate-bg {
    position: absolute; inset: 0; z-index: 0;
    overflow: hidden;
  }
  .pantao-stepper__gate-bg img {
    width: 100%; height: 100%;
    object-fit: var(--pg-bg-fit, cover);
    object-position: var(--pg-bg-position, center center);
    display: block;
  }
  .pantao-stepper__gate-bg-overlay {
    position: absolute; inset: 0;
    background: #000;
    opacity: var(--pg-bg-overlay, 0);
    pointer-events: none;
  }
  .pantao-stepper__gate-panel {
    position: relative;
    z-index: 1;
    max-width: var(--pg-panel-max-width, 460px);
    width: 100%;
    margin: 0 auto;
    background: rgba(
      var(--pg-panel-bg-r, 13),
      var(--pg-panel-bg-g, 31),
      var(--pg-panel-bg-b, 13),
      var(--pg-panel-bg-alpha, 0.6)
    );
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: var(--pg-panel-radius, 0);
    padding: var(--pg-panel-padding, 36px) calc(var(--pg-panel-padding, 36px) * 0.78);
    box-sizing: border-box;
  }
  .pantao-stepper__gate-eyebrow {
    font-size: var(--pg-eyebrow-size, 11px);
    letter-spacing: calc(var(--pg-eyebrow-tracking, 22) * 0.01em);
    line-height: var(--pg-eyebrow-line, 1.4);
    text-transform: uppercase;
    color: var(--pg-eyebrow-color, var(--pg-muted));
    text-align: var(--pg-eyebrow-align, center);
    margin: 0 0 18px;
  }
  .pantao-stepper__gate-eyebrow > *:first-child { margin-top: 0; }
  .pantao-stepper__gate-eyebrow > *:last-child { margin-bottom: 0; }
  .pantao-stepper__gate-heading {
    font-size: var(--pg-heading-size, 36px);
    letter-spacing: calc(var(--pg-heading-tracking, 4) * 0.01em);
    line-height: var(--pg-heading-line, 1.05);
    text-transform: uppercase;
    margin: 0 0 12px;
    color: var(--pg-heading-color, var(--pg-fg));
    text-align: var(--pg-heading-align, center);
    font-weight: 600;
  }
  .pantao-stepper__gate-heading > *:first-child { margin-top: 0; font-size: inherit; font-weight: inherit; line-height: inherit; }
  .pantao-stepper__gate-heading > *:last-child { margin-bottom: 0; }
  .pantao-stepper__gate-subheading {
    font-size: var(--pg-subheading-size, 14px);
    line-height: var(--pg-subheading-line, 1.5);
    color: var(--pg-subheading-color, var(--pg-muted));
    text-align: var(--pg-subheading-align, center);
    margin: 0 0 26px;
  }
  .pantao-stepper__gate-subheading > *:first-child { margin-top: 0; }
  .pantao-stepper__gate-subheading > *:last-child { margin-bottom: 0; }
  .pantao-stepper__gate-form { margin: 0; }
  .pantao-stepper__gate-label {
    display: block;
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--pg-muted);
    margin-bottom: 8px;
    text-align: left;
  }
  .pantao-stepper__gate-row {
    display: flex;
    border: 1px solid var(--pg-fg);
    border-radius: var(--pg-input-radius, 0);
    overflow: hidden;
  }
  .pantao-stepper__gate-input {
    flex: 1 1 auto;
    appearance: none;
    border: none;
    background: transparent;
    color: var(--pg-fg);
    font: inherit;
    font-size: var(--pg-input-size, 14px);
    letter-spacing: 0.04em;
    padding: 12px 14px;
    outline: none;
    border-radius: 0;
    min-width: 0;
  }
  .pantao-stepper__gate-input::placeholder { color: rgba(255,255,255,0.35); }
  .pantao-stepper__gate-submit {
    appearance: none;
    border: none;
    border-left: 1px solid var(--pg-fg);
    background: var(--pg-fg);
    color: var(--pg-bg);
    font: inherit;
    font-size: var(--pg-button-size, 12px);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    padding: 12px 22px;
    cursor: pointer;
    border-radius: 0;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .pantao-stepper__gate-submit:hover {
    background: var(--pg-accent);
    color: var(--pg-bg);
  }
  .pantao-stepper__gate-submit:disabled {
    opacity: 0.6;
    cursor: progress;
  }
  .pantao-stepper__gate-error {
    margin: 14px 0 0;
    font-size: 12px;
    color: #ff6b6b;
    text-align: left;
  }
  .pantao-stepper__gate-fine {
    margin: 18px 0 0;
    font-size: var(--pg-fine-size, 11px);
    line-height: var(--pg-fine-line, 1.5);
    color: var(--pg-fine-color, var(--pg-muted));
    text-align: var(--pg-fine-align, center);
  }
  .pantao-stepper__gate-fine p { margin: 0; }
  .pantao-stepper__gate-fine > *:first-child { margin-top: 0; }
  .pantao-stepper__gate-fine > *:last-child { margin-bottom: 0; }

  /* === Original tennis styles === */
  .pantao-tennis {
    --pt-fg: #000;
    --pt-bg: #fff;
    --pt-muted: #666;
    --pt-line: #e6e6e6;
    --pt-court: #fafafa;

    max-width: 880px;
    margin: 0 auto;
    padding: 0 16px;
    color: var(--pt-fg);
    font-family: inherit;
  }

  .pantao-tennis__header {
    text-align: center;
    margin-bottom: 32px;
  }

  .pantao-tennis__eyebrow {
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--pt-muted);
    margin: 0 0 12px;
  }

  .pantao-tennis__title {
    font-size: clamp(36px, 7vw, 72px);
    line-height: 1;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    margin: 0 0 12px;
    font-weight: 400;
  }

  .pantao-tennis__subtitle {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--pt-muted);
    margin: 0;
  }

  .pantao-tennis__scoreboard {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
    border-block: 1px solid var(--pt-fg);
    padding: 18px 4px;
    margin-bottom: 0;
  }

  .pantao-tennis__score-block {
    display: flex;
    flex-direction: column;
    gap: 4px;
    text-align: left;
  }

