{%- comment -%}
  Pantao Arrival Hero
  --------------------------------------------------------
  A full-viewport hero used on the landing page after a member signs in.
  Atmospheric image or video, almost no UI — sets the mood for the edition.

  Reuses the proven media patterns from password-antechamber:
    - Image rendering via the theme's `background-media` snippet so it
      inherits the working .background-image-container CSS.
    - Direct <video> element with autoplay-nudge JS for reliable playback.

  No CTA button by design. The visitor scrolls. Commerce comes later.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
-%}

{%- comment -%}
  Shared reveal backdrop — one fixed image behind both the hero and the
  product section, so the campaign photo never cuts at the section
  boundary. Rendered as a sibling of `.arrival-hero` (not a child) so no
  ancestor overflow/transform interferes with its fixed positioning.
  Hidden until the controller JS adds `html.pantao-reveal-on`, and hidden
  again (`.is-past`) once the reveal scrolls out, so following sections
  render normally. Degrades to the standard hero when reveal is off.
{%- endcomment -%}
{%- if s.enable_reveal and s.image != blank -%}
  <div class="pantao-reveal-backdrop" data-reveal-backdrop aria-hidden="true"
       style="background-image: url('{{ s.image | image_url: width: 2400 }}');">
    <div class="pantao-reveal-backdrop__scrim"></div>
  </div>
{%- endif -%}

<div
  class="arrival-hero color-{{ s.color_scheme }} arrival-hero--{{ s.height }}{% if s.enable_reveal %} arrival-hero--reveal{% endif %}"
  data-section-id="{{ section.id }}"
  {% if s.enable_reveal %}data-reveal-hero{% endif %}
>
  <div class="arrival-hero__media arrival-hero__media--{{ s.media_type }}">
    {%- if s.media_type == 'video' and s.video != blank -%}
      {%- liquid
        assign poster_url = ''
        if s.video.preview_image != blank
          assign poster_url = s.video.preview_image | image_url: width: 2400
        endif
      -%}
      <video
        class="arrival-hero__video arrival-hero__video--{{ s.video_position }}"
        muted
        playsinline
        autoplay
        loop
        preload="metadata"
        disablepictureinpicture
        disableremoteplayback
        {% if poster_url != blank %}poster="{{ poster_url }}"{% endif %}
        data-arrival-video
      >
        {%- for source in s.video.sources -%}
          <source src="{{ source.url }}" type="{{ source.mime_type }}">
        {%- endfor -%}
      </video>
    {%- elsif s.media_type == 'image' and s.image != blank -%}
      {% render 'background-media',
        background_media: 'image',
        background_image: s.image,
        background_image_position: s.image_position_fit,
        placeholder: 'lifestyle-1',
        section: section
      %}
    {%- else -%}
      <div class="arrival-hero__placeholder">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'arrival-hero__placeholder-svg' }}
      </div>
    {%- endif -%}

    {%- comment -%} directional scrim — keeps the type legible over any photo {%- endcomment -%}
    <div class="arrival-hero__scrim" aria-hidden="true"></div>

    {%- if s.show_overlay -%}
      <div class="arrival-hero__overlay" style="--overlay-opacity: {{ s.overlay_opacity | divided_by: 100.0 }};"></div>
    {%- endif -%}
  </div>

  <div class="arrival-hero__content arrival-hero__content--{{ s.content_position }}">
    <div class="arrival-hero__inner">
      {%- if s.eyebrow != blank -%}
        <p class="arrival-hero__eyebrow">{{ s.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if s.heading_line_1 != blank or s.heading_line_2 != blank -%}
        <h1 class="arrival-hero__title">
          {%- if s.heading_line_1 != blank -%}
            <span class="arrival-hero__tline"><span class="arrival-hero__tline-i">{{ s.heading_line_1 | escape }}</span></span>
          {%- endif -%}
          {%- if s.heading_line_2 != blank -%}
            <span class="arrival-hero__tline"><span class="arrival-hero__tline-i arrival-hero__tline-i--em">{{ s.heading_line_2 | escape }}</span></span>
          {%- endif -%}
        </h1>
      {%- endif -%}

      {%- if s.lede != blank -%}
        <p class="arrival-hero__lede">{{ s.lede | escape }}</p>
      {%- endif -%}

      {%- if s.cta_label != blank -%}
        <div class="arrival-hero__cta">
          <a class="arrival-hero__btn" href="{{ s.cta_link | default: '#' }}">{{ s.cta_label | escape }}</a>
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- if s.show_scroll_hint -%}
    <p class="arrival-hero__scroll-hint" aria-hidden="true">
      <span>{{ s.scroll_hint_text | default: 'Scroll' }}</span>
    </p>
  {%- endif -%}
</div>

{% stylesheet %}
  .arrival-hero {
    position: relative;
    width: 100%;
    overflow: hidden;
    color: var(--color-foreground);
    background: var(--color-background-secondary, #1a1a1a);
  }

  .arrival-hero--full {
    height: 100svh;
    min-height: 600px;
  }

  .arrival-hero--three-quarters {
    height: 75svh;
    min-height: 500px;
  }

  .arrival-hero--half {
    height: 50svh;
    min-height: 400px;
  }

  /* ---------- Media ---------- */
  .arrival-hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .arrival-hero__video,
  .arrival-hero__placeholder,
  .arrival-hero__placeholder-svg,
  .arrival-hero__placeholder svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .arrival-hero__video--contain {
    object-fit: contain;
  }

  .arrival-hero__overlay {
    position: absolute;
    inset: 0;
    background: #000;
    opacity: var(--overlay-opacity, 0.2);
    pointer-events: none;
  }

  /* directional scrim: darker top (nav), left (type), and bottom (headline) */
  .arrival-hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      linear-gradient(180deg, rgba(12,14,17,0.42) 0%, rgba(12,14,17,0.05) 26%,
        rgba(12,14,17,0.08) 50%, rgba(12,14,17,0.72) 100%),
      linear-gradient(90deg, rgba(12,14,17,0.5) 0%, rgba(12,14,17,0.14) 42%, transparent 72%);
  }

  @media (prefers-reduced-motion: reduce) {
    .arrival-hero__video {
      display: none;
    }
  }

  /* ---------- Content overlay ---------- */
  .arrival-hero__content {
    position: relative;
    z-index: 1;
    height: 100%;
    display: flex;
    padding: 3rem 1.5rem;
  }

  @media (min-width: 750px) {
    .arrival-hero__content {
      padding: 4rem 3rem;
    }
  }

  @media (min-width: 1200px) {
    .arrival-hero__content {
      padding: 5rem 5rem;
    }
  }

  .arrival-hero__content--top-left {
    align-items: flex-start;
    justify-content: flex-start;
    text-align: left;
  }

  .arrival-hero__content--top-center {
    align-items: flex-start;
    justify-content: center;
    text-align: center;
  }

  .arrival-hero__content--center {
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .arrival-hero__content--bottom-left {
    align-items: flex-end;
    justify-content: flex-start;
    text-align: left;
  }

  .arrival-hero__content--bottom-center {
    align-items: flex-end;
    justify-content: center;
    text-align: center;
  }

  /* content sits over the photo — light, fixed, scheme-independent */
  .arrival-hero__inner {
    max-width: 54rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0;
    color: #f4f5f5;
  }

  .arrival-hero__eyebrow {
    font-family: var(--font-body--family);
    font-size: var(--font-size--3xs);
    letter-spacing: 0.32em;
    text-transform: uppercase;
    margin: 0 0 1.9rem 0;
    color: rgba(245, 246, 245, 0.9);
    text-shadow: 0 1px 20px rgba(0, 0, 0, 0.4);
    opacity: 0;
    animation: arrival-fade 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.05s forwards;
  }

  .arrival-hero__title {
    font-family: var(--font-accent--family);
    font-style: var(--font-accent--style, normal);
    font-weight: var(--font-accent--weight, 500);
    font-size: clamp(3rem, 10vw, 9rem);
    line-height: 0.92;
    letter-spacing: -0.01em;
    margin: 0;
    text-shadow: 0 1px 16px rgba(0, 0, 0, 0.18);
  }

  .arrival-hero__tline {
    display: block;
    overflow: hidden;
  }

  .arrival-hero__tline-i {
    display: block;
    transform: translateY(115%);
    animation: arrival-rise 1.05s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  .arrival-hero__tline:nth-child(1) .arrival-hero__tline-i { animation-delay: 0.14s; }
  .arrival-hero__tline:nth-child(2) .arrival-hero__tline-i { animation-delay: 0.26s; }

  .arrival-hero__tline-i--em {
    font-style: italic;
    font-weight: 400;
  }

  .arrival-hero__lede {
    font-family: var(--font-body--family);
    font-size: var(--font-size--md);
    line-height: 1.6;
    max-width: 30rem;
    margin: 2rem 0 0 0;
    color: rgba(245, 246, 245, 0.82);
    text-shadow: 0 1px 18px rgba(0, 0, 0, 0.35);
    opacity: 0;
    animation: arrival-fade 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.42s forwards;
  }

  .arrival-hero__cta {
    margin-top: 2.4rem;
    opacity: 0;
    animation: arrival-fade 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.54s forwards;
  }

  .arrival-hero__btn {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-body--family);
    font-size: var(--font-size--3xs);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #f4f5f5;
    text-decoration: none;
    padding: 1rem 2.1rem;
    border: 1px solid rgba(245, 246, 245, 0.5);
    border-radius: 100px;
    transition: background-color 0.4s ease, color 0.4s ease, border-color 0.4s ease;
  }

  .arrival-hero__btn:hover {
    background: #f4f5f5;
    color: #14161a;
    border-color: #f4f5f5;
  }

  @keyframes arrival-rise { to { transform: none; } }
  @keyframes arrival-fade { to { opacity: 1; } }

  @media (prefers-reduced-motion: reduce) {
    .arrival-hero__tline-i,
    .arrival-hero__eyebrow,
    .arrival-hero__lede,
    .arrival-hero__cta {
      animation: none;
      transform: none;
      opacity: 1;
    }
  }

  /* ---------- Scroll hint ---------- */
  .arrival-hero__scroll-hint {
    position: absolute;
    bottom: 1.5rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1;
    font-family: var(--font-body--family);
    font-size: var(--font-size--3xs);
    letter-spacing: 0.4em;
    text-transform: uppercase;
    margin: 0;
    opacity: 0.7;
    animation: arrival-hint 2.4s ease-in-out infinite;
  }

  @keyframes arrival-hint {
    0%, 100% { transform: translate(-50%, 0); opacity: 0.7; }
    50% { transform: translate(-50%, 4px); opacity: 0.4; }
  }

  @media (prefers-reduced-motion: reduce) {
    .arrival-hero__scroll-hint {
      animation: none;
    }
  }

  /* ============================================================
     THE REVEAL — shared fixed backdrop + hero hand-off
     Only active when the controller JS (in the product section)
     adds `pantao-reveal-on` to <html>. That happens exclusively on
     desktop, with motion allowed, and only when BOTH the hero and
     the product section have reveal enabled. Otherwise every rule
     below is inert and the hero renders exactly as it does today.
     ============================================================ */

  /* Backdrop is dormant until the controller activates it. */
  .pantao-reveal-backdrop { display: none; }

  html.pantao-reveal-on .pantao-reveal-backdrop {
    display: block;
    position: fixed;
    inset: 0;
    z-index: -1; /* above the opaque body canvas, below all section content */
    background-size: cover;
    background-position: center;
    filter:
      blur(calc(var(--reveal-bd, 0) * 14px))
      brightness(calc(1 - var(--reveal-bd, 0) * 0.22))
      saturate(calc(1 + var(--reveal-bd, 0) * 0.06));
    transform: scale(calc(1.02 + var(--reveal-bd, 0) * 0.05));
    will-change: filter, transform;
  }

  /* Once the reveal has scrolled past, drop the backdrop entirely so
     the footer and everything after it paint over their own backgrounds. */
  html.pantao-reveal-on .pantao-reveal-backdrop.is-past { display: none; }

  .pantao-reveal-backdrop__scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    /* constant directional scrim keeps the headline legible over the
       light tarmac; the radial term deepens as you scroll into the piece */
    background:
      linear-gradient(180deg, rgba(12,14,17,0.34) 0%, rgba(12,14,17,0.04) 26%,
        rgba(12,14,17,0.06) 52%, rgba(12,14,17,0.55) 100%),
      linear-gradient(90deg, rgba(12,14,17,0.42) 0%, rgba(12,14,17,0.12) 44%, transparent 72%),
      radial-gradient(120% 90% at 50% 42%, transparent 48%, rgba(10,12,15, calc(var(--reveal-bd, 0) * 0.40)));
  }

  /* Hero in reveal mode: transparent so the fixed backdrop shows through
     (the hero's own media is hidden — the backdrop *is* the image, pinned,
     so the transition from hero to piece never moves the photo). */
  html.pantao-reveal-on .arrival-hero--reveal {
    background: transparent;
    overflow: visible;
  }

  html.pantao-reveal-on .arrival-hero--reveal .arrival-hero__media {
    display: none;
  }

  /* Headline fades and lifts as the hero scrolls away. Scroll-driven, so
     the entrance keyframe animations are stood down. */
  html.pantao-reveal-on .arrival-hero--reveal .arrival-hero__inner {
    opacity: var(--reveal-hero, 1);
    transform: translateY(calc((1 - var(--reveal-hero, 1)) * -30px));
  }

  html.pantao-reveal-on .arrival-hero--reveal .arrival-hero__eyebrow,
  html.pantao-reveal-on .arrival-hero--reveal .arrival-hero__lede,
  html.pantao-reveal-on .arrival-hero--reveal .arrival-hero__cta {
    animation: none;
    opacity: var(--reveal-hero, 1);
  }

  html.pantao-reveal-on .arrival-hero--reveal .arrival-hero__scroll-hint {
    opacity: calc(var(--reveal-hero, 1) * 0.7);
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    function prefersReducedMotion() {
      return window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    }

    // Same playback nudge pattern as password-antechamber.
    function nudgeVideoPlayback(video) {
      if (!video || prefersReducedMotion()) return;

      video.muted = true;
      video.defaultMuted = true;
      video.playsInline = true;

      function tryPlay() {
        const promise = video.play();
        if (promise && typeof promise.catch === 'function') {
          promise.catch(function () { /* blocked, retry below */ });
        }
      }

      if (video.readyState >= 2) {
        tryPlay();
      } else {
        video.addEventListener('loadeddata', tryPlay, { once: true });
        video.addEventListener('canplay', tryPlay, { once: true });
      }

      document.addEventListener('visibilitychange', function () {
        if (!document.hidden && video.paused) tryPlay();
      });

      const onInteract = function () {
        if (video.paused) tryPlay();
        window.removeEventListener('pointerdown', onInteract);
        window.removeEventListener('keydown', onInteract);
        window.removeEventListener('scroll', onInteract);
      };
      window.addEventListener('pointerdown', onInteract, { passive: true });
      window.addEventListener('keydown', onInteract);
      window.addEventListener('scroll', onInteract, { passive: true });
    }

    function init(root) {
      if (!root || root.dataset.arrivalReady === 'true') return;
      root.dataset.arrivalReady = 'true';
      const video = root.querySelector('[data-arrival-video]');
      nudgeVideoPlayback(video);
    }

    function initAll() {
      document.querySelectorAll('.arrival-hero').forEach(init);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAll);
    } else {
      initAll();
    }

    document.addEventListener('shopify:section:load', initAll);
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Arrival hero",
  "tag": "section",
  "class": "section-arrival-hero",
  "settings": [
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "select",
      "id": "media_type",
      "label": "Media type",
      "options": [
        { "value": "image", "label": "Image" },
        { "value": "video", "label": "Video" },
        { "value": "none",  "label": "None (placeholder)" }
      ],
      "default": "image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "visible_if": "{{ section.settings.media_type == 'image' }}"
    },
    {
      "type": "select",
      "id": "image_position_fit",
      "label": "Image fit",
      "options": [
        { "value": "cover", "label": "Cover" },
        { "value": "fit",   "label": "Contain" }
      ],
      "default": "cover",
      "visible_if": "{{ section.settings.media_type == 'image' }}"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video",
      "info": "MP4, looped, muted, ≤ 12 seconds works best.",
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "select",
      "id": "video_position",
      "label": "Video fit",
      "options": [
        { "value": "cover",   "label": "Cover" },
        { "value": "contain", "label": "Contain" }
      ],
      "default": "cover",
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "checkbox",
      "id": "show_overlay",
      "label": "Darken media for legibility",
      "default": true
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 25,
      "visible_if": "{{ section.settings.show_overlay }}"
    },

    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        { "value": "full",            "label": "Full viewport" },
        { "value": "three-quarters",  "label": "Three quarters" },
        { "value": "half",            "label": "Half" }
      ],
      "default": "full"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Content position",
      "options": [
        { "value": "top-left",      "label": "Top left" },
        { "value": "top-center",    "label": "Top center" },
        { "value": "center",        "label": "Center" },
        { "value": "bottom-left",   "label": "Bottom left" },
        { "value": "bottom-center", "label": "Bottom center" }
      ],
      "default": "bottom-left"
    },

    {
      "type": "header",
      "content": "Copy"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "info": "Small line above the headline.",
      "default": "EDITION V · MMXXVI · MANILA"
    },
    {
      "type": "text",
      "id": "heading_line_1",
      "label": "Headline line 1",
      "default": "The doors"
    },
    {
      "type": "text",
      "id": "heading_line_2",
      "label": "Headline line 2 (italic)",
      "default": "are open."
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Lede",
      "default": "Pantao opens once a year. A single edition, made in numbers small enough to know each piece by hand — then the doors close until the next."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "info": "Leave blank to hide the button.",
      "default": "Enter the edition"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link"
    },

    {
      "type": "header",
      "content": "Scroll hint"
    },
    {
      "type": "checkbox",
      "id": "show_scroll_hint",
      "label": "Show scroll hint",
      "default": true
    },
    {
      "type": "text",
      "id": "scroll_hint_text",
      "label": "Scroll hint text",
      "default": "Scroll"
    },

    {
      "type": "header",
      "content": "The Reveal"
    },
    {
      "type": "paragraph",
      "content": "When on, this hero hands off into the product section below as a single scroll-driven experience (desktop only; falls back to the standard hero on mobile or with reduced motion). The product section must also have The Reveal enabled."
    },
    {
      "type": "checkbox",
      "id": "enable_reveal",
      "label": "Enable scroll reveal into the product",
      "default": false
    },

    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Arrival hero"
    }
  ]
}
{% endschema %}
