{%- comment -%}
  Pantao Showcase  (v1)
  --------------------------------------------------------
  Acne-style editorial grid: large full-bleed image OR video tiles with a
  small corner label. The whole tile (media + label) links to a collection
  or page. Flush by default (no gutters), stacks on mobile.

  Each tile is one block, so cards can be added/reordered in the editor.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign colpct = 100 | divided_by: s.columns_desktop
  assign sizes_attr = '(min-width: 750px) ' | append: colpct | append: 'vw, 100vw'
-%}

<div
  class="pantao-showcase color-{{ s.color_scheme }}{% if s.full_width %} pantao-showcase--full{% endif %}"
  style="
    --ps-cols: {{ s.columns_desktop }};
    --ps-cols-mobile: {{ s.columns_mobile }};
    --ps-gap: {{ s.gap }}px;
    --ps-ratio: {{ s.aspect_ratio }};
    --ps-label-size: {{ s.label_size }}px;
    --ps-label-inset: {{ s.label_inset }}px;
  "
>
  {%- if s.eyebrow != blank or s.heading != blank -%}
    <div class="pantao-showcase__head">
      {%- if s.eyebrow != blank -%}
        <p class="pantao-showcase__eyebrow">{{ s.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if s.heading != blank -%}
        <h2 class="pantao-showcase__heading">{{ s.heading | escape }}</h2>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <div class="pantao-showcase__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign b = block.settings
          assign lcolor = b.label_color
          if lcolor == 'auto'
            assign lcolor = s.label_color
          endif
          assign lpos = b.label_position
          if lpos == 'auto'
            assign lpos = s.label_position
          endif
        -%}
        {%- capture card_inner -%}
          <div class="pantao-card__media">
            {%- if b.media_type == 'video' and b.video != blank -%}
              {%- liquid
                assign poster = ''
                if b.video.preview_image != blank
                  assign poster = b.video.preview_image | image_url: width: 1600
                endif
              -%}
              <video
                class="pantao-card__video"
                muted
                playsinline
                autoplay
                loop
                preload="metadata"
                disablepictureinpicture
                {% if poster != blank %}poster="{{ poster }}"{% endif %}
                data-showcase-video
              >
                {%- for source in b.video.sources -%}
                  <source src="{{ source.url }}" type="{{ source.mime_type }}">
                {%- endfor -%}
              </video>
              {%- if poster != blank -%}
                <img class="pantao-card__video-fallback" src="{{ poster }}" alt="{{ b.label | escape }}" loading="lazy" width="1600" height="2133">
              {%- endif -%}
            {%- elsif b.image != blank -%}
              {{
                b.image
                | image_url: width: 1600
                | image_tag:
                  loading: 'lazy',
                  class: 'pantao-card__img',
                  widths: '400, 600, 800, 1000, 1200, 1600, 2000',
                  sizes: sizes_attr,
                  alt: b.label
              }}
            {%- else -%}
              <div class="pantao-card__ph">
                {{ 'lifestyle-1' | placeholder_svg_tag: 'pantao-card__ph-svg' }}
              </div>
            {%- endif -%}
          </div>

          {%- if b.label != blank -%}
            <span class="pantao-card__label pantao-card__label--{{ lpos }}">{{ b.label | escape }}</span>
          {%- endif -%}
        {%- endcapture -%}

        {%- if b.link != blank -%}
          <a
            class="pantao-card pantao-card--label-{{ lcolor }} pantao-card--link"
            href="{{ b.link }}"
            {% if b.aria_label != blank %}aria-label="{{ b.aria_label | escape }}"{% elsif b.label != blank %}aria-label="{{ b.label | escape }}"{% endif %}
            {{ block.shopify_attributes }}
          >{{ card_inner }}</a>
        {%- else -%}
          <div class="pantao-card pantao-card--label-{{ lcolor }}" {{ block.shopify_attributes }}>{{ card_inner }}</div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- else -%}
    <div class="pantao-showcase__empty">
      <p>{{ 'Add a card block to show image or video tiles.' }}</p>
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  .pantao-showcase {
    background: var(--color-background);
    padding-block: var(--ps-section-pad, 0);
  }

  .pantao-showcase__head {
    padding: 2.5rem var(--page-margin, 1.5rem) 1.5rem;
    text-align: center;
  }

  .pantao-showcase__eyebrow {
    font-family: var(--font-body--family);
    font-size: var(--font-size--3xs, 0.72rem);
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--color-foreground);
    opacity: 0.7;
    margin: 0 0 0.6rem 0;
  }

  .pantao-showcase__heading {
    font-family: var(--font-accent--family);
    font-size: clamp(1.6rem, 3vw, 2.6rem);
    margin: 0;
    color: var(--color-foreground);
  }

  /* ---------- Grid ---------- */
  .pantao-showcase__grid {
    display: grid;
    grid-template-columns: repeat(var(--ps-cols-mobile, 1), 1fr);
    gap: var(--ps-gap, 0px);
  }

  @media screen and (min-width: 750px) {
    .pantao-showcase__grid {
      grid-template-columns: repeat(var(--ps-cols, 2), 1fr);
    }
  }

  /* Contained vs full-bleed */
  .pantao-showcase:not(.pantao-showcase--full) .pantao-showcase__grid {
    padding-inline: var(--page-margin, 1.5rem);
  }

  /* ---------- Card ---------- */
  .pantao-card {
    position: relative;
    display: block;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    background: var(--color-background-secondary, #e9e7e2);
  }

  .pantao-card--link {
    cursor: pointer;
  }

  .pantao-card__media {
    position: relative;
    width: 100%;
    aspect-ratio: var(--ps-ratio, 3 / 4);
    overflow: hidden;
  }

  .pantao-card__img,
  .pantao-card__video,
  .pantao-card__video-fallback,
  .pantao-card__ph,
  .pantao-card__ph-svg,
  .pantao-card__ph svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Video sits above its own poster fallback; if JS/motion is off the
     poster image shows through. */
  .pantao-card__video {
    z-index: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .pantao-card__video {
      display: none;
    }
  }

  /* Hover: slow editorial zoom (only on linked, pointer devices) */
  @media (hover: hover) {
    .pantao-card--link .pantao-card__img,
    .pantao-card--link .pantao-card__video,
    .pantao-card--link .pantao-card__video-fallback {
      transition: transform 0.9s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .pantao-card--link:hover .pantao-card__img,
    .pantao-card--link:hover .pantao-card__video,
    .pantao-card--link:hover .pantao-card__video-fallback {
      transform: scale(1.04);
    }
  }

  .pantao-card--link:focus-visible {
    outline: 2px solid var(--color-foreground);
    outline-offset: -2px;
  }

  /* ---------- Label ---------- */
  .pantao-card__label {
    position: absolute;
    z-index: 2;
    font-family: var(--font-body--family);
    font-size: var(--ps-label-size, 12px);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    line-height: 1;
    margin: 0;
    padding: 0;
    pointer-events: none;
  }

  .pantao-card--label-light .pantao-card__label {
    color: #f4f5f5;
    text-shadow: 0 1px 14px rgba(0, 0, 0, 0.45);
  }

  .pantao-card--label-dark .pantao-card__label {
    color: #141414;
  }

  .pantao-card__label--top-left     { top: var(--ps-label-inset, 12px); left: var(--ps-label-inset, 12px); }
  .pantao-card__label--top-right    { top: var(--ps-label-inset, 12px); right: var(--ps-label-inset, 12px); }
  .pantao-card__label--bottom-left  { bottom: var(--ps-label-inset, 12px); left: var(--ps-label-inset, 12px); }
  .pantao-card__label--bottom-right { bottom: var(--ps-label-inset, 12px); right: var(--ps-label-inset, 12px); }

  .pantao-showcase__empty {
    padding: 4rem var(--page-margin, 1.5rem);
    text-align: center;
    color: var(--color-foreground);
    opacity: 0.6;
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    function prefersReducedMotion() {
      return window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    }

    function nudge(video) {
      if (!video || prefersReducedMotion()) return;
      video.muted = true;
      video.playsInline = true;
      var play = function () {
        var p = video.play();
        if (p && p.catch) p.catch(function () {});
      };
      if (video.readyState >= 2) play();
      else {
        video.addEventListener('loadeddata', play, { once: true });
        video.addEventListener('canplay', play, { once: true });
      }
    }

    function initAll() {
      document.querySelectorAll('[data-showcase-video]').forEach(nudge);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAll);
    } else {
      initAll();
    }
    document.addEventListener('shopify:section:load', initAll);
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Showcase",
  "tag": "section",
  "class": "section-pantao-showcase",
  "settings": [
    {
      "type": "header",
      "content": "Heading (optional)"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "info": "Small line above the heading. Leave blank for an Acne-style grid with no heading."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns (desktop)",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns (mobile)",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "1"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between tiles",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 0,
      "info": "0 = flush, edge-to-edge (Acne style)."
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width (edge to edge)",
      "default": true
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Tile shape",
      "options": [
        { "value": "3 / 4",  "label": "Portrait (3:4)" },
        { "value": "2 / 3",  "label": "Tall (2:3)" },
        { "value": "1 / 1",  "label": "Square (1:1)" },
        { "value": "4 / 3",  "label": "Landscape (4:3)" },
        { "value": "16 / 9", "label": "Wide (16:9)" }
      ],
      "default": "3 / 4"
    },
    {
      "type": "header",
      "content": "Label defaults",
      "info": "Each card can override these."
    },
    {
      "type": "select",
      "id": "label_position",
      "label": "Label position",
      "options": [
        { "value": "top-left",     "label": "Top left" },
        { "value": "top-right",    "label": "Top right" },
        { "value": "bottom-left",  "label": "Bottom left" },
        { "value": "bottom-right", "label": "Bottom right" }
      ],
      "default": "top-left"
    },
    {
      "type": "select",
      "id": "label_color",
      "label": "Label color",
      "options": [
        { "value": "light", "label": "Light (for dark images)" },
        { "value": "dark",  "label": "Dark (for light images)" }
      ],
      "default": "light"
    },
    {
      "type": "range",
      "id": "label_size",
      "label": "Label size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "label_inset",
      "label": "Label edge spacing",
      "info": "Distance from the tile corner. Lower = more flush.",
      "min": 4,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "select",
          "id": "media_type",
          "label": "Media type",
          "options": [
            { "value": "image", "label": "Image" },
            { "value": "video", "label": "Video" }
          ],
          "default": "image"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "visible_if": "{{ block.settings.media_type == 'image' }}"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video",
          "info": "MP4, looped & muted. A poster/preview frame is used as the still fallback.",
          "visible_if": "{{ block.settings.media_type == 'video' }}"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "info": "Small category/collection label shown on the tile.",
          "default": "COLLECTION"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "The whole tile (media + label) links here."
        },
        {
          "type": "text",
          "id": "aria_label",
          "label": "Accessible link text",
          "info": "Optional. Falls back to the label."
        },
        {
          "type": "header",
          "content": "Overrides (optional)"
        },
        {
          "type": "select",
          "id": "label_position",
          "label": "Label position",
          "options": [
            { "value": "auto",         "label": "Use section default" },
            { "value": "top-left",     "label": "Top left" },
            { "value": "top-right",    "label": "Top right" },
            { "value": "bottom-left",  "label": "Bottom left" },
            { "value": "bottom-right", "label": "Bottom right" }
          ],
          "default": "auto"
        },
        {
          "type": "select",
          "id": "label_color",
          "label": "Label color",
          "options": [
            { "value": "auto",  "label": "Use section default" },
            { "value": "light", "label": "Light" },
            { "value": "dark",  "label": "Dark" }
          ],
          "default": "auto"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Showcase",
      "blocks": [
        { "type": "card", "settings": { "label": "THE EDITION" } },
        { "type": "card", "settings": { "label": "ACCESSORIES" } }
      ]
    }
  ]
}
{% endschema %}
