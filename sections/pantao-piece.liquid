{%- comment -%}
  Pantao — The Piece
  --------------------------------------------------------
  A single product, presented editorially, with real commerce.

  The layout, copy, and feeling are ours. The buying is the theme's own,
  tested machinery: the `variant-picker` and `buy-buttons` blocks are
  rendered with `closest.product` set to the chosen product, so size
  selection, add-to-bag (opens the cart drawer), and Buy Now (accelerated
  checkout) behave exactly as they do on a product page. Nothing about
  checkout is reinvented here.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign product = s.product
  if product == blank
    assign product = collections.all.products.first
  endif
  assign variant = product.selected_or_first_available_variant
-%}

{% render 'buy-buttons-styles' %}

<div
  class="pantao-piece color-{{ s.color_scheme }} pantao-piece--{{ s.layout }}{% if s.enable_reveal %} pantao-piece--reveal{% endif %}"
  data-section-id="{{ section.id }}"
  {% if s.enable_reveal %}data-reveal-scene{% endif %}
>
  {%- comment -%}
    scene/stage wrappers are inert in the standard layout (plain full-width
    blocks). In reveal mode the scene provides the tall scroll track and the
    stage pins to the viewport so the piece can materialize as you scroll.
  {%- endcomment -%}
  <div class="pantao-piece__scene">
   <div class="pantao-piece__stage">
    <div class="pantao-piece__grid">

    {%- comment -%} ---------- Media ---------- {%- endcomment -%}
    <div class="pantao-piece__media" data-reveal>
      <div class="pantao-piece__frame">
        {%- if product.featured_media -%}
          {{
            product.featured_media
            | image_url: width: 1600
            | image_tag:
              loading: 'lazy',
              widths: '400, 600, 800, 1000, 1200, 1600',
              sizes: '(min-width: 750px) 50vw, 100vw',
              class: 'pantao-piece__img',
              alt: product.title | escape
          }}
          {%- if product.media[1] -%}
            {{
              product.media[1]
              | image_url: width: 1600
              | image_tag:
                loading: 'lazy',
                widths: '400, 600, 800, 1000, 1200, 1600',
                sizes: '(min-width: 750px) 50vw, 100vw',
                class: 'pantao-piece__img pantao-piece__img--alt',
                alt: product.title | escape
            }}
          {%- endif -%}
        {%- else -%}
          <div class="pantao-piece__placeholder">
            {{ 'product-1' | placeholder_svg_tag: 'pantao-piece__placeholder-svg' }}
          </div>
        {%- endif -%}
      </div>
    </div>

    {%- comment -%} ---------- Details + Story (right column) ---------- {%- endcomment -%}
    <div class="pantao-piece__col" data-reveal>

      <div class="pantao-piece__details">
        <div class="pantao-piece__inner">

          {%- if s.eyebrow != blank -%}
            <p class="pantao-piece__eyebrow">{{ s.eyebrow | escape }}</p>
          {%- endif -%}

          <h2 class="pantao-piece__name">{{ product.title | default: 'The Piece' }}</h2>

          <p class="pantao-piece__price">
            {%- if product.price_varies -%}
              <span class="pantao-piece__from">From</span> {{ product.price_min | money }}
            {%- else -%}
              {{ product.price | money }}
            {%- endif -%}
          </p>

          <div class="pantao-piece__buy">
            {%- comment -%} size / variant selection — theme's own block {%- endcomment -%}
            {% content_for 'block', type: 'variant-picker', id: 'piece-variant-picker', closest.product: product %}

            {%- comment -%} add-to-bag (opens cart drawer) + Buy Now — theme's own block {%- endcomment -%}
            {% content_for 'block', type: 'buy-buttons', id: 'piece-buy-buttons', closest.product: product %}
          </div>

          {%- if s.reassurance != blank -%}
            <p class="pantao-piece__reassurance">{{ s.reassurance | escape }}</p>
          {%- endif -%}

        </div>
      </div>

      {%- comment -%} ---------- Story: second card beneath the buy card ---------- {%- endcomment -%}
      {%- assign piece_story = s.story -%}
      {%- if piece_story == blank -%}
        {%- assign piece_story = product.description -%}
      {%- endif -%}
      {%- if piece_story != blank -%}
        <div class="pantao-piece__story-card">
          {%- if s.story_heading != blank -%}
            <p class="pantao-piece__story-heading">{{ s.story_heading | escape }}</p>
          {%- endif -%}
          <div class="pantao-piece__story rte">{{ piece_story }}</div>
        </div>
      {%- endif -%}

    </div>
    </div>
   </div>
  </div>

  {%- comment -%} Ambient sound cue — opt-in, off until the visitor enables it {%- endcomment -%}
  {%- if s.enable_reveal and s.enable_sound -%}
    <button type="button" class="pantao-reveal-sound" data-reveal-sound aria-pressed="false">
      <span class="pantao-reveal-sound__mark" aria-hidden="true">◈</span>
      <span class="pantao-reveal-sound__label" data-reveal-sound-label>Sound off</span>
    </button>
  {%- endif -%}
</div>

{% stylesheet %}
  .pantao-piece {
    background: var(--color-background);
    color: var(--color-foreground);
    padding: 5rem 1.5rem;
  }

  @media (min-width: 750px) {
    .pantao-piece { padding: 7rem 3rem; }
  }

  @media (min-width: 1200px) {
    .pantao-piece { padding: 8rem 5rem; }
  }

  .pantao-piece__grid {
    max-width: 82rem;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 750px) {
    .pantao-piece__grid {
      grid-template-columns: 1fr 1fr;
      gap: clamp(2.5rem, 6vw, 6rem);
    }
    .pantao-piece--media-right .pantao-piece__media { order: 2; }
  }

  /* ---------- Media ---------- */
  .pantao-piece__frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: var(--color-background-secondary, #ececec);
  }

  .pantao-piece__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 1.2s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.8s ease;
  }

  .pantao-piece__frame:hover .pantao-piece__img {
    transform: scale(1.04);
  }

  /* second image crossfades in on hover, if present */
  .pantao-piece__img--alt {
    opacity: 0;
  }

  .pantao-piece__frame:hover .pantao-piece__img--alt {
    opacity: 1;
  }

  .pantao-piece__placeholder,
  .pantao-piece__placeholder-svg,
  .pantao-piece__placeholder svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ---------- Details ---------- */
  .pantao-piece__inner {
    max-width: 30rem;
  }

  .pantao-piece__eyebrow {
    font-family: var(--font-body--family);
    font-size: var(--font-size--3xs);
    letter-spacing: 0.32em;
    text-transform: uppercase;
    margin: 0 0 1.4rem 0;
    opacity: 0.6;
  }

  .pantao-piece__name {
    font-family: var(--font-accent--family);
    font-style: var(--font-accent--style, normal);
    font-weight: var(--font-accent--weight, 500);
    font-size: clamp(2rem, 3.5vw + 0.5rem, 3.4rem);
    line-height: 1.05;
    margin: 0 0 0.75rem 0;
    text-wrap: balance;
  }

  .pantao-piece__price {
    font-family: var(--font-accent--family);
    font-size: clamp(1.25rem, 1.5vw + 0.5rem, 1.6rem);
    margin: 0 0 1.75rem 0;
    opacity: 0.9;
  }

  .pantao-piece__story {
    font-family: var(--font-body--family);
    font-size: var(--font-size--md);
    line-height: 1.7;
    opacity: 0.82;
    margin-bottom: 2rem;
  }

  .pantao-piece__story p { margin: 0 0 1em 0; }
  .pantao-piece__story p:last-child { margin-bottom: 0; }

  /* right column stacks the buy card and the story card */
  .pantao-piece__col {
    display: flex;
    flex-direction: column;
  }

  /* Story presented as its own card beneath the buy card. */
  .pantao-piece__story-card {
    margin-top: 1.75rem;
    padding: clamp(20px, 2.4vw, 30px);
    border: 1px solid var(--color-border);
    border-radius: 14px;
  }

  .pantao-piece__story-card .pantao-piece__story {
    margin-bottom: 0;
  }

  .pantao-piece__story-heading {
    font-family: var(--font-body--family);
    font-size: var(--font-size--3xs);
    letter-spacing: 0.24em;
    text-transform: uppercase;
    opacity: 0.6;
    margin: 0 0 0.9rem 0;
  }

  /* give the theme's variant + buy blocks room to breathe */
  .pantao-piece__buy {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-top: 0.5rem;
  }

  .pantao-piece__reassurance {
    font-family: var(--font-body--family);
    font-size: var(--font-size--3xs);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    opacity: 0.5;
    margin: 1.75rem 0 0 0;
  }

  /* ---------- Commerce controls: visible + rounded ---------- */
  .pantao-piece .add-to-cart-button {
    border-radius: 100px;
  }

  .pantao-piece .quantity-selector {
    border-radius: 100px;
    overflow: hidden;
  }

  /* the +/- buttons carry their own corner radii — round the outer ones */
  .pantao-piece .quantity-selector .quantity-minus {
    border-start-start-radius: 100px;
    border-end-start-radius: 100px;
  }

  .pantao-piece .quantity-selector .quantity-plus {
    border-start-end-radius: 100px;
    border-end-end-radius: 100px;
  }

  /* keep the sold-out / disabled button legible (never invisible) */
  .pantao-piece .add-to-cart-button:disabled,
  .pantao-piece .add-to-cart-button[disabled],
  .pantao-piece .add-to-cart-button[aria-disabled='true'] {
    opacity: 1;
    background: rgb(var(--color-foreground-rgb) / 0.12);
    color: var(--color-foreground);
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.22);
    cursor: not-allowed;
  }

  /* ---------- Reveal ---------- */
  .pantao-piece [data-reveal] {
    opacity: 0;
    transform: translateY(1.5rem);
    transition: opacity 0.9s cubic-bezier(0.22, 1, 0.36, 1), transform 0.9s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .pantao-piece [data-reveal].is-visible {
    opacity: 1;
    transform: none;
  }

  .pantao-piece__details[data-reveal] { transition-delay: 0.1s; }

  @media (prefers-reduced-motion: reduce) {
    .pantao-piece [data-reveal] { opacity: 1; transform: none; transition: none; }
    .pantao-piece__img { transition: none; }
  }

  /* ============================================================
     THE REVEAL — the piece materializes over the shared backdrop
     Active only when the controller adds `pantao-reveal-on` to
     <html> (desktop + motion allowed + hero reveal present). Every
     rule is scoped to that class, so the standard two-column layout
     is completely unaffected when the reveal is off.
     ============================================================ */

  html.pantao-reveal-on .pantao-piece--reveal {
    background: transparent;
    padding: 0;
  }

  /* Tall scroll track — gives the pinned stage room to play through. */
  html.pantao-reveal-on .pantao-piece--reveal .pantao-piece__scene {
    position: relative;
    min-height: 300vh;
  }

  /* Pinned viewport-filling stage. */
  html.pantao-reveal-on .pantao-piece--reveal .pantao-piece__stage {
    position: sticky;
    top: 0;
    height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  html.pantao-reveal-on .pantao-piece--reveal .pantao-piece__grid {
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 5rem);
    width: 100%;
    max-width: 1160px;
    padding: 0 clamp(20px, 5vw, 72px);
    align-items: stretch; /* image column matches the height of the buy + story stack */
  }

  /* Product image on the LEFT, glass card on the RIGHT — always, in the
     reveal, regardless of the section's media-side setting. */
  html.pantao-reveal-on .pantao-piece--reveal .pantao-piece__media { order: 1; }
  html.pantao-reveal-on .pantao-piece--reveal .pantao-piece__col { order: 2; }

  /* Neutralize the intersection-observer reveal — the scroll position
     drives visibility here, not viewport entry. */
  html.pantao-reveal-on .pantao-piece--reveal [data-reveal] {
    opacity: 1;
    transform: none;
    transition: none;
  }

  /* Media clips up into view as the piece is revealed. */
  html.pantao-reveal-on .pantao-piece--reveal .pantao-piece__media {
    --mp: clamp(0, calc((var(--reveal-sp, 0) - 0.12) / 0.3), 1);
    display: flex;
    height: 100%;
  }

  /* Fill the column height (level with the buy + story stack) instead of a
     fixed aspect ratio; the image covers, so it never distorts. */
  html.pantao-reveal-on .pantao-piece--reveal .pantao-piece__frame {
    aspect-ratio: auto;
    width: 100%;
    height: 100%;
    min-height: 0;
    border-radius: 14px;
    background: transparent;
    clip-path: inset(calc((1 - var(--mp, 1)) * 100%) 0 0 0);
    transform: scale(calc(0.96 + var(--mp, 0) * 0.04));
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.4);
  }

  /* Glass pricing card materializes a beat after the image. */
  html.pantao-reveal-on .pantao-piece--reveal .pantao-piece__details {
    --pp: clamp(0, calc((var(--reveal-sp, 0) - 0.34) / 0.24), 1);
    opacity: var(--pp);
    transform: translateY(calc((1 - var(--pp)) * 48px));
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.55), rgba(255, 255, 255, 0.14) 46%),
      rgba(245, 246, 245, 0.72);
    -webkit-backdrop-filter: blur(30px) saturate(180%);
    backdrop-filter: blur(30px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.6);
    border-radius: 22px;
    padding: clamp(24px, 3vw, 40px);
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.28), inset 0 1px 0 rgba(255, 255, 255, 0.6);
    color: var(--color-foreground);
  }

  html.pantao-reveal-on .pantao-piece--reveal .pantao-piece__inner {
    max-width: none;
  }

  /* Keep the buy card compact — reassurance stays out; the story gets its
     own card below (see .pantao-piece__story-card). */
  html.pantao-reveal-on .pantao-piece--reveal .pantao-piece__reassurance {
    display: none;
  }

  /* Story as a second glass card, materializing a beat after the buy card. */
  html.pantao-reveal-on .pantao-piece--reveal .pantao-piece__story-card {
    --sc: clamp(0, calc((var(--reveal-sp, 0) - 0.5) / 0.22), 1);
    opacity: var(--sc);
    transform: translateY(calc((1 - var(--sc)) * 40px));
    margin-top: clamp(14px, 1.6vw, 22px);
    padding: clamp(20px, 2.4vw, 30px);
    border: 1px solid rgba(255, 255, 255, 0.6);
    border-radius: 22px;
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.55), rgba(255, 255, 255, 0.14) 46%),
      rgba(245, 246, 245, 0.72);
    -webkit-backdrop-filter: blur(30px) saturate(180%);
    backdrop-filter: blur(30px) saturate(180%);
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.28), inset 0 1px 0 rgba(255, 255, 255, 0.6);
    color: var(--color-foreground);
  }

  /* ---------- Sound toggle ---------- */
  .pantao-reveal-sound { display: none; }

  html.pantao-reveal-on .pantao-reveal-sound {
    position: fixed;
    right: 20px;
    top: calc(var(--header-height, 64px) + 16px);
    z-index: var(--layer-raised, 2);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 255, 255, 0.14);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    backdrop-filter: blur(20px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 100px;
    padding: 8px 14px;
    color: #f4f5f5;
    cursor: pointer;
    font-family: var(--font-body--family);
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    mix-blend-mode: difference;
  }

  html.pantao-reveal-on .pantao-reveal-sound__mark { font-size: 12px; }

  @media (prefers-reduced-motion: reduce) {
    html.pantao-reveal-on .pantao-piece--reveal .pantao-piece__frame { transition: none; }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    function reveal(root) {
      if (!root || root.dataset.pieceReady === 'true') return;
      root.dataset.pieceReady = 'true';
      var items = root.querySelectorAll('[data-reveal]');
      if (!('IntersectionObserver' in window)) {
        items.forEach(function (el) { el.classList.add('is-visible'); });
        return;
      }
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (en) {
          if (en.isIntersecting) { en.target.classList.add('is-visible'); io.unobserve(en.target); }
        });
      }, { threshold: 0.15, rootMargin: '0px 0px -8% 0px' });
      items.forEach(function (el) { io.observe(el); });
    }
    function initAll() { document.querySelectorAll('.pantao-piece').forEach(reveal); }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAll);
    } else { initAll(); }
    document.addEventListener('shopify:section:load', initAll);
  })();

  /* ============================================================
     THE REVEAL — scroll controller
     Coordinates the (separate) hero and product sections into one
     scroll-driven hand-off. Sets three progress variables on <html>:
       --reveal-hero : 1 -> 0  headline fade as the hero leaves
       --reveal-sp   : 0 -> 1  product reveal progress
       --reveal-bd   : 0 -> 1  backdrop blur / darken ramp
     Only engages on desktop with motion allowed and when BOTH sections
     opt in. Anything else leaves the standard layouts fully intact.
     ============================================================ */
  (function () {
    var root = document.documentElement;
    var mqDesktop = window.matchMedia('(min-width: 750px)');
    var mqReduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    var clamp = function (v) { return Math.max(0, Math.min(1, v)); };

    var hero, scene, backdrop;
    var on = false, raf = false, lastSp = 0;
    var soundOn = false, actx = null;

    function findParts() {
      hero = document.querySelector('.arrival-hero[data-reveal-hero]');
      scene = document.querySelector('.pantao-piece[data-reveal-scene]');
      backdrop = document.querySelector('[data-reveal-backdrop]');
      return hero && scene;
    }

    function shouldRun() {
      return mqDesktop.matches && !mqReduce.matches && findParts();
    }

    function chime() {
      if (!soundOn || !actx) return;
      var t = actx.currentTime;
      [392.0, 587.33].forEach(function (f, i) {
        var o = actx.createOscillator(), g = actx.createGain();
        o.type = 'sine'; o.frequency.value = f;
        g.gain.setValueAtTime(0, t);
        g.gain.linearRampToValueAtTime(0.05, t + 0.6 + i * 0.1);
        g.gain.exponentialRampToValueAtTime(0.0001, t + 3.2);
        o.connect(g).connect(actx.destination);
        o.start(t); o.stop(t + 3.3);
      });
    }

    function update() {
      raf = false;
      if (!on) return;
      var y = window.scrollY || window.pageYOffset;
      var heroH = hero.offsetHeight;
      var sceneTop = scene.getBoundingClientRect().top + y;
      var sceneScroll = scene.offsetHeight - window.innerHeight;
      if (sceneScroll < 1) sceneScroll = 1;

      var heroVis = clamp(1 - y / (heroH * 0.6));
      var sp = clamp((y - sceneTop) / sceneScroll);
      var bd = clamp((y - heroH * 0.35) / (sceneTop - heroH * 0.35 + sceneScroll * 0.45));

      root.style.setProperty('--reveal-hero', heroVis.toFixed(4));
      root.style.setProperty('--reveal-sp', sp.toFixed(4));
      root.style.setProperty('--reveal-bd', bd.toFixed(4));

      if (backdrop) {
        backdrop.classList.toggle('is-past', y > sceneTop + sceneScroll + 2);
      }
      if (lastSp < 0.5 && sp >= 0.5) chime();
      lastSp = sp;
    }

    function onScroll() {
      if (!raf) { raf = true; requestAnimationFrame(update); }
    }

    function enable() {
      if (on) return;
      on = true;
      root.classList.add('pantao-reveal-on');
      update();
    }

    function disable() {
      if (!on) return;
      on = false;
      root.classList.remove('pantao-reveal-on');
      root.style.removeProperty('--reveal-hero');
      root.style.removeProperty('--reveal-sp');
      root.style.removeProperty('--reveal-bd');
      if (backdrop) backdrop.classList.remove('is-past');
    }

    function sync() {
      if (shouldRun()) { enable(); } else { disable(); }
    }

    function wireSound() {
      var btn = document.querySelector('[data-reveal-sound]');
      if (!btn || btn.dataset.wired === 'true') return;
      btn.dataset.wired = 'true';
      var label = btn.querySelector('[data-reveal-sound-label]');
      btn.addEventListener('click', function () {
        soundOn = !soundOn;
        btn.setAttribute('aria-pressed', soundOn ? 'true' : 'false');
        if (label) label.textContent = soundOn ? 'Sound on' : 'Sound off';
        if (soundOn && !actx) {
          try { actx = new (window.AudioContext || window.webkitAudioContext)(); } catch (e) { actx = null; }
        }
        if (soundOn && actx && actx.state === 'suspended') actx.resume();
      });
    }

    function boot() {
      wireSound();
      sync();
      if (on) onScroll();
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', function () { sync(); if (on) onScroll(); });
    if (mqDesktop.addEventListener) mqDesktop.addEventListener('change', sync);
    if (mqReduce.addEventListener) mqReduce.addEventListener('change', sync);
    document.addEventListener('shopify:section:load', boot);

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', boot);
    } else { boot(); }
  })();
{% endjavascript %}

{% schema %}
{
  "name": "The piece",
  "tag": "section",
  "class": "section-pantao-piece",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "info": "The single piece featured on the homepage. Leave blank to preview the first product in your catalog."
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Media side",
      "options": [
        { "value": "media-left",  "label": "Left" },
        { "value": "media-right", "label": "Right" }
      ],
      "default": "media-left"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The Piece · Edition V"
    },
    {
      "type": "text",
      "id": "story_heading",
      "label": "Story card heading",
      "info": "Small label at the top of the story card. Leave blank to hide it.",
      "default": "The Story"
    },
    {
