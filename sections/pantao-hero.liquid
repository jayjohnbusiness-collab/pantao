{%- comment -%}
  Pantao Hero banner
  --------------------------------------------------------
  A full-width, hero-height version of a Showcase card: full-bleed image/video
  with a small corner label, and the whole banner links to a collection/page.
  Same label settings as the Showcase cards (position, color, size, edge
  spacing); a Height control stands in for the card's tile shape.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
-%}

<div
  class="pantao-hero pantao-hero--{{ s.height }} pantao-hero--label-{{ s.label_color }}{% if s.link != blank %} pantao-hero--link{% endif %}"
  style="
    --ph-label-size: {{ s.label_size }}px;
    --ph-label-inset: {{ s.label_inset }}px;
  "
>
  {%- capture hero_inner -%}
    <div class="pantao-hero__media">
      {%- if s.media_type == 'video' and s.video != blank -%}
        {%- liquid
          assign poster = ''
          if s.video.preview_image != blank
            assign poster = s.video.preview_image | image_url: width: 2400
          endif
        -%}
        <video
          class="pantao-hero__video"
          muted
          playsinline
          autoplay
          loop
          preload="metadata"
          disablepictureinpicture
          {% if poster != blank %}poster="{{ poster }}"{% endif %}
          data-hero-video
        >
          {%- for source in s.video.sources -%}
            <source src="{{ source.url }}" type="{{ source.mime_type }}">
          {%- endfor -%}
        </video>
        {%- if poster != blank -%}
          <img class="pantao-hero__video-fallback" src="{{ poster }}" alt="{{ s.label | escape }}" loading="lazy" width="2400" height="1350">
        {%- endif -%}
      {%- elsif s.image != blank -%}
        {{
          s.image
          | image_url: width: 2400
          | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            class: 'pantao-hero__img',
            widths: '600, 900, 1200, 1600, 2000, 2400, 3000',
            sizes: '100vw',
            alt: s.label
        }}
      {%- else -%}
        <div class="pantao-hero__ph">
          {{ 'lifestyle-2' | placeholder_svg_tag: 'pantao-hero__ph-svg' }}
        </div>
      {%- endif -%}
    </div>

    {%- if s.label != blank -%}
      <span class="pantao-hero__label pantao-hero__label--{{ s.label_position }}">{{ s.label | escape }}</span>
    {%- endif -%}
  {%- endcapture -%}

  {%- if s.link != blank -%}
    <a
      class="pantao-hero__wrap pantao-hero__wrap--link"
      href="{{ s.link }}"
      {% if s.aria_label != blank %}aria-label="{{ s.aria_label | escape }}"{% elsif s.label != blank %}aria-label="{{ s.label | escape }}"{% endif %}
    >{{ hero_inner }}</a>
  {%- else -%}
    <div class="pantao-hero__wrap">{{ hero_inner }}</div>
  {%- endif -%}
</div>

{% stylesheet %}
  .pantao-hero {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: var(--color-background-secondary, #1a1a1a);
    isolation: isolate;
  }

  .pantao-hero--full    { height: 100svh; min-height: 600px; }
  .pantao-hero--large   { height: 78svh;  min-height: 520px; }
  .pantao-hero--medium  { height: 60svh;  min-height: 440px; }
  .pantao-hero--compact { height: 46svh;  min-height: 340px; }

  .pantao-hero__wrap {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }

  .pantao-hero__wrap--link { cursor: pointer; }

  /* ---------- Media ---------- */
  .pantao-hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }

  .pantao-hero__img,
  .pantao-hero__video,
  .pantao-hero__video-fallback,
  .pantao-hero__ph,
  .pantao-hero__ph-svg,
  .pantao-hero__ph svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .pantao-hero__video { z-index: 1; }

  @media (prefers-reduced-motion: reduce) {
    .pantao-hero__video { display: none; }
  }

  @media (hover: hover) {
    .pantao-hero--link .pantao-hero__img,
    .pantao-hero--link .pantao-hero__video,
    .pantao-hero--link .pantao-hero__video-fallback {
      transition: transform 1.1s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .pantao-hero--link:hover .pantao-hero__img,
    .pantao-hero--link:hover .pantao-hero__video,
    .pantao-hero--link:hover .pantao-hero__video-fallback {
      transform: scale(1.03);
    }
  }

  .pantao-hero__wrap--link:focus-visible {
    outline: 2px solid #f4f5f5;
    outline-offset: -4px;
  }

  /* ---------- Label (same system as Showcase cards) ---------- */
  .pantao-hero__label {
    position: absolute;
    z-index: 2;
    font-family: var(--font-body--family);
    font-size: var(--ph-label-size, 12px);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    line-height: 1;
    margin: 0;
    padding: 0;
    pointer-events: none;
  }

  .pantao-hero--label-light .pantao-hero__label {
    color: #f4f5f5;
    text-shadow: 0 1px 14px rgba(0, 0, 0, 0.45);
  }

  .pantao-hero--label-dark .pantao-hero__label {
    color: #141414;
  }

  .pantao-hero__label--top-left     { top: var(--ph-label-inset, 12px); left: var(--ph-label-inset, 12px); }
  .pantao-hero__label--top-right    { top: var(--ph-label-inset, 12px); right: var(--ph-label-inset, 12px); }
  .pantao-hero__label--bottom-left  { bottom: var(--ph-label-inset, 12px); left: var(--ph-label-inset, 12px); }
  .pantao-hero__label--bottom-right { bottom: var(--ph-label-inset, 12px); right: var(--ph-label-inset, 12px); }
{% endstylesheet %}

{% javascript %}
  (function () {
    function reduced() {
      return window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    }
    function nudge(v) {
      if (!v || reduced()) return;
      v.muted = true; v.playsInline = true;
      var play = function () { var p = v.play(); if (p && p.catch) p.catch(function(){}); };
      if (v.readyState >= 2) play();
      else {
        v.addEventListener('loadeddata', play, { once: true });
        v.addEventListener('canplay', play, { once: true });
      }
    }
    function initAll() { document.querySelectorAll('[data-hero-video]').forEach(nudge); }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initAll);
    else initAll();
    document.addEventListener('shopify:section:load', initAll);
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Hero banner",
  "tag": "section",
  "class": "section-pantao-hero",
  "settings": [
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "select",
      "id": "media_type",
      "label": "Media type",
      "options": [
        { "value": "image", "label": "Image" },
        { "value": "video", "label": "Video" }
      ],
      "default": "image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "visible_if": "{{ section.settings.media_type == 'image' }}"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video",
      "info": "MP4, looped & muted. A poster/preview frame is the still fallback.",
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "info": "Small category/collection label shown on the banner.",
      "default": "FW26 SHOW COLLECTION"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link",
      "info": "The whole banner (media + label) links here."
    },
    {
      "type": "text",
      "id": "aria_label",
      "label": "Accessible link text",
      "info": "Optional. Falls back to the label."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        { "value": "full",    "label": "Full viewport" },
        { "value": "large",   "label": "Large" },
        { "value": "medium",  "label": "Medium" },
        { "value": "compact", "label": "Compact" }
      ],
      "default": "large"
    },
    {
      "type": "header",
      "content": "Label"
    },
    {
      "type": "select",
      "id": "label_position",
      "label": "Label position",
      "options": [
        { "value": "top-left",     "label": "Top left" },
        { "value": "top-right",    "label": "Top right" },
        { "value": "bottom-left",  "label": "Bottom left" },
        { "value": "bottom-right", "label": "Bottom right" }
      ],
      "default": "top-left"
    },
    {
      "type": "select",
      "id": "label_color",
      "label": "Label color",
      "options": [
        { "value": "light", "label": "Light (for dark images)" },
        { "value": "dark",  "label": "Dark (for light images)" }
      ],
      "default": "light"
    },
    {
      "type": "range",
      "id": "label_size",
      "label": "Label size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "label_inset",
      "label": "Label edge spacing",
      "info": "Distance from the banner corner. Lower = more flush.",
      "min": 4,
      "max": 48,
      "step": 2,
      "default": 12,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Hero banner"
    }
  ]
}
{% endschema %}
