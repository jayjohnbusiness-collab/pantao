{%- comment -%}
  Pantao Password Antechamber
  --------------------------------------------------------
  An editorial split-layout password page: one quiet image on one side,
  sparse typographic content on the other, with an application-style
  email capture that assigns the visitor a "member number" on success.

  The member number is held in localStorage so a returning visitor
  sees the same number they were issued. The starting offset is
  theme-editor configurable so merchants can bump the registry forward
  to reflect real signup counts.

  Email capture uses Shopify's standard {% form 'customer' %} so
  signups land in Shopify Customers and sync to Klaviyo automatically.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign edition = s.edition_label | default: 'EDITION V'
  assign year = s.year_roman | default: 'MMXXVI'
  assign accepted = false
  if customer.posted?
    assign accepted = true
  endif

  # Resolve which media + chrome settings to use based on state.
  # On the post-submit ("received") state, fall back to the application
  # settings when a received-state setting is blank, so merchants can
  # leave the received settings empty to inherit from the application.

  if accepted
    assign active_media_type = s.received_media_type | default: s.media_type
    assign active_image = s.received_image
    if active_image == blank
      assign active_image = s.image
    endif
    assign active_video = s.received_video
    if active_video == blank
      assign active_video = s.video
    endif
    assign active_image_fit = s.received_image_position_fit | default: s.image_position_fit
    assign active_video_fit = s.received_video_position | default: s.video_position
    assign active_caption = s.received_image_caption
    assign active_show_wordmark = s.received_show_wordmark
  else
    assign active_media_type = s.media_type
    assign active_image = s.image
    assign active_video = s.video
    assign active_image_fit = s.image_position_fit
    assign active_video_fit = s.video_position
    assign active_caption = s.image_caption
    assign active_show_wordmark = s.show_wordmark
  endif
-%}

<div
  class="antechamber color-{{ s.color_scheme }}"
  data-section-id="{{ section.id }}"
  data-start-number="{{ s.start_number }}"
  data-edition-prefix="{{ edition | escape }}"
  data-accepted="{% if accepted %}true{% else %}false{% endif %}"
>
  <div class="antechamber__grid antechamber__grid--{{ s.image_position }}">

    {%- comment -%} ----- Media side (image or video) ----- {%- endcomment -%}
    <div class="antechamber__media antechamber__media--{{ active_media_type }}">
      {%- if active_media_type == 'video' and active_video != blank -%}
        {%- liquid
          assign poster_url = ''
          if active_video.preview_image != blank
            assign poster_url = active_video.preview_image | image_url: width: 1800
          endif
        -%}
        <video
          class="antechamber__video antechamber__video--{{ active_video_fit }}"
          muted
          playsinline
          autoplay
          loop
          preload="metadata"
          disablepictureinpicture
          disableremoteplayback
          {% if poster_url != blank %}poster="{{ poster_url }}"{% endif %}
          data-antechamber-video
        >
          {%- for source in active_video.sources -%}
            <source src="{{ source.url }}" type="{{ source.mime_type }}">
          {%- endfor -%}
        </video>
      {%- elsif active_media_type == 'image' and active_image != blank -%}
        {%- comment -%}
          Use the theme's shipped background-media snippet so the image
          inherits the theme's proven .background-image-container CSS.
          That CSS handles position: absolute, inset: 0, object-fit: cover,
          and width/height: 100% — all the things we'd otherwise have to
          fight base.css for.
        {%- endcomment -%}
        {% render 'background-media',
          background_media: 'image',
          background_image: active_image,
          background_image_position: active_image_fit,
          placeholder: 'lifestyle-1',
          section: section
        %}
      {%- elsif active_media_type == 'none' -%}
        {%- comment -%} Intentionally empty — merchant chose "None" {%- endcomment -%}
      {%- else -%}
        <div class="antechamber__placeholder">
          {{ 'lifestyle-1' | placeholder_svg_tag: 'antechamber__placeholder-svg' }}
        </div>
      {%- endif -%}

      {%- if active_caption != blank -%}
        <p class="antechamber__caption">{{ active_caption | escape }}</p>
      {%- endif -%}
    </div>

    {%- comment -%} ----- Content side ----- {%- endcomment -%}
    <div class="antechamber__content">
      <div class="antechamber__inner">

        {%- if active_show_wordmark or s.show_meta -%}
          <header class="antechamber__masthead">
            {%- if active_show_wordmark -%}
              {%- if shop.brand.logo -%}
                <img
                  src="{{ shop.brand.logo | image_url: width: 600 }}"
                  alt="{{ shop.name }}"
                  class="antechamber__wordmark-img"
                  width="{{ s.wordmark_width }}"
                  loading="eager"
                >
              {%- else -%}
                <p class="antechamber__wordmark">{{ shop.name }}</p>
              {%- endif -%}
            {%- endif -%}

            {%- if s.show_meta -%}
              <p class="antechamber__meta">
                <span>{{ edition }}</span>
                <span class="antechamber__meta-divider">·</span>
                <span>{{ year }}</span>
              </p>
            {%- endif -%}
          </header>
        {%- endif -%}

        {%- comment -%} ----- Default state: invitation copy + form ----- {%- endcomment -%}
        <div class="antechamber__state antechamber__state--invitation"{% if accepted %} hidden{% endif %}>
          {%- if s.heading != blank -%}
            <h1 class="antechamber__heading">{{ s.heading }}</h1>
          {%- endif -%}

          {%- if s.body != blank -%}
            <div class="antechamber__body rte">{{ s.body }}</div>
          {%- endif -%}

          {%- form 'customer', class: 'antechamber__form', id: 'AntechamberForm' -%}
            <input type="hidden" name="contact[tags]" value="prospect, password-page, {{ edition | downcase | replace: ' ', '-' }}">
            <input type="hidden" name="contact[accepts_marketing]" value="true">

            <div class="antechamber__field">
              <label for="AntechamberEmail" class="antechamber__label">
                {{ s.field_label | default: 'Your name and email' }}
              </label>

              {%- if s.collect_name -%}
                <input
                  type="text"
                  name="contact[first_name]"
                  id="AntechamberFirstName"
                  class="antechamber__input"
                  placeholder="{{ s.placeholder_name | default: 'Name' }}"
                  autocomplete="given-name"
                  required
                >
              {%- endif -%}

              <input
                type="email"
                name="contact[email]"
                id="AntechamberEmail"
                class="antechamber__input"
                placeholder="{{ s.placeholder_email | default: 'Email address' }}"
                autocomplete="email"
                spellcheck="false"
                required
              >

              {%- if s.collect_referral -%}
                <input
                  type="text"
                  name="contact[note]"
                  id="AntechamberReferral"
                  class="antechamber__input"
                  placeholder="{{ s.placeholder_referral | default: 'Referral or passphrase (optional)' }}"
                  autocomplete="off"
                >
              {%- endif -%}
            </div>

            <button type="submit" class="antechamber__submit">
              <span>{{ s.button_label | default: 'Request entry' }}</span>
              <span class="antechamber__submit-arrow" aria-hidden="true">&rarr;</span>
            </button>

            {%- if s.fine_print != blank -%}
              <p class="antechamber__fine-print">{{ s.fine_print }}</p>
            {%- endif -%}

            {%- if form.errors -%}
              <p class="antechamber__error" role="alert">
                {%- for field in form.errors -%}
                  {{ form.errors.translated_fields[field] }} {{ form.errors.messages[field] }}{% unless forloop.last %}. {% endunless %}
                {%- endfor -%}
              </p>
            {%- endif -%}
          {%- endform -%}
        </div>

        {%- comment -%} ----- Accepted state: the "letter" ----- {%- endcomment -%}
        <div class="antechamber__state antechamber__state--accepted"{% unless accepted %} hidden{% endunless %}>
          <p class="antechamber__seal">
            {%- if s.seal_text != blank -%}{{ s.seal_text }}{%- else -%}— Application received —{%- endif -%}
          </p>

          {%- if s.accepted_heading != blank -%}
            <h2 class="antechamber__accepted-heading">{{ s.accepted_heading }}</h2>
          {%- endif -%}

          {%- if s.accepted_body != blank -%}
            <div class="antechamber__letter rte">{{ s.accepted_body }}</div>
          {%- endif -%}

          <p class="antechamber__member-line">
            <span class="antechamber__member-label">{{ s.member_label | default: 'Application' }}</span>
            <span class="antechamber__member-number" data-member-number>0000</span>
            <span class="antechamber__member-divider">/</span>
            <span class="antechamber__member-edition">{{ edition }}</span>
          </p>

          {%- if s.signature != blank -%}
            <p class="antechamber__signature">{{ s.signature }}</p>
          {%- endif -%}
        </div>

      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .antechamber {
    min-height: 100svh;
    width: 100%;
    background: var(--color-background);
    color: var(--color-foreground);
    display: flex;
  }

  .antechamber__grid {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-rows: 50svh auto;
    width: 100%;
    min-height: 100svh;
  }

  @media (min-width: 990px) {
    .antechamber__grid {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: 1fr;
    }

    .antechamber__grid--right .antechamber__media {
      order: 2;
    }
  }

  /* ---------- Media side ---------- */
  .antechamber__media {
    position: relative;
    overflow: hidden;
    /* Neutral fallback while media loads. We avoid using
       --color-foreground here because on dark schemes that
       would be a black mask covering the image during paint. */
    background: var(--color-background-secondary, #1a1a1a);
  }

  /* The image case is rendered via the theme's `background-media` snippet,
     which uses .background-image-container with its own positioning rules
     in base.css. We don't override those.

     The video and placeholder cases need our own positioning. */
  .antechamber__video,
  .antechamber__placeholder,
  .antechamber__placeholder-svg,
  .antechamber__placeholder svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* "Contain" override for video */
  .antechamber__video--contain {
    object-fit: contain;
  }

  /* Hide the video entirely for visitors who prefer reduced motion.
     The poster image still renders if present, providing a stable still. */
  @media (prefers-reduced-motion: reduce) {
    .antechamber__video {
      display: none;
    }
  }

  .antechamber__caption {
    position: absolute;
    bottom: 1.25rem;
    left: 1.25rem;
    right: 1.25rem;
    color: var(--color-background);
    font-family: var(--font-body--family);
    font-size: var(--font-size--2xs);
    text-transform: uppercase;
    letter-spacing: 0.18em;
    opacity: 0.7;
    margin: 0;
    pointer-events: none;
  }

  /* ---------- Content side ---------- */
  .antechamber__content {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 3rem 1.5rem;
  }

  @media (min-width: 750px) {
    .antechamber__content {
      padding: 4rem 3rem;
    }
  }

  @media (min-width: 1200px) {
    .antechamber__content {
      padding: 5rem 5rem;
    }
  }

  .antechamber__inner {
    width: 100%;
    max-width: 28rem;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  /* ---------- Masthead ---------- */
  .antechamber__masthead {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }

  .antechamber__wordmark {
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: var(--font-size--lg);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    margin: 0;
  }

  .antechamber__wordmark-img {
    display: block;
    height: auto;
    max-width: 100%;
  }

  .antechamber__meta {
    font-family: var(--font-body--family);
    font-size: var(--font-size--3xs);
    letter-spacing: 0.32em;
    text-transform: uppercase;
    margin: 0;
    opacity: 0.7;
    display: flex;
    gap: 0.5em;
    align-items: center;
  }

  .antechamber__meta-divider {
    opacity: 0.4;
  }

  /* ---------- Invitation state ---------- */
  .antechamber__heading {
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: clamp(1.75rem, 3vw + 0.5rem, 2.75rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
    margin: 0 0 1.5rem 0;
    text-wrap: balance;
  }

  .antechamber__body {
    font-family: var(--font-body--family);
    font-size: var(--font-size--md);
    line-height: 1.55;
    margin-bottom: 2.25rem;
    opacity: 0.85;
  }

  .antechamber__body p {
    margin: 0 0 1em 0;
  }

  .antechamber__body p:last-child {
    margin-bottom: 0;
  }

  /* ---------- Form ---------- */
  .antechamber__form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin: 0;
  }

  .antechamber__label {
    font-family: var(--font-body--family);
    font-size: var(--font-size--3xs);
    letter-spacing: 0.28em;
    text-transform: uppercase;
    opacity: 0.7;
    display: block;
    margin-bottom: 0.5rem;
  }

  .antechamber__field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .antechamber__input {
    width: 100%;
    background: transparent;
    border: 0;
    border-bottom: 1px solid currentColor;
    border-radius: 0;
    padding: 0.75rem 0;
    font-family: var(--font-body--family);
    font-size: var(--font-size--md);
    color: var(--color-foreground);
    outline: none;
    transition: border-color 0.2s ease;
  }

  .antechamber__input::placeholder {
    color: var(--color-foreground);
    opacity: 0.4;
  }

  .antechamber__input:focus {
    border-bottom-width: 2px;
    padding-bottom: calc(0.75rem - 1px);
  }

  .antechamber__submit {
    appearance: none;
    background: transparent;
    border: 0;
    padding: 0.5rem 0;
    margin-top: 0.5rem;
    cursor: pointer;
    color: var(--color-foreground);
    font-family: var(--font-body--family);
    font-size: var(--font-size--xs);
    letter-spacing: 0.28em;
    text-transform: uppercase;
    display: inline-flex;
    align-items: center;
    gap: 0.75em;
    align-self: flex-start;
    transition: gap 0.25s ease, opacity 0.2s ease;
  }

  .antechamber__submit:hover {
    gap: 1.25em;
  }

  .antechamber__submit-arrow {
    transition: transform 0.25s ease;
    font-size: 1.1em;
  }

  .antechamber__submit:hover .antechamber__submit-arrow {
    transform: translateX(4px);
  }

  .antechamber__fine-print {
    font-family: var(--font-body--family);
    font-size: var(--font-size--3xs);
    letter-spacing: 0.05em;
    line-height: 1.5;
    margin: 0.75rem 0 0 0;
    opacity: 0.5;
  }

  .antechamber__error {
    color: var(--color-error, #8B0000);
    font-family: var(--font-body--family);
    font-size: var(--font-size--xs);
    margin: 0.5rem 0 0 0;
  }

  /* ---------- State container & transitions ---------- */
  .antechamber__state {
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  .antechamber__state[hidden] {
    display: none !important;
  }

  /* When transitioning out, we don't use [hidden] (which kills animation);
     instead a class lets the state fade and shrink before being removed. */
  .antechamber__state.is-leaving {
    opacity: 0;
    transform: translateY(-6px);
    pointer-events: none;
  }

  .antechamber__state.is-entering {
    opacity: 0;
    transform: translateY(8px);
  }

  .antechamber__state.is-entered {
    opacity: 1;
    transform: translateY(0);
  }

  /* Submit button busy state */
  .antechamber__submit[aria-busy='true'] {
    opacity: 0.5;
    pointer-events: none;
  }

  .antechamber__submit[aria-busy='true'] .antechamber__submit-arrow {
    animation: antechamber-pulse 1.2s ease-in-out infinite;
  }

  @keyframes antechamber-pulse {
    0%, 100% { opacity: 1; transform: translateX(0); }
    50% { opacity: 0.3; transform: translateX(2px); }
  }
  .antechamber__state--accepted {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .antechamber__seal {
    font-family: var(--font-body--family);
    font-size: var(--font-size--3xs);
    letter-spacing: 0.4em;
    text-transform: uppercase;
    margin: 0;
    opacity: 0.6;
  }

  .antechamber__accepted-heading {
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: clamp(1.5rem, 2.5vw + 0.5rem, 2.25rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
    margin: 0;
    text-wrap: balance;
  }

  .antechamber__letter {
    font-family: var(--font-body--family);
    font-size: var(--font-size--md);
    line-height: 1.7;
    opacity: 0.85;
  }

  .antechamber__letter p {
    margin: 0 0 1em 0;
  }

  .antechamber__letter p:last-child {
    margin-bottom: 0;
  }

  .antechamber__member-line {
    border-top: 1px solid currentColor;
    border-bottom: 1px solid currentColor;
    padding: 1rem 0;
    margin: 0.5rem 0 0 0;
    font-family: var(--font-body--family);
    font-size: var(--font-size--xs);
    letter-spacing: 0.28em;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    gap: 0.6em;
  }

  .antechamber__member-label {
    opacity: 0.6;
  }

  .antechamber__member-number {
    font-feature-settings: 'tnum';
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.18em;
    font-weight: 500;
  }

  .antechamber__member-divider {
    opacity: 0.3;
  }

  .antechamber__member-edition {
    opacity: 0.6;
  }

  .antechamber__signature {
    font-family: var(--font-heading--family);
    font-style: italic;
    font-size: var(--font-size--md);
    margin: 0.5rem 0 0 0;
    opacity: 0.75;
  }

  @media (prefers-reduced-motion: reduce) {
    .antechamber__state,
    .antechamber__submit,
    .antechamber__submit-arrow {
      transition: none !important;
      animation: none !important;
    }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    const KEY_NUM = 'pantao:member:number';
    const KEY_EDITION = 'pantao:member:edition';
    const KEY_POSTED = 'pantao:member:posted';
    const NUMBER_REVEAL_DELAY_MS = 400;
    const NUMBER_REVEAL_DURATION_MS = 900;

    function pad(n, width) {
      const s = String(n);
      return s.length >= width ? s : '0'.repeat(width - s.length) + s;
    }

    function prefersReducedMotion() {
      return window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    }

    // Encourage a hero <video> to actually autoplay. Browsers require the
    // video to be muted to autoplay without a user gesture, but they still
    // sometimes refuse to start, especially on iOS Safari and in background
    // tabs. We set the muted *property* (not just the attribute) and call
    // play() explicitly, then retry when the tab becomes visible.
    function nudgeVideoPlayback(video) {
      if (!video) return;

      // Bail out for visitors who prefer reduced motion — CSS hides the
      // element, but we shouldn't waste bandwidth either.
      if (prefersReducedMotion()) return;

      // Setting the property is what actually convinces some browsers.
      video.muted = true;
      video.defaultMuted = true;
      video.playsInline = true;

      function tryPlay() {
        const promise = video.play();
        if (promise && typeof promise.catch === 'function') {
          promise.catch(function () {
            // Autoplay was blocked. We'll retry on visibility change /
            // first interaction below. No console noise.
          });
        }
      }

      // Try right away.
      if (video.readyState >= 2) {
        tryPlay();
      } else {
        video.addEventListener('loadeddata', tryPlay, { once: true });
        // Some Safari versions need this fallback event.
        video.addEventListener('canplay', tryPlay, { once: true });
      }

      // Retry when the tab becomes visible (handles "opened in background").
      document.addEventListener('visibilitychange', function () {
        if (!document.hidden && video.paused) tryPlay();
      });

      // Retry on the first user interaction with the page, as a last resort.
      // Browsers ALWAYS allow muted playback after a user gesture.
      const onInteract = function () {
        if (video.paused) tryPlay();
        window.removeEventListener('pointerdown', onInteract);
        window.removeEventListener('keydown', onInteract);
        window.removeEventListener('scroll', onInteract);
      };
      window.addEventListener('pointerdown', onInteract, { passive: true });
      window.addEventListener('keydown', onInteract);
      window.addEventListener('scroll', onInteract, { passive: true });
    }

    function init(root) {
      if (!root || root.dataset.antechamberReady === 'true') return;
      root.dataset.antechamberReady = 'true';

      const startNumber = parseInt(root.dataset.startNumber, 10) || 0;
      const edition = root.dataset.editionPrefix || '';
      const accepted = root.dataset.accepted === 'true';

      const numberEl = root.querySelector('[data-member-number]');
      const invitationState = root.querySelector('.antechamber__state--invitation');
      const acceptedState = root.querySelector('.antechamber__state--accepted');
      const form = root.querySelector('.antechamber__form');
      const submitBtn = form ? form.querySelector('.antechamber__submit') : null;
      const video = root.querySelector('[data-antechamber-video]');

      // Coax the hero video into autoplaying — runs before any other
      // init logic so the visual lands as quickly as possible.
      nudgeVideoPlayback(video);

      function getOrAssignNumber() {
        let stored = localStorage.getItem(KEY_NUM);
        const storedEdition = localStorage.getItem(KEY_EDITION);

        // If edition has changed (new drop year), re-issue a number.
        if (storedEdition !== edition) stored = null;

        let n = stored ? parseInt(stored, 10) : NaN;
        if (!Number.isFinite(n)) {
          const jitter = Math.floor(Math.random() * 7) + 1;
          n = startNumber + jitter;
          try {
            localStorage.setItem(KEY_NUM, String(n));
            localStorage.setItem(KEY_EDITION, edition);
          } catch (e) { /* storage blocked */ }
        }
        return n;
      }

      function setNumberStatic() {
        if (!numberEl) return;
        numberEl.textContent = pad(getOrAssignNumber(), 4);
      }

      function animateNumber(targetN) {
        if (!numberEl) return;
        if (prefersReducedMotion()) {
          numberEl.textContent = pad(targetN, 4);
          return;
        }
        const start = performance.now();
        function frame(now) {
          const t = Math.min(1, (now - start) / NUMBER_REVEAL_DURATION_MS);
          // Ease-out cubic
          const eased = 1 - Math.pow(1 - t, 3);
          const current = Math.floor(eased * targetN);
          numberEl.textContent = pad(current, 4);
          if (t < 1) requestAnimationFrame(frame);
          else numberEl.textContent = pad(targetN, 4);
        }
        requestAnimationFrame(frame);
      }

      // Show the accepted state instantly (no animation) — used for
      // returning visitors who already saw the ceremony in a previous session.
      function revealAcceptedInstant() {
        if (!acceptedState) return;
        if (invitationState) invitationState.hidden = true;
        acceptedState.hidden = false;
        setNumberStatic();
      }

      // Validate required fields (HTML5 already does it, but we want to
      // surface errors before kicking off the fetch).
      function validate() {
        if (!form) return false;
        if (typeof form.reportValidity === 'function') {
          return form.reportValidity();
        }
        return true;
      }

      function setBusy(isBusy) {
        if (!submitBtn) return;
        submitBtn.setAttribute('aria-busy', isBusy ? 'true' : 'false');
        submitBtn.disabled = !!isBusy;
      }

      // ---- Page-load behavior ----

      // 1) Server-rendered acceptance (Shopify reloaded with customer.posted?).
      //    This happens for the no-JS path. Show accepted state with a gentle
      //    reveal so it doesn't feel like a hard reload.
      if (accepted) {
        if (invitationState) invitationState.hidden = true;
        if (acceptedState) {
          acceptedState.hidden = false;
          acceptedState.classList.add('is-entering');
          void acceptedState.offsetWidth;
          requestAnimationFrame(function () {
            acceptedState.classList.remove('is-entering');
            acceptedState.classList.add('is-entered');
          });
          setTimeout(function () {
            animateNumber(getOrAssignNumber());
          }, NUMBER_REVEAL_DELAY_MS);
        }
        try {
          localStorage.setItem(KEY_POSTED, 'true');
          localStorage.setItem(KEY_EDITION, edition);
        } catch (e) { /* ignore */ }
        return;
      }

      // 2) Returning visitor who signed up in a previous session — show
      //    accepted state immediately (no animation, they've seen this).
      const seenBefore = localStorage.getItem(KEY_POSTED) === 'true';
      const sameEdition = localStorage.getItem(KEY_EDITION) === edition;
      if (seenBefore && sameEdition) {
        revealAcceptedInstant();
        return;
      }

      // 3) New visitor — wire up the form for an animated handoff to the reload.
      //
      //    Implementation note: we deliberately use a NATIVE form submit here
      //    (not fetch). Shopify's spam protection on the customer endpoint
      //    is friendlier to real form submits — AJAX POSTs to /contact can
      //    trigger a human-verification challenge that doesn't render inside
      //    a fetch response. The page reloads with customer.posted? = true,
      //    and the accepted-state branch above (case #1) handles the
      //    entrance animation and number reveal.
      //
      //    The JS-enhanced polish here is only the LEAVE animation: we fade
      //    the invitation state out so the visitor sees a deliberate
      //    departure rather than a hard form post.
      if (form) {
        form.addEventListener('submit', function (e) {
          if (!validate()) {
            e.preventDefault();
            return;
          }

          // Lock in the number now so it's stable across the redirect.
          try {
            localStorage.setItem(KEY_EDITION, edition);
            localStorage.setItem(KEY_POSTED, 'true');
            getOrAssignNumber();
          } catch (err) { /* ignore */ }

          setBusy(true);

          // If reduced motion is preferred, just let the form submit
          // normally — no point staging a transition.
          if (prefersReducedMotion()) return;

          // Otherwise, fade the invitation out before letting the navigation
          // happen. We don't preventDefault — we just delay the visual.
          // The browser will navigate when the form's submission completes;
          // the fade just runs concurrently with the request flight time,
          // which on a fast connection is roughly the same window we need.
          if (invitationState) invitationState.classList.add('is-leaving');
        });
      }
    }

    function initAll() {
      document.querySelectorAll('.antechamber').forEach(init);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAll);
    } else {
      initAll();
    }

    document.addEventListener('shopify:section:load', initAll);
  })();
{% endjavascript %}

