    },
    {
      "type": "richtext",
      "id": "accepted_body",
      "label": "Letter body",
      "default": "<p>Each application is read by hand. If you are admitted, you will receive correspondence at your address within forty-eight hours, with a note on what follows.</p><p>If you do not hear from us in that time, the doors are closed for this edition. We hold your name and may write again.</p>"
    },
    {
      "type": "text",
      "id": "member_label",
      "label": "Reference label",
      "info": "Shown before the assigned number, e.g. \"Application 0247\"",
      "default": "Application"
    },
    {
      "type": "text",
      "id": "signature",
      "label": "Signature",
      "default": "— Pantao"
    },

    {
      "type": "header",
      "content": "Member numbering"
    },
    {
      "type": "number",
      "id": "start_number",
      "label": "Starting number",
      "default": 240,
      "info": "The next assigned member number will be approximately this value plus a small jitter. Bump this up periodically to reflect real signup counts."
    },

    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Password — Antechamber"
    }
  ],
  "enabled_on": {
    "templates": ["password"]
  }
}
{% endschema %}
