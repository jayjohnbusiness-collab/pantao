{
  "name": "Password — Antechamber",
  "tag": "section",
  "class": "section-password section-antechamber",
  "settings": [
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "select",
      "id": "media_type",
      "label": "Media type",
      "options": [
        { "value": "image", "label": "Image" },
        { "value": "video", "label": "Video" },
        { "value": "none",  "label": "None (placeholder)" }
      ],
      "default": "image",
      "info": "Video loops, plays muted, and is hidden for visitors with reduced-motion preferences."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image",
      "visible_if": "{{ section.settings.media_type == 'image' }}"
    },
    {
      "type": "select",
      "id": "image_position_fit",
      "label": "Image fit",
      "options": [
        { "value": "cover", "label": "Cover" },
        { "value": "fit",   "label": "Contain" }
      ],
      "default": "cover",
      "visible_if": "{{ section.settings.media_type == 'image' }}"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Hero video",
      "info": "Use a short, quiet loop. MP4 ≤ 10 seconds works best.",
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "select",
      "id": "video_position",
      "label": "Video fit",
      "options": [
        { "value": "cover",   "label": "Cover" },
        { "value": "contain", "label": "Contain" }
      ],
      "default": "cover",
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Media side",
      "options": [
        { "value": "left",  "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "image_caption",
      "label": "Media caption",
      "info": "Small caption overlaid on the image or video. Optional."
    },

    {
      "type": "header",
      "content": "Masthead"
    },
    {
      "type": "checkbox",
      "id": "show_wordmark",
      "label": "Show wordmark / logo",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_meta",
      "label": "Show edition + year line",
      "default": true
    },
    {
      "type": "range",
      "id": "wordmark_width",
      "label": "Logo width",
      "min": 80,
      "max": 320,
      "step": 10,
      "unit": "px",
      "default": 160
    },
    {
      "type": "text",
      "id": "edition_label",
      "label": "Edition label",
      "default": "EDITION V"
    },
    {
      "type": "text",
      "id": "year_roman",
      "label": "Year (or roman numeral)",
      "default": "MMXXVI"
    },

    {
      "type": "header",
      "content": "Invitation copy"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
