      "settings": {
        "custom_liquid": "{%- comment -%}\n  PANTAO minimal footer — Custom Liquid paste\n  ------------------------------------------------------------------\n  Paste this whole block into a \"Custom Liquid\" section in the theme editor\n  (Footer group). It is self-contained: no {% render %}, no {% form %} tag,\n  no theme snippets — so it works inside Custom Liquid and does NOT depend\n  on GitHub sync. Links use your real menus/policies; the little script\n  flattens the host section so the footer stays slim and on paper.\n{%- endcomment -%}\n\n{%- liquid\n  assign fmenu = linklists.footer\n  assign use_combined = false\n  if fmenu == blank or fmenu.links.size == 0\n    assign use_combined = true\n  endif\n  assign col1 = linklists['client-care']\n  assign col2 = linklists['legal']\n  assign col3 = linklists['social']\n  assign has_cols = false\n  if col1.links.size > 0 or col2.links.size > 0 or col3.links.size > 0\n    assign has_cols = true\n  endif\n  assign year = 'now' | date: '%Y'\n-%}\n\n<div class=\"pmf\">\n  <div class=\"pmf__wrap\">\n    <nav class=\"pmf__links\" aria-label=\"Footer\">\n      {%- if use_combined -%}\n        {%- if has_cols -%}\n          {%- for link in col1.links -%}<a href=\"{{ link.url }}\">{{ link.title | escape }}</a>{%- endfor -%}\n          {%- for link in col2.links -%}<a href=\"{{ link.url }}\">{{ link.title | escape }}</a>{%- endfor -%}\n          {%- for link in col3.links -%}<a href=\"{{ link.url }}\">{{ link.title | escape }}</a>{%- endfor -%}\n        {%- else -%}\n          {%- for policy in shop.policies -%}\n            {%- if policy != blank -%}<a href=\"{{ policy.url }}\">{{ policy.title | escape }}</a>{%- endif -%}\n          {%- endfor -%}\n        {%- endif -%}\n      {%- else -%}\n        {%- for link in fmenu.links -%}<a href=\"{{ link.url }}\">{{ link.title | escape }}</a>{%- endfor -%}\n      {%- endif -%}\n\n      {%- if localization.available_countries and localization.available_countries.size > 1 -%}\n        <form method=\"post\" action=\"/localization\" accept-charset=\"UTF-8\" class=\"pmf__loc\">\n          <input type=\"hidden\" name=\"form_type\" value=\"localization\">\n          <input type=\"hidden\" name=\"utf8\" value=\"✓\">\n          <span class=\"pmf__loc-label\">Country:</span>\n          <span class=\"pmf__loc-field\">\n            <select name=\"country_code\" aria-label=\"Country\" onchange=\"this.form.submit()\">\n              {%- for c in localization.available_countries -%}\n                <option value=\"{{ c.iso_code }}\"{% if c.iso_code == localization.country.iso_code %} selected{% endif %}>{{ c.name }}</option>\n              {%- endfor -%}\n            </select>\n          </span>\n          <input type=\"hidden\" name=\"return_to\" value=\"{{ request.path }}\">\n        </form>\n      {%- endif -%}\n    </nav>\n\n    <div class=\"pmf__copy\">&copy; {{ year }} PANTAO &middot; Manila</div>\n  </div>\n</div>\n\n<style>\n  .pmf {\n    --pmf-ink: #16181c;\n    --pmf-paper: #f4f4f2;\n    --pmf-muted: rgba(22, 24, 28, 0.52);\n    --pmf-line: rgba(22, 24, 28, 0.12);\n    --pmf-accent: #b5271f;\n    background: var(--pmf-paper);\n    color: var(--pmf-ink);\n    border-top: 1px solid var(--pmf-line);\n    font-family: var(--font-body--family, -apple-system, system-ui, sans-serif);\n  }\n  .pmf__wrap {\n    max-width: 1600px;\n    margin: 0 auto;\n    padding: 14px clamp(20px, 4vw, 48px);\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 10px 30px;\n    flex-wrap: wrap;\n  }\n  .pmf__links { display: flex; align-items: center; flex-wrap: wrap; gap: clamp(14px, 1.9vw, 28px); }\n  .pmf__links > a {\n    font-size: 12px; font-weight: 400; letter-spacing: 0.01em; line-height: 1;\n    color: var(--pmf-ink); text-decoration: none; transition: color 0.2s ease;\n  }\n  .pmf__links > a:hover, .pmf__links > a:focus-visible { color: var(--pmf-accent); }\n\n  .pmf__loc { display: inline-flex; align-items: center; gap: 0.4em; margin: 0; font-size: 12px; color: var(--pmf-muted); }\n  .pmf__loc-field { position: relative; color: var(--pmf-ink); border-bottom: 1px solid var(--pmf-line); }\n  .pmf__loc select {\n    appearance: none; -webkit-appearance: none; border: 0; background: transparent; font: inherit;\n    color: var(--pmf-ink); padding: 2px 16px 2px 0; cursor: pointer;\n  }\n  .pmf__loc-field::after {\n    content: \"\"; position: absolute; right: 2px; top: 50%; width: 6px; height: 6px;\n    border-right: 1px solid var(--pmf-muted); border-bottom: 1px solid var(--pmf-muted);\n    transform: translateY(-70%) rotate(45deg); pointer-events: none;\n  }\n  .pmf__loc select:hover { color: var(--pmf-accent); }\n\n  .pmf__copy {\n    font-size: 11px; font-weight: 400; letter-spacing: 0.08em; text-transform: uppercase;\n    color: var(--pmf-muted); white-space: nowrap;\n  }\n\n  @media screen and (max-width: 720px) {\n    .pmf__wrap { flex-direction: column; align-items: flex-start; gap: 14px; }\n    .pmf__links { gap: 12px 18px; }\n  }\n</style>\n\n<script>\n  (function () {\n    var s = document.currentScript;\n    var sec = s && s.closest ? s.closest('.shopify-section') : null;\n    if (!sec) return;\n    sec.style.setProperty('background', '#f4f4f2', 'important');\n    sec.style.setProperty('padding', '0', 'important');\n    var kill = sec.querySelectorAll('.section, .section-background, [class*=\"spacing-style\"], .shopify-section__inner');\n    for (var i = 0; i < kill.length; i++) {\n      if (kill[i].className.indexOf('section-background') > -1) { kill[i].style.display = 'none'; continue; }\n      kill[i].style.setProperty('padding', '0', 'important');\n      kill[i].style.setProperty('margin', '0', 'important');\n      kill[i].style.setProperty('max-width', 'none', 'important');\n    }\n  })();\n</script>",
