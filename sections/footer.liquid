{%- comment -%}
  Footer — Pantao "The Ledger"
  --------------------------------------------------------
  The theme's canonical footer section (type: footer), which the theme
  editor's footer group uses. Renders the Pantao "Ledger" footer via a
  shared snippet so the design is driven by section CODE (which syncs
  reliably from GitHub) rather than by block configuration (which the
  theme editor owns and overwrites).

  Legacy block types remain declared in the schema so any blocks still
  configured on the section stay valid; they are simply not rendered.
{%- endcomment -%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  {% render 'pantao-ledger-footer', section: section %}
</div>

{% schema %}
{
  "name": "t:names.footer",
  "class": "section-wrapper",
  "blocks": [
    { "type": "_divider" },
    { "type": "@app" },
    { "type": "button" },
    { "type": "follow-on-shop" },
    { "type": "group" },
    { "type": "icon" },
    { "type": "image" },
    { "type": "menu" },
    { "type": "payment-icons" },
    { "type": "text" },
    { "type": "logo" },
    { "type": "jumbo-text" },
    { "type": "social-links" },
    { "type": "email-signup" }
  ],
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        { "value": "page-width", "label": "t:options.page" },
        { "value": "full-width", "label": "t:options.full" }
      ],
      "default": "page-width"
    },
    { "type": "link_list", "id": "footer_menu", "label": "Footer menu", "info": "Links shown in the slim footer row. If empty, falls back to the Client Care / Legal / Socials menus, then to shop policies.", "default": "footer" },
    { "type": "header", "content": "Email capture" },
    { "type": "checkbox", "id": "show_newsletter", "label": "Show email capture", "default": true },
    { "type": "text", "id": "newsletter_kicker", "label": "Kicker", "default": "Be told when the doors open." },
    { "type": "textarea", "id": "newsletter_sub", "label": "Subtext", "default": "One note a year, ahead of the edition. Nothing else." },
    { "type": "text", "id": "newsletter_button", "label": "Button label", "default": "Join" },
    { "type": "header", "content": "Columns" },
    { "type": "text", "id": "col1_heading", "label": "Column 1 heading", "default": "Client Care" },
    { "type": "link_list", "id": "col1_menu", "label": "Column 1 menu", "default": "client-care" },
    { "type": "text", "id": "col2_heading", "label": "Column 2 heading", "default": "Legal" },
    { "type": "link_list", "id": "col2_menu", "label": "Column 2 menu", "default": "legal" },
    { "type": "text", "id": "col3_heading", "label": "Column 3 heading", "default": "Socials" },
    { "type": "link_list", "id": "col3_menu", "label": "Column 3 menu", "default": "social" },
    { "type": "header", "content": "Signature" },
    { "type": "text", "id": "brand_name", "label": "Wordmark / brand name", "default": "PANTAO" },
    { "type": "text", "id": "copyright_suffix", "label": "Copyright suffix", "default": "Manila" },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment marks", "default": true },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    { "type": "header", "content": "t:content.padding" },
    { "type": "range", "id": "padding-block-start", "label": "t:settings.top", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding-block-end", "label": "t:settings.bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 32 }
  ],
  "presets": [
    {
      "name": "t:names.footer",
      "category": "t:categories.footer",
      "settings": {
        "section_width": "page-width",
        "show_newsletter": true,
        "color_scheme": "scheme-1",
        "padding-block-start": 80,
        "padding-block-end": 32
      }
    }
  ]
}
{% endschema %}
