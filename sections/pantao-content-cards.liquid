{%- comment -%}
  PANTAO Content Cards
  ----------------------------------------------------------------
  Editorial image cards with an overlaid title / subtitle / copy / link.
  Adapted from an Apple-style layout into the PANTAO design system:
  brand ink + paper, accent serif titles, the site-wide pill button, and
  a contrast scrim so text stays legible over PANTAO's dark imagery.

  Each card is a block; per-card text theme (light/dark) + alignment.
{%- endcomment -%}

<div class="pantao-cards" data-section-id="{{ section.id }}">
  {%- if section.settings.heading != blank -%}
    <div class="pantao-cards__head">
      {%- if section.settings.kicker != blank -%}
        <p class="pantao-cards__kicker">{{ section.settings.kicker | escape }}</p>
      {%- endif -%}
      <h2 class="pantao-cards__heading">{{ section.settings.heading | escape }}</h2>
    </div>
  {%- endif -%}

  <div class="pantao-cards__grid" style="--pc-min: {{ section.settings.card_min_width }}px; --pc-gap: {{ section.settings.grid_gap }}px;">
    {%- for block in section.blocks -%}
      {%- liquid
        assign theme_class = 'is-light'
        if block.settings.text_theme == 'dark'
          assign theme_class = 'is-dark'
        endif
      -%}
      <div class="pantao-card {{ theme_class }} align-{{ block.settings.text_alignment }} scrim-{{ block.settings.scrim }}" {{ block.shopify_attributes }}>
        {%- if block.settings.link != blank -%}<a class="pantao-card__link" href="{{ block.settings.link }}" aria-label="{{ block.settings.title | escape }}"></a>{%- endif -%}

        {%- if block.settings.image != blank -%}
          <img
            class="pantao-card__bg"
            src="{{ block.settings.image | image_url: width: 1400 }}"
            srcset="{{ block.settings.image | image_url: width: 700 }} 700w, {{ block.settings.image | image_url: width: 1400 }} 1400w, {{ block.settings.image | image_url: width: 2000 }} 2000w"
            sizes="(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw"
            alt="{{ block.settings.image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.image.width }}"
            height="{{ block.settings.image.height }}"
          >
        {%- else -%}
          <div class="pantao-card__placeholder">{{ 'lifestyle-1' | placeholder_svg_tag: 'pantao-card__placeholder-svg' }}</div>
        {%- endif -%}

        <div class="pantao-card__content">
          {%- if block.settings.subtitle != blank -%}<span class="pantao-card__subtitle">{{ block.settings.subtitle | escape }}</span>{%- endif -%}
          {%- if block.settings.title != blank -%}<h3 class="pantao-card__title">{{ block.settings.title | escape }}</h3>{%- endif -%}
          {%- if block.settings.description != blank -%}<p class="pantao-card__desc">{{ block.settings.description | escape }}</p>{%- endif -%}
          {%- if block.settings.button_label != blank -%}
            <span class="pantao-card__btn">{{ block.settings.button_label | escape }}</span>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

<style>
  .pantao-cards {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: clamp(28px, 5vw, 56px) clamp(16px, 4vw, 24px);
    color: var(--color-foreground);
  }
  .pantao-cards__head { margin: 0 0 clamp(20px, 3vw, 32px); }
  .pantao-cards__kicker {
    font-family: var(--font-body--family); font-size: 11px; letter-spacing: 0.24em;
    text-transform: uppercase; opacity: 0.55; margin: 0 0 0.5rem 0;
  }
  .pantao-cards__heading {
    font-family: var(--font-accent--family); font-weight: var(--font-accent--weight, 500);
    font-size: clamp(1.75rem, 3.4vw, 2.75rem); line-height: 1.05; letter-spacing: -0.01em; margin: 0; text-wrap: balance;
  }

  .pantao-cards__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(var(--pc-min, 340px), 1fr));
    gap: var(--pc-gap, 24px);
  }

  .pantao-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: clamp(420px, 46vw, 560px);
    border-radius: 18px;
    overflow: hidden;
    background: color-mix(in srgb, var(--color-foreground) 6%, var(--color-background));
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.5s cubic-bezier(0.22, 1, 0.36, 1);
    isolation: isolate;
  }
  .pantao-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 24px 48px color-mix(in srgb, var(--color-foreground) 14%, transparent);
  }
  .pantao-card__link { position: absolute; inset: 0; z-index: 5; }
  .pantao-card__bg, .pantao-card__placeholder {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 1;
  }
  .pantao-card__placeholder { display: flex; background: color-mix(in srgb, var(--color-foreground) 8%, var(--color-background)); }
  .pantao-card__placeholder-svg { width: 100%; height: 100%; object-fit: cover; opacity: 0.5; }

  /* Contrast scrim so text stays legible over imagery. Direction follows
     the vertical placement (text sits at the bottom). */
  .pantao-card::after {
    content: ''; position: absolute; inset: 0; z-index: 2; pointer-events: none;
    transition: opacity 0.4s ease;
  }
  .pantao-card.scrim-dark::after {
    background: linear-gradient(to top, rgba(10,11,13,0.72) 0%, rgba(10,11,13,0.28) 42%, rgba(10,11,13,0) 68%);
  }
  .pantao-card.scrim-light::after {
    background: linear-gradient(to top, rgba(245,246,245,0.82) 0%, rgba(245,246,245,0.35) 42%, rgba(245,246,245,0) 68%);
  }
  .pantao-card.scrim-none::after { background: none; }

  .pantao-card__content {
    position: relative; z-index: 3;
    padding: clamp(24px, 3vw, 44px);
    display: flex; flex-direction: column; flex: 1 1 auto;
    justify-content: flex-end;
  }
  .pantao-card.align-center .pantao-card__content { align-items: center; text-align: center; }
  .pantao-card.align-left .pantao-card__content { align-items: flex-start; text-align: left; }
  .pantao-card.align-top .pantao-card__content { justify-content: flex-start; }

  /* Text themes. --pc-ink is the text color; --pc-paper is its opposite,
     used for the pill (paper pill + ink text, and vice versa) so the button
     always contrasts its own card. */
  .pantao-card.is-light { --pc-ink: #f5f6f5; --pc-ink-soft: rgba(245,246,245,0.78); --pc-paper: #16181c; }
  .pantao-card.is-dark  { --pc-ink: #16181c; --pc-ink-soft: rgba(22,24,28,0.66); --pc-paper: #f5f6f5; }

  .pantao-card__subtitle {
    font-family: var(--font-body--family); font-size: 11px; font-weight: 500; letter-spacing: 0.22em;
    text-transform: uppercase; color: var(--pc-ink-soft); margin-bottom: 10px;
  }
  .pantao-card__title {
    font-family: var(--font-accent--family); font-weight: var(--font-accent--weight, 500);
    font-size: clamp(1.6rem, 2.6vw, 2.25rem); line-height: 1.06; letter-spacing: -0.01em;
    color: var(--pc-ink); margin: 0 0 12px 0; text-wrap: balance;
  }
  .pantao-card__desc {
    font-family: var(--font-body--family); font-size: var(--font-size--sm, 0.9375rem); line-height: 1.55;
    color: var(--pc-ink-soft); margin: 0 0 22px 0; max-width: 34ch;
  }
  .pantao-card.align-center .pantao-card__desc { margin-inline: auto; }

  /* PANTAO pill button (visual only — the whole card is the link) */
  .pantao-card__btn {
    display: inline-flex; align-items: center; align-self: flex-start;
    background: var(--pc-ink); color: var(--color-background);
    font-family: var(--font-body--family); font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase;
    padding: 12px 22px; border-radius: 100px; transition: opacity 0.3s ease;
  }
  .pantao-card.is-dark .pantao-card__btn { color: #f5f6f5; }
  .pantao-card.align-center .pantao-card__btn { align-self: center; }
  .pantao-card:hover .pantao-card__btn { opacity: 0.85; }

  @media (prefers-reduced-motion: reduce) {
    .pantao-card, .pantao-card:hover { transition: none; transform: none; }
  }
</style>

{% schema %}
{
  "name": "PANTAO Content Cards",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "The Edition" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made in numbers small enough to know by hand." },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "max_width", "label": "Max width", "min": 1000, "max": 1600, "step": 20, "unit": "px", "default": 1440 },
    { "type": "range", "id": "card_min_width", "label": "Min card width", "min": 240, "max": 460, "step": 10, "unit": "px", "default": 340 },
    { "type": "range", "id": "grid_gap", "label": "Grid gap", "min": 8, "max": 48, "step": 2, "unit": "px", "default": 24 }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Background image" },
        { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "PANTAO" },
        { "type": "text", "id": "title", "label": "Title", "default": "The next edition." },
        { "type": "textarea", "id": "description", "label": "Description", "default": "One piece a year, made in numbers small enough to know each by hand." },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Enter the edition" },
        { "type": "url", "id": "link", "label": "Link" },
        {
          "type": "select", "id": "text_theme", "label": "Text theme", "default": "light",
          "info": "Light text for dark imagery, dark text for light imagery.",
          "options": [ { "value": "light", "label": "Light (on dark image)" }, { "value": "dark", "label": "Dark (on light image)" } ]
        },
        {
          "type": "select", "id": "scrim", "label": "Contrast scrim", "default": "dark",
          "options": [ { "value": "dark", "label": "Dark" }, { "value": "light", "label": "Light" }, { "value": "none", "label": "None" } ]
        },
        {
          "type": "select", "id": "text_alignment", "label": "Text alignment", "default": "left",
          "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "top", "label": "Top-left" } ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "PANTAO Content Cards",
      "blocks": [ { "type": "card" }, { "type": "card" } ]
    }
  ]
}
{% endschema %}
