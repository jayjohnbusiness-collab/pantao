{%- comment -%}
  PANTAO footer (Acne Studios reference)
  Newsletter on the left, three quiet link columns, then the slim bottom bar
  (country selector + copyright) that was there before.
{%- endcomment -%}
{%- assign year = 'now' | date: '%Y' -%}
<div class="pft">
  <div class="pft__top">
    <div class="pft__news">
      <h2 class="pft__h">Newsletter</h2>
      <p class="pft__p">{{ section.settings.newsletter_text }}</p>
      {%- form 'customer', id: 'pantao-footer-newsletter', class: 'pft__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {%- if form.posted_successfully? -%}
          <p class="pft__ok" role="status">Thank you. You’re on the list.</p>
        {%- else -%}
          <label for="PftEmail" class="visually-hidden">Email</label>
          <input id="PftEmail" type="email" name="contact[email]" placeholder="Email" autocomplete="email" required>
          <button type="submit">Sign up</button>
          {%- if form.errors -%}<p class="pft__err" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
        {%- endif -%}
      {%- endform -%}
    </div>

    <nav class="pft__col" aria-label="Help">
      <h2 class="pft__h">Help</h2>
      <a href="/pages/faq">FAQs</a>
      <a href="/pages/contact">Contact us</a>
      <a href="{{ routes.account_url }}">Order status</a>
      <a href="/policies/shipping-policy">Shipping</a>
      <a href="/policies/refund-policy">Returns</a>
    </nav>

    <nav class="pft__col" aria-label="Client services">
      <h2 class="pft__h">Client services</h2>
      <a href="{{ routes.account_url }}">Account</a>
      <a href="/pages/saved">Saved</a>
      <a href="/pages/events">Events</a>
    </nav>

    <nav class="pft__col" aria-label="Company">
      <h2 class="pft__h">Company</h2>
      <a href="/pages/about">About</a>
      <a href="https://www.instagram.com/pantaogaleriya" target="_blank" rel="noopener">Instagram</a>
      {%- if shop.privacy_policy -%}<a href="{{ shop.privacy_policy.url }}">Privacy</a>{%- endif -%}
      {%- if shop.terms_of_service -%}<a href="{{ shop.terms_of_service.url }}">Terms</a>{%- endif -%}
    </nav>
  </div>

  <div class="pft__bar">
    {%- if localization.available_countries and localization.available_countries.size > 1 -%}
      <form method="post" action="/localization" accept-charset="UTF-8" class="pft__loc">
        <input type="hidden" name="form_type" value="localization">
        <input type="hidden" name="utf8" value="✓">
        <label for="PftCountry">Shipping to</label>
        <span class="pft__loc-field">
          <select id="PftCountry" name="country_code" onchange="this.form.submit()">
            {%- for c in localization.available_countries -%}
              <option value="{{ c.iso_code }}"{% if c.iso_code == localization.country.iso_code %} selected{% endif %}>{{ c.name }} ({{ c.currency.iso_code }})</option>
            {%- endfor -%}
          </select>
        </span>
        <input type="hidden" name="return_to" value="{{ request.path }}">
      </form>
    {%- else -%}<span></span>{%- endif -%}
    <p class="pft__copy">&copy; {{ year }} PANTAO &middot; Manila / Seattle</p>
  </div>
</div>

<style>
  .pft { background: #f4f4f2; color: #141414; border-top: 1px solid rgb(20 20 20 / 0.12); font-family: var(--font-body--family); }
  .pft__top { display: grid; grid-template-columns: minmax(260px, 1.6fr) repeat(3, minmax(0, 1fr)); gap: 32px 40px; padding: 48px 40px 56px; }
  .pft__h { margin: 0 0 14px; font-family: var(--font-body--family) !important; font-size: 11px !important; font-weight: 400 !important; letter-spacing: 0.04em !important; text-transform: uppercase; color: rgb(20 20 20 / 0.55); }
  .pft__col { display: flex; flex-direction: column; gap: 10px; }
  .pft__col a { width: fit-content; color: #141414; font-size: 12px; letter-spacing: 0.02em; text-decoration: none; }
  .pft__col a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .pft__p { margin: 0 0 16px; max-width: 34ch; font-size: 12px; line-height: 1.55; }
  .pft__form { display: flex; max-width: 380px; border-bottom: 1px solid #141414; }
  .pft__form input[type='email'] { flex: 1; min-width: 0; padding: 10px 0; border: 0; background: transparent; font: inherit; font-size: 12px; color: #141414; outline: none; }
  .pft__form input::placeholder { color: rgb(20 20 20 / 0.45); text-transform: uppercase; letter-spacing: 0.04em; font-size: 11px; }
  .pft__form button { padding: 10px 0 10px 16px; border: 0; background: none; font: inherit; font-size: 11px; letter-spacing: 0.04em; text-transform: uppercase; color: #141414; }
  .pft__form button:hover { text-decoration: underline; text-underline-offset: 3px; }
  .pft__ok, .pft__err { margin: 10px 0; font-size: 12px; }
  .pft__err { flex-basis: 100%; color: #8a1c14; }
  .pft__bar { display: flex; justify-content: space-between; align-items: center; gap: 12px 24px; flex-wrap: wrap; padding: 14px 40px; border-top: 1px solid rgb(20 20 20 / 0.12); }
  .pft__loc { display: inline-flex; align-items: center; gap: 8px; margin: 0; font-size: 11px; letter-spacing: 0.04em; text-transform: uppercase; color: rgb(20 20 20 / 0.55); }
  .pft__loc-field { position: relative; border-bottom: 1px solid rgb(20 20 20 / 0.25); }
  .pft__loc select { appearance: none; -webkit-appearance: none; border: 0; background: transparent; font: inherit; color: #141414; padding: 2px 16px 2px 0; }
  .pft__loc-field::after { content: ''; position: absolute; right: 2px; top: 50%; width: 5px; height: 5px; border-right: 1px solid #141414; border-bottom: 1px solid #141414; transform: translateY(-70%) rotate(45deg); pointer-events: none; }
  .pft__copy { margin: 0; font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: rgb(20 20 20 / 0.55); }
  @media screen and (max-width: 989px) { .pft__top { grid-template-columns: 1fr 1fr; } .pft__news { grid-column: 1 / -1; } }
  @media screen and (max-width: 749px) {
    .pft__top { grid-template-columns: 1fr 1fr; padding: 36px 16px 40px; gap: 32px 20px; }
    .pft__col:last-child { grid-column: 1 / -1; }
    .pft__bar { padding: 14px 16px calc(14px + env(safe-area-inset-bottom)); flex-direction: column; align-items: flex-start; }
  }
</style>

{% schema %}
{
  "name": "PANTAO footer",
  "tag": "div",
  "enabled_on": { "groups": ["footer"] },
  "settings": [
    { "type": "text", "id": "newsletter_text", "label": "Newsletter text", "default": "Be first to know about new drops, restocks and events." }
  ],
  "presets": [ { "name": "PANTAO footer", "category": "Footer" } ]
}
{% endschema %}
