{%- comment -%} PANTAO Saved page: the shopper's hearted pieces (stored in their browser). {%- endcomment -%}
<section class="pantao-plist-wrap pantao-saved-page">
  <div class="pantao-plist__head" style="padding-top: 0;">
    <div>
      <h1 style="margin:0;font:inherit;">{{ section.settings.heading | default: 'Saved' }}</h1>
      <p class="pantao-plist__count" data-pantao-list-count style="margin:2px 0 0;"></p>
    </div>
  </div>
  <p class="pantao-plist__empty" data-pantao-list-empty hidden>
    Nothing saved yet. Tap the heart on any piece to keep it here. <a href="{{ routes.all_products_collection_url }}">Shop the collection</a>
  </p>
  <pantao-product-list data-source="saved"></pantao-product-list>
</section>

{% schema %}
{
  "name": "Saved items",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Saved" }
  ],
  "presets": [{ "name": "Saved items" }]
}
{% endschema %}
