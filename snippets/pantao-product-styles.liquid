{%- comment -%}
  PANTAO product page styles (Acne Studios reference)
  ----------------------------------------------------------------
  Wide single-column photos on the left, a narrow left-aligned details
  column on the right; small 12px caps for name/price on one line, square
  size boxes, square buttons, quiet accordion rows. Scoped to the product
  information section so nothing else is affected.
{%- endcomment -%}
<style>
  .product-information .product-details {
    padding: 48px 48px 64px 40px !important;
    font-size: 12px;
  }
  .product-information .product-details .group-block-content {
    position: relative;
    gap: 14px !important;
  }

  /* Name left, price right, same line. */
  .product-information .product-details .group-block-content > .text-block:has(h1) {
    padding-block-start: 0 !important;
  }
  .product-information .product-details .group-block-content > .text-block:has(h1),
  .product-information .product-details .group-block-content > .text-block h1 {
    margin: 0;
    padding-right: 90px;
    font-size: 12px !important;
    font-weight: 400 !important;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    line-height: 1.4;
  }
  .product-information .product-details .group-block-content > product-price {
    position: absolute;
    top: 0;
    right: 0;
    margin: 0 !important;
    padding: 0 !important;
    width: auto !important;
    font-size: 12px !important;
    line-height: 1.4;
  }
  .product-information .product-details product-price * { font-size: 12px !important; }

  /* Size boxes: square grid like Acne. */
  .product-information .variant-option--buttons legend,
  .product-information .variant-option__swatch-value,
  .product-information .variant-picker legend {
    font-size: 11px !important;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .product-information .variant-option--buttons:not(.variant-option--swatches) {
    display: grid !important;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0 !important;
  }
  .product-information .variant-option--buttons:not(.variant-option--swatches) legend { grid-column: 1 / -1; margin-bottom: 8px; }
  .product-information .variant-option__button-label:not(.variant-option__button-label--has-swatch) {
    border-radius: 0 !important;
    min-width: 0 !important;
    height: 40px;
    margin: 0 -1px -1px 0;
    font-size: 11px !important;
    justify-content: flex-start !important;
    padding: 0 10px !important;
  }

  .product-information .variant-option__button-label:not(.variant-option__button-label--has-swatch):has(input:checked) {
    background: #141414 !important;
    color: #fff !important;
    border-color: #141414 !important;
  }
  .product-information .variant-option__button-label:has(input:checked) .variant-option__button-label__text,
  .product-information .variant-option__button-label:has(input:checked) span { color: #fff !important; }
  .product-information .variant-option__button-label::before,
  .product-information .variant-option__button-label::after { border-radius: 0 !important; }

  /* Square primary button, small caps label. */
  .product-information :is(.add-to-cart-button, .button, button[name='add'], .shopify-payment-button__button) {
    border-radius: 0 !important;
  }
  .product-information .add-to-cart-button,
  .product-information button[name='add'] {
    font-size: 11px !important;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    min-height: 48px;
  }

  /* Body copy small and quiet. */
  .product-information .product-details .text-block:not(:has(h1)),
  .product-information .product-details .text-block:not(:has(h1)) * {
    font-size: 12px !important;
    line-height: 1.55;
    text-align: left !important;
    text-transform: none;
  }

  /* Accordion rows: plain small caps, thin dividers, no icons. */
  .product-information .accordion summary,
  .product-information .accordion summary * {
    font-size: 11px !important;
    font-weight: 400 !important;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .product-information .accordion summary { padding-block: 14px !important; }
  .product-information .accordion .details__icon,
  .product-information .accordion summary .svg-wrapper:first-child:not(:last-child) { display: none; }
  .product-information .accordion .details-content,
  .product-information .accordion .details-content * { font-size: 12px !important; line-height: 1.55; }

  @media (max-width: 749px) {
    .product-information .product-details { padding: 24px 16px 48px !important; }
  }
</style>
