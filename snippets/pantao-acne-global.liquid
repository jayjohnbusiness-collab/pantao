{%- comment -%}
  PANTAO site-wide Acne Studios finish
  ----------------------------------------------------------------
  Square corners everywhere (buttons, tiles, inputs, drawers, popups) and one
  quiet heading scale: small 12px caps instead of large bold display type.
  Round things that must stay round (count bubbles, status dots, spinners,
  the cart badge) are excluded.
{%- endcomment -%}
<style>
  body *:not(.cart-bubble, .cart-bubble *, .filter-count-bubble, .filter-count-bubble *, [class*='spinner'], [class*='loading'], [class*='__dot'], .pantao-stock__dot, input[type='radio'], .swatch--round) {
    border-radius: 0 !important;
  }
  body *::before, body *::after { border-radius: 0 !important; }

  /* Small caps headings: page titles, section titles, drawers, dialogs. */
  :is(main, .cart-drawer, cart-drawer-component, dialog, .search-modal) :is(h1, h2, h3, .h1, .h2, .h3, .h4):not(.pantao-keep-size):not([class*='arrival-hero']):not([class*='pantao-name']) {
    font-family: var(--font-body--family) !important;
    font-size: 12px !important;
    font-weight: 400 !important;
    letter-spacing: 0.02em !important;
    line-height: 1.4 !important;
    text-transform: uppercase;
  }

  /* Buttons: small caps label to match. */
  :is(main, .cart-drawer, cart-drawer-component, dialog) :is(.button, button.button, a.button, .button-secondary) {
    font-size: 11px !important;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  /* Product rows ("You may also like", recommendations): tight 10px gaps,
     tall 2:3 photos, same as the homepage Collection row. */
  .resource-list--grid { gap: 28px 10px !important; }
  .resource-list .card-gallery { --gallery-aspect-ratio: 2 / 3 !important; }
  .resource-list .product-card :is(.product-title, [class*='product-title'], .price, [class*='price']) {
    font-size: 11px !important;
    font-weight: 400 !important;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  /* Mobile menu drawer (Acne): opens UNDER the header, so the logo, bag
     and the X stay exactly where the menu icon was. White panel, one 20px
     left edge for text, full-width hairlines, ~46px rows, then a quieter
     secondary list and the currency line. */
  .menu-drawer {
    --color-background: 255 255 255;
    background: #ffffff !important;
    color: #141414 !important;
    box-shadow: none !important;
    border: 0 !important;
    top: var(--header-height, 64px) !important;
    width: 100vw !important;
    max-width: 100vw !important;
    height: calc(100dvh - var(--header-height, 64px)) !important;
    flex-direction: column;
  }
  .menu-drawer .menu-drawer__close-button { display: none !important; }
  .menu-drawer .menu-drawer__navigation { padding: 0 !important; margin: 0 !important; flex: none !important; }
  .menu-drawer .menu-drawer__menu,
  .menu-drawer .menu-drawer__menu > li { padding: 0 !important; margin: 0 !important; gap: 0 !important; }
  .menu-drawer .menu-drawer__menu-container,
  .menu-drawer .menu-drawer__menu-container--divider { padding: 0 !important; margin: 0 !important; border: 0 !important; }
  .menu-drawer .menu-drawer__menu-item--mainlist,
  .menu-drawer .menu-drawer__menu-item--child,
  .menu-drawer .menu-drawer__menu-item--parent {
    min-height: 0 !important;
    margin: 0 !important;
    padding: 14px 20px !important;
    font-family: var(--font-body--family) !important;
    font-size: 13px !important;
    font-weight: 400 !important;
    line-height: 1.3 !important;
    letter-spacing: 0.02em !important;
    text-transform: uppercase !important;
    color: #141414 !important;
    border-bottom: 1px solid #ececec;
  }
  .menu-drawer .menu-drawer__menu > li:first-child .menu-drawer__menu-item--mainlist { border-top: 1px solid #ececec; }
  .menu-drawer .menu-drawer__menu-item-text { font-size: inherit !important; color: inherit !important; padding: 0 !important; }
  .menu-drawer .menu-drawer__menu-item--active .menu-drawer__menu-item-text { text-decoration: underline; text-underline-offset: 4px; }

  .pantao-drawer-secondary { margin: 0; padding: 28px 20px 8px; display: flex; flex-direction: column; gap: 14px; }
  .pantao-drawer-secondary a {
    color: #6b6b6b;
    font-size: 11px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .pantao-drawer-secondary a:hover { color: #141414; }

  .menu-drawer .menu-drawer__utility-links { padding: 18px 20px 28px !important; margin-top: auto; border-top: 0 !important; }
  .menu-drawer .menu-drawer__utility-links,
  .menu-drawer .menu-drawer__utility-links * {
    color: #141414 !important;
    font-size: 11px !important;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  /* No dimming over the header while the menu is open; the white panel is enough. */
  .menu-drawer__backdrop { backdrop-filter: none !important; background: transparent !important; }
  /* Header already has its own bottom line: drop the extra one on top of the list. */
  .menu-drawer .menu-drawer__menu > li:first-child .menu-drawer__menu-item--mainlist { border-top: 1px solid #ececec !important; }
  /* Currency line on the same 20px edge as everything else. */
  .menu-drawer .menu-drawer__localization,
  .menu-drawer drawer-localization-component,
  .menu-drawer .drawer-localization,
  .menu-drawer .drawer-localization__button,
  .menu-drawer .drawer-localization__button--label,
  .menu-drawer .mobile-localization { margin: 0 !important; padding-inline: 0 !important; }
  .menu-drawer .menu-drawer__utility-links { padding-inline: 20px !important; margin-inline: 0 !important; }

  /* Header currency picker: same 12px caps as the menu links, and a quiet,
     square dropdown with small type. */
  #header-component .dropdown-localization__button,
  #header-component .dropdown-localization__button *,
  #header-component .localization-selector,
  #header-component .currency-code {
    font-size: 12px !important;
    font-weight: 400 !important;
    letter-spacing: 0.02em !important;
    text-transform: uppercase;
    line-height: 1 !important;
  }
  #header-component .dropdown-localization__button .svg-wrapper,
  #header-component .dropdown-localization__button svg { width: 10px !important; height: 10px !important; }
  #header-component .localization-form,
  #header-component .localization-form :is(input, button, li, span, a, label) {
    font-size: 11px !important;
    letter-spacing: 0.02em;
  }
</style>
