{%- comment -%}
  Pantao top nav — pill items with a hover slide fill.
  ----------------------------------------------------------------
  Styles the desktop horizontal menu (.header-menu). Each item rests in a
  compact pill; on hover the pill fills from the left (slide) with a fixed
  brand ink + paper pair so it is always legible over any header state.

  Robustness notes:
  - Border uses currentColor via color-mix (the scheme's *-rgb vars resolve
    to `inherit` in the transparent/sticky header states, which silently
    breaks rgb(var(--…-rgb) / …) borders).
  - Hover fill/text use fixed brand colors, not --color-background, because
    over the hero --color-background is white — a white fill + white text
    made the hover look like it obscured the menu.
  - The theme sets .menu-list__link { height:100% }; we reset to auto to keep
    the pills compact. Loads once (from the header menu block); inert on
    mobile / drawer.
{%- endcomment -%}
<style>
  @media screen and (min-width: 750px) {
    /* Inter-pill spacing.
       The "Top nav bar" (navigation_bar variant) renders the menu with class
       `menu-list--mobile` and an inline `--menu-horizontal-gap: 15px`, and the
       theme rule `.menu-list--mobile .menu-list__list { gap: var(--menu-horizontal-gap) }`
       applies that 15px at all widths. A gap near 15px looks unchanged next to
       the theme default, so we set the `gap` PROPERTY directly to a distinctly
       larger value. This selector (#id + 2 classes) outspecifies the theme's
       `.menu-list--mobile .menu-list__list`, and beats the inline
       `--menu-horizontal-gap` too because we set `gap` to a literal rather than
       reading that variable. One mechanism only — no item margins to stack. */
    #header-component .header-menu .menu-list__list {
      gap: clamp(1.25rem, 2.2vw, 2rem);
      align-items: center;
    }

    /* The item is a full-height column; center the (now compact) pill in it
       so it doesn't sit at the top with empty space below. */
    #header-component .header-menu .menu-list__list-item {
      justify-content: center;
    }

    /* Compact pill — override the theme's full-height link. */
    #header-component .header-menu .menu-list__link {
      height: auto;
      align-self: center;
      position: relative;
      overflow: hidden;
      line-height: 1;
      border: 1px solid color-mix(in srgb, currentColor 26%, transparent);
      border-radius: 100px;
      padding: 0.5rem 1.1rem;
      transition: border-color 0.35s ease;
    }

    #header-component .header-menu .menu-list__link-title {
      padding-inline: 0;
      position: relative;
      z-index: 1;
      transition: color 0.3s ease;
    }

    /* The slide: pill fills from the left on hover (fixed brand ink). */
    #header-component .header-menu .menu-list__link::before {
      content: '';
      position: absolute;
      inset: 0;
      z-index: 0;
      background: #16181c;
      transform: scaleX(0);
      transform-origin: left center;
      transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
      pointer-events: none;
    }

    #header-component .header-menu .menu-list__link:hover::before,
    #header-component .header-menu .menu-list__link:focus-visible::before {
      transform: scaleX(1);
    }

    #header-component .header-menu .menu-list__link:hover .menu-list__link-title,
    #header-component .header-menu .menu-list__link:focus-visible .menu-list__link-title {
      color: #f5f6f5;
    }

    #header-component .header-menu .menu-list__link:hover,
    #header-component .header-menu .menu-list__link:focus-visible {
      border-color: #16181c;
    }

    /* Current page: a quietly emphasized pill outline. */
    #header-component .header-menu .menu-list__link--active {
      border-color: color-mix(in srgb, currentColor 55%, transparent);
    }

    @media (prefers-reduced-motion: reduce) {
      #header-component .header-menu .menu-list__link::before {
        transition: none;
      }
    }
  }
</style>
