{%- comment -%}
  Pantao top nav — clean items with an outline hover.
  ----------------------------------------------------------------
  Styles the desktop horizontal menu (.header-menu). Each item rests as
  clean text (no border, no fill); on hover a pill outline and a faint
  background fade in — the understated, editorial treatment from the
  homepage design language.

  Robustness notes:
  - The rest border is transparent (not 0) so it reserves the 1px and the
    hover outline never shifts neighbouring items.
  - Outline + fill use currentColor via color-mix, because the scheme's
    *-rgb vars resolve to `inherit` in the transparent/sticky header states,
    which silently breaks rgb(var(--…-rgb) / …). This keeps the hover legible
    over any header colour without hardcoding a brand colour.
  - The theme sets .menu-list__link { height:100% }; we reset to auto to keep
    the pills compact. Loads once (from the header menu block); inert on
    mobile / drawer.

  Editable in the theme editor: the Header menu block exposes "Pill spacing"
  and "Pill horizontal padding" ranges (schema ids pantao_pill_spacing /
  pantao_pill_padding). They flow in here as px. Defaults apply if the block
  isn't passed. Note: `default` does not override 0, so 0px spacing is allowed.

  @param {object} [block] - The header menu block (for its pill settings)
{%- endcomment -%}
{%- liquid
  assign pill_gap = 24
  assign pill_pad = 18
  if block.settings.pantao_pill_spacing != blank or block.settings.pantao_pill_spacing == 0
    assign pill_gap = block.settings.pantao_pill_spacing
  endif
  if block.settings.pantao_pill_padding != blank
    assign pill_pad = block.settings.pantao_pill_padding
  endif
-%}
<style>
  @media screen and (min-width: 750px) {
    /* Inter-pill spacing.
       The default desktop menu (menu_style text, navigation_bar off) pipes
       the items through the <overflow-list> web component: the real flex
       container is a `<ul part="list">` INSIDE that element's shadow root,
       and the light-DOM `.menu-list__list` element does not exist on this
       path. So a `gap` set on `.menu-list__list` (below) silently does
       nothing here — which is why earlier spacing "fixes" never showed. We
       reach the shadow container from the outer document via ::part(list),
       the one selector that crosses the shadow boundary. */
    #header-component .header-menu overflow-list::part(list) {
      gap: {{ pill_gap }}px;
      align-items: center;
    }

    /* The other menu paths (navigation_bar variant, mobile) render a plain
       light-DOM `<ul class="menu-list__list">` with no shadow root. Only one
       path renders at a time, so this never stacks with the ::part rule. */
    #header-component .header-menu .menu-list__list {
      gap: {{ pill_gap }}px;
      align-items: center;
    }

    /* The item is a full-height column; center the (now compact) pill in it
       so it doesn't sit at the top with empty space below. */
    #header-component .header-menu .menu-list__list-item {
      justify-content: center;
    }

    /* Clean at rest — transparent border reserves the 1px so the hover
       outline never nudges the row. Compact (override theme height:100%). */
    #header-component .header-menu .menu-list__link {
      height: auto;
      align-self: center;
      line-height: 1;
      border: 1px solid transparent;
      border-radius: 100px;
      padding: 0.5rem {{ pill_pad }}px;
      background-color: transparent;
      transition: border-color 0.3s ease, background-color 0.3s ease;
    }

    #header-component .header-menu .menu-list__link-title {
      padding-inline: 0;
    }

    /* Hover / focus: a pill outline and a faint fill fade in. */
    #header-component .header-menu .menu-list__link:hover,
    #header-component .header-menu .menu-list__link:focus-visible {
      border-color: color-mix(in srgb, currentColor 24%, transparent);
      background-color: color-mix(in srgb, currentColor 5%, transparent);
    }

    /* Current page: a quiet resting outline. */
    #header-component .header-menu .menu-list__link--active {
      border-color: color-mix(in srgb, currentColor 22%, transparent);
    }

    @media (prefers-reduced-motion: reduce) {
      #header-component .header-menu .menu-list__link {
        transition: none;
      }
    }
  }
</style>
