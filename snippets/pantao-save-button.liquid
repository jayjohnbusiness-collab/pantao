{%- comment -%}
  PANTAO wishlist heart. Saved items live in the shopper's browser
  (localStorage), so no account is needed. Behaviour: snippets/pantao-saved.liquid
  @param {product} product
  @param {string} [context] - 'card' (on product tiles) or 'product' (beside Add to cart)
{%- endcomment -%}
<button
  type="button"
  class="pantao-save pantao-save--{{ context | default: 'card' }}"
  data-pantao-save="{{ product.handle }}"
  aria-pressed="false"
  aria-label="Save {{ product.title | escape }}"
>
  <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
    <path d="M12 20.3 4.6 13a4.6 4.6 0 0 1 6.5-6.5l.9.9.9-.9a4.6 4.6 0 0 1 6.5 6.5Z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
  </svg>
  {%- if context == 'product' -%}<span class="pantao-save__label">Save</span>{%- endif -%}
</button>
