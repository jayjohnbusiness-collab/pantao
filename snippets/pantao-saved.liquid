{%- comment -%}
  PANTAO wishlist ("Saved") + recently viewed
  ----------------------------------------------------------------
  Both live in the shopper's own browser (localStorage), so they work
  without an account and nothing is stored on Shopify.
  - Hearts: snippets/pantao-save-button.liquid (cards + product page)
  - Header link "SAVED (n)": snippets/header-actions.liquid (desktop),
    drawer secondary list (phones)
  - Lists: <pantao-product-list data-source="saved|viewed">, used on
    the Saved page (sections/pantao-saved-page.liquid) and under product
    pages (layout/theme.liquid).
{%- endcomment -%}
<style>
  .pantao-save {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 0;
    border: 0;
    background: none;
    color: #141414;
    font: inherit;
    line-height: 1;
  }
  .pantao-save svg { width: 16px; height: 16px; display: block; }
  .pantao-save[aria-pressed='true'] path { fill: currentColor; }
  .pantao-save--card {
    position: absolute;
    top: 8px;
    right: 8px;
    z-index: 3;
    width: 32px;
    height: 32px;
    justify-content: center;
    filter: drop-shadow(0 0 1.5px rgb(255 255 255 / 0.95)) drop-shadow(0 0 1px rgb(255 255 255 / 0.9));
  }
  @media (hover: hover) and (pointer: fine) {
    .pantao-save--card { opacity: 0; transition: opacity 0.2s ease; }
    .card-gallery:hover .pantao-save--card,
    .pantao-plist__media:hover .pantao-save--card,
    .pantao-save--card[aria-pressed='true'],
    .pantao-save--card:focus-visible { opacity: 1; }
  }
  [product-grid-view='zoom-out'] .pantao-save--card { display: none; }
  .pantao-save--product {
    align-self: flex-start;
    margin-top: 2px;
    padding: 6px 0;
    font-size: 11px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .pantao-save--product svg { width: 14px; height: 14px; }
  .pantao-save--product[aria-pressed='true'] .pantao-save__label::after { content: 'd'; }

  /* Save confirmation pop-up (bottom-right on desktop, full-width bar on phones). */
  .pantao-toast {
    position: fixed;
    right: 24px;
    bottom: 24px;
    z-index: 2147483000;
    width: min(340px, calc(100vw - 32px));
    padding: 16px 40px 16px 16px;
    background: #ffffff;
    color: #141414;
    border: 1px solid #141414;
    font-family: var(--font-body--family);
    font-size: 12px;
    line-height: 1.5;
    letter-spacing: 0.02em;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.2s ease, transform 0.2s ease;
    pointer-events: none;
  }
  .pantao-toast.is-open { opacity: 1; transform: none; pointer-events: auto; }
  .pantao-toast__title { margin: 0 0 4px; font-size: 12px; font-weight: 400; text-transform: uppercase; }
  .pantao-toast__body { margin: 0; color: rgb(20 20 20 / 0.7); }
  .pantao-toast__actions { display: flex; gap: 16px; margin-top: 12px; }
  .pantao-toast__actions a { color: #141414; font-size: 11px; letter-spacing: 0.04em; text-transform: uppercase; text-underline-offset: 3px; }
  .pantao-toast__close {
    position: absolute; top: 10px; right: 10px;
    width: 24px; height: 24px; padding: 0; border: 0; background: none; color: #141414;
    display: inline-flex; align-items: center; justify-content: center;
  }
  .pantao-toast__close svg { width: 12px; height: 12px; }
  @media screen and (max-width: 749px) {
    .pantao-toast { left: 0; right: 0; bottom: 0; width: 100%; border-width: 1px 0 0; padding: 16px 44px calc(16px + env(safe-area-inset-bottom)) 16px; }
  }

  .pantao-help-link,
  .pantao-saved-link {
    font-family: var(--font-body--family);
    font-size: 12px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: inherit;
    text-decoration: none;
    white-space: nowrap;
    align-self: center;
    padding-inline: 6px;
  }
  .pantao-saved-link[hidden] { display: none !important; }
  @media screen and (max-width: 749px) { .pantao-saved-link, .pantao-help-link { display: none !important; } }

  /* Product lists (Saved page, Recently viewed) — same look as the collection grid. */
  .pantao-plist-wrap { padding: 56px 0 72px; }
  .pantao-plist-wrap[hidden] { display: none; }
  .pantao-plist__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 0 40px 18px;
    font-size: 12px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .pantao-plist__head h2 { margin: 0; font: inherit; }
  .pantao-plist__count { color: rgb(20 20 20 / 0.55); font-size: 11px; text-transform: none; }
  .pantao-plist { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0; margin: 0; padding: 0; list-style: none; }
  .pantao-plist__item a { display: block; color: inherit; text-decoration: none; }
  .pantao-plist__media { position: relative; aspect-ratio: 2 / 3; overflow: hidden; background: #e9e9e7; }
  .pantao-plist__media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .pantao-plist__info { display: flex; justify-content: space-between; gap: 12px; padding: 8px 10px 24px; font-size: 12px; letter-spacing: 0.02em; }
  .pantao-plist__title { text-transform: uppercase; min-width: 0; }
  .pantao-plist__remove {
    margin: -16px 10px 24px; padding: 0; border: 0; background: none;
    color: rgb(20 20 20 / 0.55); font: inherit; font-size: 11px; letter-spacing: 0.04em;
    text-transform: uppercase; text-decoration: underline; text-underline-offset: 3px;
  }
  .pantao-plist__remove:hover { color: #141414; }
  .pantao-plist__empty { padding: 0 40px; font-size: 12px; color: rgb(20 20 20 / 0.6); }
  .pantao-plist__empty a { color: inherit; }
  @media screen and (max-width: 749px) {
    .pantao-plist-wrap { padding: 36px 0 48px; }
    .pantao-plist__head, .pantao-plist__empty { padding-inline: 16px; }
    .pantao-plist { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .pantao-plist__info { flex-direction: column; gap: 1px; padding: 4px 9px 22px; font-size: 10px; letter-spacing: 0.04em; }
  }
</style>

<script>
  (() => {
    if (window.PantaoSaved) return;
    const KEY_SAVED = 'pantao:saved';
    const KEY_VIEWED = 'pantao:viewed';
    const read = (k) => {
      try { const v = JSON.parse(localStorage.getItem(k) || '[]'); return Array.isArray(v) ? v : []; } catch (e) { return []; }
    };
    const write = (k, v) => { try { localStorage.setItem(k, JSON.stringify(v)); } catch (e) {} };
    const root = (window.Shopify && Shopify.routes && Shopify.routes.root) || '/';
    const SIGNED_IN = {% if customer %}true{% else %}false{% endif %};
    const LOGIN_URL = {{ routes.account_login_url | json }};
    const SAVED_URL = '/pages/saved';

    let toastEl, toastTimer;
    const toast = (saved) => {
      if (!toastEl) {
        toastEl = document.createElement('div');
        toastEl.className = 'pantao-toast';
        toastEl.setAttribute('role', 'status');
        toastEl.setAttribute('aria-live', 'polite');
        document.body.appendChild(toastEl);
        toastEl.addEventListener('click', (e) => { if (e.target.closest('.pantao-toast__close')) hide(); });
      }
      const close = '<button type="button" class="pantao-toast__close" aria-label="Close"><svg viewBox="0 0 12 12" aria-hidden="true"><path d="M1 1l10 10M11 1 1 11" stroke="currentColor" stroke-width="1.2"/></svg></button>';
      if (!saved) {
        toastEl.innerHTML = close + '<p class="pantao-toast__title">Removed from saved</p>';
      } else if (SIGNED_IN) {
        toastEl.innerHTML = close + '<p class="pantao-toast__title">Saved</p><p class="pantao-toast__body">This piece is in your saved items.</p><div class="pantao-toast__actions"><a href="' + SAVED_URL + '">View saved</a></div>';
      } else {
        toastEl.innerHTML = close + '<p class="pantao-toast__title">Saved temporarily</p><p class="pantao-toast__body">You\u2019re not signed in, so this is only saved on this device for now. Sign in so you don\u2019t lose it.</p><div class="pantao-toast__actions"><a href="' + LOGIN_URL + '">Sign in</a><a href="' + SAVED_URL + '">View saved</a></div>';
      }
      requestAnimationFrame(() => toastEl.classList.add('is-open'));
      clearTimeout(toastTimer);
      toastTimer = setTimeout(hide, saved && !SIGNED_IN ? 8000 : 4000);
    };
    const hide = () => { if (toastEl) toastEl.classList.remove('is-open'); };

    const api = {
      saved: () => read(KEY_SAVED),
      isSaved: (h) => read(KEY_SAVED).includes(h),
      toggle(h) {
        let list = read(KEY_SAVED);
        const adding = !list.includes(h);
        list = adding ? [h, ...list] : list.filter((x) => x !== h);
        toast(adding);
        write(KEY_SAVED, list.slice(0, 60));
        api.sync();
        document.dispatchEvent(new CustomEvent('pantao:saved-change'));
      },
      remove(h) { write(KEY_SAVED, read(KEY_SAVED).filter((x) => x !== h)); },
      viewed: () => read(KEY_VIEWED),
      addViewed(h) {
        if (!h) return;
        write(KEY_VIEWED, [h, ...read(KEY_VIEWED).filter((x) => x !== h)].slice(0, 12));
      },
      sync() {
        const list = read(KEY_SAVED);
        document.querySelectorAll('[data-pantao-save]').forEach((b) => {
          const on = list.includes(b.dataset.pantaoSave);
          b.setAttribute('aria-pressed', on ? 'true' : 'false');
          const t = (b.getAttribute('aria-label') || '').replace(/^(Save|Remove) /, '');
          b.setAttribute('aria-label', (on ? 'Remove ' : 'Save ') + t);
        });
        document.querySelectorAll('[data-pantao-saved-count]').forEach((n) => { n.textContent = list.length; });
        document.querySelectorAll('[data-pantao-saved-link]').forEach((a) => { a.hidden = list.length === 0; });
      },
    };
    window.PantaoSaved = api;

    document.addEventListener('click', (e) => {
      const r = e.target.closest('[data-pantao-remove]');
      if (r) {
        e.preventDefault();
        api.remove(r.dataset.pantaoRemove);
        api.sync();
        document.dispatchEvent(new CustomEvent('pantao:saved-change'));
        return;
      }
      const b = e.target.closest('[data-pantao-save]');
      if (!b) return;
      e.preventDefault();
      e.stopPropagation();
      api.toggle(b.dataset.pantaoSave);
    }, true);

    // Keep hearts right after the theme swaps HTML (filters, sorting, variant changes).
    let t;
    new MutationObserver(() => { clearTimeout(t); t = setTimeout(api.sync, 60); })
      .observe(document.documentElement, { childList: true, subtree: true });
    window.addEventListener('storage', api.sync);
    document.addEventListener('DOMContentLoaded', api.sync);
    api.sync();

    const money = (cents, currency) => {
      const whole = cents % 100 === 0;
      try {
        return new Intl.NumberFormat(document.documentElement.lang || 'en', {
          style: 'currency', currency: currency || 'USD',
          minimumFractionDigits: whole ? 0 : 2, maximumFractionDigits: whole ? 0 : 2,
        }).format(cents / 100);
      } catch (e) { return '$' + (cents / 100).toFixed(whole ? 0 : 2); }
    };
    const esc = (s) => String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    const img = (src, w) => {
      if (!src) return '';
      const u = src.startsWith('//') ? 'https:' + src : src;
      return u + (u.includes('?') ? '&' : '?') + 'width=' + w;
    };

    class PantaoProductList extends HTMLElement {
      async connectedCallback() {
        if (this._done) return;
        this._done = true;
        this.wrap = this.closest('.pantao-plist-wrap') || this;
        document.addEventListener('pantao:saved-change', () => {
          if (this.dataset.source === 'saved') this.render();
        });
        this.render();
      }
      async recommended(exclude, limit) {
        const seen = new Set([exclude]);
        const out = [];
        const add = (list) => list.forEach((p) => { if (p && !seen.has(p.handle) && out.length < limit) { seen.add(p.handle); out.push(p); } });
        try {
          const r = await fetch(root + 'recommendations/products.json?product_id=' + this.dataset.productId + '&limit=' + (limit + 2) + '&intent=related');
          if (r.ok) add(((await r.json()).products || []).filter((p) => p.available));
        } catch (e) {}
        // Top up from the piece's own collection, then the whole catalog.
        for (const src of [this.dataset.collection, 'all']) {
          if (out.length >= limit || !src) continue;
          try {
            const r = await fetch(root + 'collections/' + src + '/products.json?limit=12');
            if (!r.ok) continue;
            const list = ((await r.json()).products || []).map((p) => ({
              handle: p.handle,
              title: p.title,
              url: root + 'products/' + p.handle,
              available: p.variants.some((v) => v.available),
              price: Math.round(parseFloat(p.variants[0].price) * 100),
              featured_image: p.images[0] && p.images[0].src,
            }));
            add(list.filter((p) => p.available));
          } catch (e) {}
        }
        return out;
      }
      async render() {
        const source = this.dataset.source;
        const exclude = this.dataset.exclude;
        const limit = Number(this.dataset.limit) || 60;
        const count = this.wrap.querySelector('[data-pantao-list-count]');
        const empty = this.wrap.querySelector('[data-pantao-list-empty]');
        let products = [];
        if (source === 'recommended') {
          products = await this.recommended(exclude, limit);
        } else {
          const handles = (source === 'saved' ? api.saved() : api.viewed()).filter((h) => h !== exclude).slice(0, limit);
          const results = await Promise.all(handles.map(async (h) => {
            try {
              const r = await fetch(root + 'products/' + encodeURIComponent(h) + '.js', { headers: { Accept: 'application/json' } });
              if (!r.ok) { if (source === 'saved' && r.status === 404) api.remove(h); return null; }
              return await r.json();
            } catch (e) { return null; }
          }));
          products = results.filter(Boolean);
        }
        const currency = window.Shopify && Shopify.currency && Shopify.currency.active;
        this.innerHTML = products.length
          ? '<ul class="pantao-plist">' + products.map((p) => `
              <li class="pantao-plist__item">
                <a href="${esc(p.url)}">
                  <div class="pantao-plist__media">
                    ${p.featured_image ? `<img src="${esc(img(p.featured_image, 720))}" srcset="${esc(img(p.featured_image, 480))} 480w, ${esc(img(p.featured_image, 720))} 720w, ${esc(img(p.featured_image, 1080))} 1080w" sizes="(max-width: 749px) 50vw, 25vw" alt="${esc(p.title)}" loading="lazy">` : ''}
                  </div>
                  <div class="pantao-plist__info">
                    <span class="pantao-plist__title">${esc(p.title)}</span>
                    <span>${p.available ? money(p.price, currency) : 'Sold out'}</span>
                  </div>
                </a>
                ${source === 'saved' ? `<button type="button" class="pantao-plist__remove" data-pantao-remove="${esc(p.handle)}">Remove</button>` : ''}
              </li>`).join('') + '</ul>'
          : '';
        if (count) count.textContent = products.length + (products.length === 1 ? ' item' : ' items');
        if (empty) empty.hidden = products.length > 0;
        if (this.dataset.hideWhenEmpty !== undefined) this.wrap.hidden = products.length === 0;
        api.sync();
      }
    }
    customElements.define('pantao-product-list', PantaoProductList);
  })();
</script>
