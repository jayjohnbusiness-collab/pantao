{%- comment -%}
  PANTAO collection styles
  ----------------------------------------------------------------
  Re-skins the theme's NATIVE product card and horizontal filter bar into
  the PANTAO look, without touching their markup or JavaScript — so real
  faceting, sorting, the column switcher, cart/variant handling all keep
  working. Loaded once from the layout; every selector is scoped to the
  theme's own classes, inert where those elements aren't present.

  Robustness notes:
  - Scoped to .product-card / .facets so it can't leak onto other UI.
  - Uses theme design tokens (--color-foreground, --style-border-radius-*,
    --font-*), falling back to literals where a token may be absent.
{%- endcomment -%}
<style>
  /* ============================================================
     PRODUCT CARD — rounded media, hover zoom, refined type
     ============================================================ */
  .product-card { --pantao-card-radius: 0px; }

  /* Acne-style listing: edge-to-edge 4-up grid, no gaps, tall 2:3 images,
     small caps name left / price right under the image. */
  .product-grid .card-gallery { --gallery-aspect-ratio: 2 / 3 !important; }
  @media screen and (min-width: 990px) {
    .product-grid--grid:not([product-grid-view='zoom-out']) {
      --product-grid-columns-desktop: repeat(4, minmax(0, 1fr)) !important;
    }
  }
  .product-grid .product-card .product-title,
  .product-grid .product-card [class*="product-title"],
  .product-grid .product-card .price,
  .product-grid .product-card [class*="price"] {
    font-size: 12px !important;
    font-weight: 400;
    letter-spacing: 0.02em;
  }
  .product-grid .product-card__content > .group-block { padding: 8px 10px 24px !important; }
  /* Card captions (Acne): small caps name, price in plain small type. */
  .product-grid .product-card .text-block[class*='product_title'],
  .product-grid .product-card .text-block[class*='product_title'] *,
  .product-grid .product-card product-price,
  .product-grid .product-card product-price * {
    font-size: 12px !important;
    font-weight: 400 !important;
    line-height: 1.35 !important;
    letter-spacing: 0.02em;
  }
  .product-grid .product-card .text-block[class*='product_title'] * { text-transform: uppercase; }

  @media screen and (max-width: 749px) {
    /* Phones, as on Acne: name on top, price right under it, both left-aligned,
       full card width so names don't wrap into a narrow column. */
    .product-grid .product-card__content > .group-block { padding: 8px 10px 22px !important; }
    .product-grid .product-card__content > .group-block > .group-block-content {
      flex-direction: column !important;
      align-items: flex-start !important;
      justify-content: flex-start !important;
      gap: 3px !important;
    }
    .product-grid .product-card__content > .group-block > .group-block-content > .group-block {
      width: 100% !important;
      max-width: 100% !important;
      --size-style-width-mobile: 100% !important;
    }
    .product-grid .product-card__content > .group-block > .group-block-content > .group-block > .group-block-content {
      align-items: flex-start !important;
    }
    .product-grid .product-card product-price,
    .product-grid .product-card product-price * { text-align: left !important; justify-content: flex-start !important; }
    .product-grid .product-card .text-block[class*='product_title'],
    .product-grid .product-card .text-block[class*='product_title'] *,
    .product-grid .product-card product-price,
    .product-grid .product-card product-price *, .product-grid .product-card product-price .price { font-size: 11px !important; }
  }

  /* Round the media frame and clip the image to it. */
  .product-card .card-gallery {
    border-radius: var(--pantao-card-radius);
    overflow: hidden;
  }

  /* Subtle hover zoom on the product image (desktop pointer only). */
  @media (hover: hover) {
    .product-card .card-gallery img {
      transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
      will-change: transform;
    }
    .product-card:hover .card-gallery img {
      transform: scale(1.04);
    }
  }

  /* Typography: quiet, editorial. Title left, price right on one line, same ink (Acne-style). */
  .product-card .product-title,
  .product-card [class*="product-title"] {
    font-family: var(--font-body--family);
    font-weight: 500;
    letter-spacing: 0.01em;
  }
  .product-card .price,
  .product-card [class*="price"] {
    color: rgb(var(--color-foreground-rgb));
  }

  /* In-stock pieces first: sold-out cards move to the end of the grid. */
  .product-grid__item:has(.pantao-soldout-flag) { order: 1; }

  @media (prefers-reduced-motion: reduce) {
    .product-card .card-gallery img,
    .product-card:hover .card-gallery img { transition: none; transform: none; }
  }

  /* ============================================================
     STOCK INDICATOR — pulsing "live" dot over the piece
     (markup from the pantao-stock snippet). In stock + limited,
     tightening to "Only N left", calm "Sold out" when gone.
     ============================================================ */
  /* container-type makes each card a query container so the pill can adapt
     to the card's own width (e.g. the denser grid-density / zoom-out view). */
  .product-card { position: relative; container: pantao-card / inline-size; }
  .pantao-stock {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 6;
    pointer-events: none;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    max-width: calc(100% - 20px);
    padding: 6px 11px 6px 10px;
    border-radius: 100px;
    background: rgba(10, 11, 13, 0.52);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(245, 244, 241, 0.18);
    color: #f5f4f1;
    font-family: var(--font-body--family, -apple-system, system-ui, sans-serif);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    line-height: 1;
  }
  /* label truncates within the card rather than spilling; the dot never clips
     (no overflow on the pill itself, so the pulse ring stays intact). */
  .pantao-stock__label {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .pantao-stock__dot {
    position: relative;
    flex: none;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #35b46b;
  }
  /* Narrow cards (dense grid): shrink the pill; tiniest cards go dot-only. */
  @container pantao-card (max-width: 250px) {
    .pantao-stock { top: 8px; left: 8px; gap: 5px; padding: 5px 9px 5px 8px; font-size: 9px; letter-spacing: 0.08em; }
  }
  @container pantao-card (max-width: 180px) {
    .pantao-stock { padding: 6px; gap: 0; }
    .pantao-stock__label { display: none; }
  }
  .pantao-stock.is-low .pantao-stock__dot { background: #e0b341; }
  .pantao-stock.is-out { background: rgba(10, 11, 13, 0.46); color: rgba(245, 244, 241, 0.72); }
  .pantao-stock.is-out .pantao-stock__dot { background: #9aa0a6; }

  /* the pulse ring — only for live / low states */
  .pantao-stock.is-live .pantao-stock__dot::after,
  .pantao-stock.is-low .pantao-stock__dot::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: inherit;
    animation: pantao-pulse 1.9s cubic-bezier(0.22, 1, 0.36, 1) infinite;
  }
  @keyframes pantao-pulse {
    0%   { transform: scale(1); opacity: 0.55; }
    70%  { transform: scale(3); opacity: 0; }
    100% { transform: scale(3); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pantao-stock__dot::after { animation: none; }
  }

  /* ============================================================
     FILTER BAR — re-skin the native horizontal facets into pills
     (real faceting/AJAX is the theme's; we only restyle).
     The horizontal filters are slotted into an <overflow-list>
     shadow root, so the row gap is set via ::part(list).
     ============================================================ */
  @media screen and (min-width: 750px) {
    /* Each filter (Size / Length / Color / Sort) trigger -> pill */
    .facets--horizontal .facets__summary {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 9px 16px;
      border: 1px solid color-mix(in srgb, currentColor 22%, transparent);
      border-radius: 100px;
      line-height: 1;
      cursor: pointer;
      white-space: nowrap;
      list-style: none;
      transition: border-color 0.3s ease, background-color 0.3s ease;
    }
    .facets--horizontal .facets__summary::-webkit-details-marker { display: none; }
    .facets--horizontal .facets__summary:hover {
      border-color: color-mix(in srgb, currentColor 48%, transparent);
      background: color-mix(in srgb, currentColor 5%, transparent);
    }
    /* Open panel = emphasized pill */
    .facets--horizontal .facets__panel[open] > .facets__summary {
      border-color: currentColor;
      background: color-mix(in srgb, currentColor 6%, transparent);
    }
    .facets--horizontal .facets__label {
      font-family: var(--font-body--family);
      font-size: 12px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    /* Row gap between the slotted filter pills (shadow container). */
    .facets--horizontal .facets__overflow-list::part(list) {
      gap: 10px;
      align-items: center;
    }

    /* Clear-all reads as a quiet inline link, not a pill. */
    .facets__clear-all-link--horizontal {
      font-family: var(--font-body--family);
      font-size: 11px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      opacity: 0.6;
      text-decoration: underline;
      text-underline-offset: 3px;
      transition: opacity 0.25s ease;
    }
    .facets__clear-all-link--horizontal:hover { opacity: 1; }

    /* Products count — muted, spaced. */
    .facets--horizontal .products-count-wrapper {
      font-family: var(--font-body--family);
      font-size: 11px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--color-foreground-muted, rgb(var(--color-foreground-rgb) / 0.55));
    }
  }

  /* Column-count switcher -> segmented pill control (all viewports). */
  .column-options {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    padding: 3px;
    border: 0;
    margin: 0;
    border-radius: 100px;
    background: color-mix(in srgb, currentColor 8%, transparent);
  }
  .column-options__option {
    display: inline-flex;
    margin: 0;
    cursor: pointer;
  }
  .column-options .column-picker {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 6px 9px;
    border-radius: 100px;
    opacity: 0.5;
    transition: background-color 0.25s ease, opacity 0.25s ease, box-shadow 0.25s ease;
  }
  .column-options__option:hover .column-picker { opacity: 0.85; }
  .column-options__option:has(.column-options__option-input:checked) .column-picker {
    background: var(--color-background, #fff);
    opacity: 1;
    box-shadow: 0 2px 6px color-mix(in srgb, currentColor 14%, transparent);
  }

  /* Softer popover for the open filter value list. */
  .facets--horizontal .facets__inputs {
    border-radius: var(--style-border-radius-lg, 14px);
    border: 1px solid var(--color-border, color-mix(in srgb, currentColor 14%, transparent));
  }
</style>
