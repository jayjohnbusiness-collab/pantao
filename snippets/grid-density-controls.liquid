{%- doc -%}
  Renders the grid density controls.

  @param {string} viewport - The viewport to render the controls for, either 'mobile' or 'desktop'.

  @example
  {% render 'grid-density-controls', viewport: 'desktop' %}
{%- enddoc -%}

<div class="column-options-wrapper">
  <fieldset class="column-options">
    <legend class="column-options__legend visually-hidden">
      {{ 'content.grid_view.grid_fieldset' | t }}
    </legend>

    {% if viewport == 'mobile' %}
      <label class="column-options__option">
        <input
          type="radio"
          name="grid-mobile"
          value="mobile-single"
          class="column-options__option-input"
          aria-label="{{ 'content.grid_view.single_item' | t }}"
          on:change="results-list/updateLayout"
        >
        <span class="column-picker column-picker-mobile--single">
          {{- 'icon-one-col-mobile.svg' | inline_asset_content -}}
        </span>
      </label>

      <label class="column-options__option">
        <input
          type="radio"
          class="column-options__option-input"
          name="grid-mobile"
          value="default"
          checked
          aria-label="{{ 'content.grid_view.default_view' | t }}"
          data-grid-layout="mobile-option"
          on:change="results-list/updateLayout"
        >
        <span class="column-picker column-picker-mobile--double">
          {{- 'icon-grid-default.svg' | inline_asset_content -}}
        </span>
      </label>

    {% elsif viewport == 'desktop' %}
      {%- comment -%}
        Single toggle button: one click sets the large card view, clicking
        again switches to the smaller (dense) view. The two radios below are
        kept but visually hidden so the theme's native layout plumbing keeps
        working — the view-transition animation and sessionStorage persistence
        (results-list/updateLayout), the restore-on-load script, and the
        media-query reset handler all still target these inputs by name.
      {%- endcomment -%}
      <span class="column-options__radios visually-hidden" aria-hidden="true">
        <input
          type="radio"
          name="grid"
          value="default"
          checked
          tabindex="-1"
          data-grid-layout="desktop-default-option"
          on:change="results-list/updateLayout"
          data-skip-node-update
        >
        <input
          type="radio"
          name="grid"
          value="zoom-out"
          tabindex="-1"
          on:change="results-list/updateLayout"
          data-skip-node-update
        >
      </span>

      <button
        type="button"
        class="column-switch"
        data-grid-toggle
        data-view="default"
        role="switch"
        aria-checked="false"
        aria-label="{{ 'content.grid_view.grid_fieldset' | t }}"
      >
        <span class="column-switch__thumb" aria-hidden="true"></span>
        <span class="column-switch__icon column-switch__icon--default">
          {{- 'icon-grid-default.svg' | inline_asset_content -}}
        </span>
        <span class="column-switch__icon column-switch__icon--zoom-out">
          {{- 'icon-grid-dense.svg' | inline_asset_content -}}
        </span>
      </button>
    {% endif %}
  </fieldset>
</div>

{%- comment -%} Wire the single toggle button to the hidden radios. {%- endcomment -%}
<script>
  (() => {
    if (window.__pantaoGridToggle) return;
    window.__pantaoGridToggle = true;

    const getGrid = (btn) =>
      btn.closest('results-list')?.querySelector('.product-grid') ||
      document.querySelector('.product-grid');

    const getRadios = (btn) => {
      const wrap = btn.closest('.column-options-wrapper');
      return {
        def: wrap?.querySelector('input[name="grid"][value="default"]'),
        zoom: wrap?.querySelector('input[name="grid"][value="zoom-out"]'),
      };
    };

    const currentView = (grid) => grid?.getAttribute('product-grid-view') || 'default';

    const syncButton = (btn, grid) => {
      const isZoom = currentView(grid) === 'zoom-out';
      btn.dataset.view = isZoom ? 'zoom-out' : 'default';
      btn.setAttribute('aria-checked', isZoom ? 'true' : 'false');
    };

    // Click flips to the other view through the hidden radios so the native
    // animation + persistence run exactly as they do for the stock control.
    document.addEventListener('click', (event) => {
      const btn = event.target.closest?.('[data-grid-toggle]');
      if (!btn) return;
      event.preventDefault();

      const grid = getGrid(btn);
      const { def, zoom } = getRadios(btn);
      if (!grid || !def || !zoom) return;

      const goingZoom = currentView(grid) !== 'zoom-out';
      const nextView = goingZoom ? 'zoom-out' : 'default';
      const target = goingZoom ? zoom : def;
      target.checked = true;
      target.dispatchEvent(new Event('change', { bubbles: true }));

      // Optimistic thumb slide; the observer confirms once the view applies.
      btn.dataset.view = nextView;
      btn.setAttribute('aria-checked', goingZoom ? 'true' : 'false');

      // Safety net: if the native handler didn't apply the view, set it here.
      setTimeout(() => {
        if (currentView(grid) === nextView) return;
        grid.setAttribute('product-grid-view', nextView);
        try {
          const viewport = window.matchMedia('(min-width: 750px)').matches ? 'desktop' : 'mobile';
          sessionStorage.setItem(`product-grid-view-${viewport}`, nextView);
        } catch (e) {
          /* sessionStorage may be unavailable */
        }
      }, 120);
    });

    // Keep every toggle's icon in step with the grid, however the view changes
    // (toggle, restore-on-load, or the media-query reset to default).
    const wire = () => {
      document.querySelectorAll('[data-grid-toggle]').forEach((btn) => {
        const grid = getGrid(btn);
        if (!grid) return;
        syncButton(btn, grid);
        if (btn.__gridObserved) return;
        btn.__gridObserved = true;
        new MutationObserver(() => syncButton(btn, grid)).observe(grid, {
          attributes: true,
          attributeFilter: ['product-grid-view'],
        });
      });
    };

    if (document.readyState !== 'loading') wire();
    else document.addEventListener('DOMContentLoaded', wire);
    document.addEventListener('shopify:section:load', wire);
  })();
</script>

{% stylesheet %}
  .column-options-wrapper {
    --icon-offset: -3px;

    display: flex;
    gap: var(--gap-sm);
    min-width: fit-content;
    justify-content: flex-end;
    height: var(--minimum-touch-target);
    align-items: center;
    margin-right: var(--icon-offset);
  }

  .column-options-wrapper:only-child {
    margin-left: auto;
  }

  .facets__form-wrapper > .column-options-wrapper:first-child {
    margin-left: auto;
  }

  .facets .column-options-wrapper {
    display: none;

    @media screen and (min-width: 750px) {
      display: flex;
    }
  }

  .column-options {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-xs);
    margin: 0;
    padding: 0;
    border: none;

    @media screen and (min-width: 750px) {
      gap: var(--gap-2xs);
    }
  }

  .column-options__option {
    display: none;
    position: relative;
  }

  .column-options__option:has(.column-picker-mobile--single),
  .column-options__option:has(.column-picker-mobile--double) {
    @media screen and (max-width: 749px) {
      display: flex;
    }
  }

  .column-options__option:has(.column-picker--default),
  .column-options__option:has(.column-picker--zoom-out) {
    @media screen and (min-width: 750px) {
      display: flex;
    }
  }

  /* Override base rule for grid density controls - only when visible */
  .column-options-wrapper .column-options__option:has(input[type="radio"]):has(.column-picker-mobile--single),
  .column-options-wrapper .column-options__option:has(input[type="radio"]):has(.column-picker-mobile--double) {
    @media screen and (max-width: 749px) {
      display: flex;
    }
  }

  .column-options-wrapper .column-options__option:has(input[type="radio"]):has(.column-picker--default),
  .column-options-wrapper .column-options__option:has(input[type="radio"]):has(.column-picker--zoom-out) {
    @media screen and (min-width: 750px) {
      display: flex;
    }
  }

  .column-options__legend {
    padding: 0;
    margin: 0;
  }

  .column-options__option-input {
    /* this is a repeating pattern a bit with the variant picker buttons */

    /* remove the checkbox from the page flow */
    position: absolute;

    /* set the dimensions to match those of the label */
    inset: 0;

    /* hide it */
    opacity: 0;
    margin: 0;
    padding: 0;
    width: auto;
    height: auto;
    aspect-ratio: unset;
    border: none;
    border-radius: 0;
    background: transparent;
    appearance: auto;
    display: block;
    cursor: pointer;
  }

  .column-picker {
    color: rgb(var(--color-foreground-rgb) / var(--opacity-50));
    padding: var(--padding-2xs);
    border-radius: var(--style-border-radius-xs);
    transition: background-color var(--animation-speed) ease, color var(--animation-speed) ease;
  }

  .column-options__option:hover .column-picker {
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-5));
  }

  .column-options__option-input:checked ~ .column-picker {
    color: rgb(var(--color-foreground-rgb));
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-5));
  }

  /* Grid-density switch (desktop): keeps the theme's original colours
     (dark icon on a faint highlight) but slides the highlight between the
     two icons instead of snapping it. */
  .column-switch {
    --switch-cell: calc(1rem + var(--padding-2xs) * 2);

    display: none;
    position: relative;
    align-items: center;
    gap: 0;
    padding: 0;
    background: transparent;
    border: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  @media screen and (min-width: 750px) {
    .column-switch {
      display: inline-flex;
    }
  }

  .column-switch:focus-visible {
    outline: 2px solid rgb(var(--color-foreground-rgb));
    outline-offset: 2px;
    border-radius: var(--style-border-radius-xs);
  }

  /* The sliding highlight matches the theme's original checked background. */
  .column-switch__thumb {
    position: absolute;
    top: 0;
    left: 0;
    width: var(--switch-cell);
    height: 100%;
    border-radius: var(--style-border-radius-xs);
    background: rgb(var(--color-foreground-rgb) / var(--opacity-5));
    transform: translateX(0);
    transition: transform var(--animation-speed) var(--animation-easing, ease);
    z-index: 0;
  }

  .column-switch[data-view='zoom-out'] .column-switch__thumb {
    transform: translateX(100%);
  }

  .column-switch__icon {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--switch-cell);
    height: var(--switch-cell);
    padding: 0;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-50));
    transition: color var(--animation-speed) ease;
  }

  .column-switch__icon svg {
    display: block;
    width: 1rem;
    height: 1rem;
  }

  /* Active icon uses full foreground, exactly like the original control. */
  .column-switch[data-view='default'] .column-switch__icon--default,
  .column-switch[data-view='zoom-out'] .column-switch__icon--zoom-out {
    color: rgb(var(--color-foreground-rgb));
  }

  @media (prefers-reduced-motion: reduce) {
    .column-switch__thumb {
      transition: none;
    }
  }
{% endstylesheet %}
