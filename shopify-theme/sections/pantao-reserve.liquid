{%- comment -%}
  PANTAO Reserve — native contact-form reservation page
  ----------------------------------------------------------------
  Renders a reservation form via Shopify's native {% form 'contact' %},
  so submissions email the store contact address. Custom contact[...] fields
  (Event, Session, Preference, Guests, Edition order no., Consent) are
  included in the notification email. On success Shopify re-renders with
  form.posted_successfully? and we show the confirmation. Styled to match
  the house design language using theme tokens.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
-%}

<div class="pantao-reserve" data-section-id="{{ section.id }}">
  <div class="pantao-reserve__wrap">
    {%- if s.back_url != blank -%}<a class="pantao-reserve__back" href="{{ s.back_url }}">&larr; {{ s.back_label | default: 'Back to events' }}</a>{%- endif -%}

    <div class="pantao-reserve__grid">
      <div class="pantao-reserve__intro">
        {%- if s.eyebrow != blank -%}<p class="pantao-reserve__eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
        {%- if s.title != blank -%}<h1 class="pantao-reserve__title">{{ s.title }}</h1>{%- endif -%}
        {%- if s.intro != blank -%}<div class="pantao-reserve__lead">{{ s.intro }}</div>{%- endif -%}
        {%- if s.event_name != blank or s.date != blank or s.location != blank or s.spots != blank -%}
          <div class="pantao-reserve__summary">
            {%- if s.event_name != blank -%}<div><span>Event</span><span>{{ s.event_name | escape }}</span></div>{%- endif -%}
            {%- if s.date != blank -%}<div><span>Date</span><span>{{ s.date | escape }}</span></div>{%- endif -%}
            {%- if s.location != blank -%}<div><span>Where</span><span>{{ s.location | escape }}</span></div>{%- endif -%}
            {%- if s.spots != blank -%}<div><span>Spots</span><span>{{ s.spots | escape }}</span></div>{%- endif -%}
          </div>
        {%- endif -%}
      </div>

      <div class="pantao-reserve__card">
        {%- form 'contact', id: 'reserve-form', class: 'pantao-reserve__form' -%}
          {%- if form.posted_successfully? -%}
            <div class="pantao-reserve__success">
              <div class="pantao-reserve__check" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M4 12.5l5 5L20 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </div>
              <h3>{{ s.success_heading | default: "You're on the list." }}</h3>
              <p>{{ s.success_text | default: "We'll confirm your spot by email — spots are released in the order requested. Watch for a note from Manila." }}</p>
            </div>
          {%- else -%}
            {%- if form.errors -%}
              <p class="pantao-reserve__err" role="alert">{{ form.errors | default_errors }}</p>
            {%- endif -%}

            <input type="hidden" name="contact[Event]" value="{{ s.event_name | escape }}">

            <div class="fld"><label for="rv-name">Full name</label><input id="rv-name" name="contact[name]" type="text" required autocomplete="name"></div>
            <div class="fld--row">
              <div class="fld"><label for="rv-email">Email</label><input id="rv-email" name="contact[email]" type="email" required autocomplete="email"></div>
              <div class="fld"><label for="rv-phone">Phone</label><input id="rv-phone" name="contact[phone]" type="tel" autocomplete="tel"></div>
            </div>
            <div class="fld--row">
              <div class="fld"><label for="rv-session">Session</label>
                <select id="rv-session" name="contact[Session]"><option>Morning (07:00)</option><option>Midday (11:00)</option></select>
              </div>
              <div class="fld"><label for="rv-pref">Preference</label>
                <select id="rv-pref" name="contact[Preference]"><option>I'll drive</option><option>I'll be driven</option></select>
              </div>
            </div>
            <div class="fld--row">
              <div class="fld"><label for="rv-guests">Guests (max 1)</label>
                <select id="rv-guests" name="contact[Guests]"><option>0</option><option>1</option></select>
              </div>
              <div class="fld"><label for="rv-order">Edition order no.</label><input id="rv-order" name="contact[Edition order no.]" type="text" placeholder="Optional"></div>
            </div>
            <div class="fld"><label for="rv-notes">Notes</label><textarea id="rv-notes" name="contact[body]" placeholder="Anything we should know."></textarea></div>
            <label class="pantao-reserve__consent"><input type="checkbox" name="contact[Consent]" value="Understood" required> I understand spots are limited and my place is confirmed by email.</label>
            <button type="submit" class="pantao-reserve__submit">Request your spot</button>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>
  </div>
</div>

<style>
  #shopify-section-{{ section.id }} { margin: 0; }
  .pantao-reserve{
    --rv-ink:var(--color-foreground,#16181c);
    --rv-ground:color-mix(in srgb, var(--color-foreground,#16181c) 4%, var(--color-background,#f4f4f2));
    --rv-card:var(--color-background,#f4f4f2);
    --rv-muted:color-mix(in srgb, var(--color-foreground,#16181c) 52%, transparent);
    --rv-line:color-mix(in srgb, var(--color-foreground,#16181c) 12%, transparent);
    --rv-serif:var(--font-accent--family,Georgia,serif);
    --rv-sans:var(--font-body--family,-apple-system,system-ui,sans-serif);
    --rv-shadow:0 30px 70px color-mix(in srgb, var(--color-foreground,#16181c) 7%, transparent),0 2px 10px color-mix(in srgb, var(--color-foreground,#16181c) 3%, transparent);
    background:var(--rv-ground);color:var(--rv-ink);font-family:var(--rv-sans);
  }
  .pantao-reserve__wrap{max-width:1200px;margin:0 auto;padding:clamp(36px,6vw,72px) clamp(20px,5vw,64px) clamp(56px,9vw,110px)}
  .pantao-reserve__back{display:inline-flex;align-items:center;gap:8px;font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--rv-muted);margin-bottom:clamp(24px,4vw,40px)}
  .pantao-reserve__back:hover{color:var(--rv-ink)}
  .pantao-reserve__eyebrow{font-size:11px;font-weight:500;letter-spacing:.24em;text-transform:uppercase;color:var(--rv-muted);margin:0}
  .pantao-reserve__grid{display:grid;grid-template-columns:minmax(0,.4fr) minmax(0,.6fr);gap:clamp(28px,5vw,72px);align-items:start}
  @media(max-width:820px){.pantao-reserve__grid{grid-template-columns:1fr;gap:clamp(24px,5vw,36px)}}
  .pantao-reserve__intro .pantao-reserve__eyebrow{margin-bottom:18px}
  .pantao-reserve__title{font-family:var(--rv-serif);font-weight:500;font-size:clamp(2.2rem,4.4vw,3.4rem);line-height:1.02;letter-spacing:-.01em;margin:0 0 18px;text-wrap:balance;overflow-wrap:normal;word-break:normal;hyphens:none}
  .pantao-reserve__lead{color:var(--rv-muted);line-height:1.62;max-width:34ch}
  .pantao-reserve__lead p{margin:0}
  .pantao-reserve__summary{margin-top:clamp(24px,3vw,32px);padding-top:20px;border-top:1px solid var(--rv-line);display:flex;flex-direction:column;gap:9px}
  .pantao-reserve__summary div{display:flex;justify-content:space-between;gap:16px;font-size:13px}
  .pantao-reserve__summary span:first-child{color:var(--rv-muted)}

  .pantao-reserve__card{background:var(--rv-card);border:1px solid var(--rv-line);border-radius:22px;box-shadow:var(--rv-shadow);padding:clamp(26px,4vw,44px)}
  .fld{display:flex;flex-direction:column;gap:8px;margin-bottom:clamp(16px,2vw,22px)}
  .fld label{font-size:11px;font-weight:500;letter-spacing:.14em;text-transform:uppercase;color:var(--rv-muted)}
  .fld input,.fld select,.fld textarea{font-family:var(--rv-sans);font-size:14px;color:var(--rv-ink);background:var(--rv-ground);border:1px solid var(--rv-line);border-radius:12px;padding:13px 14px;outline:none;transition:border-color .25s ease}
  .fld input:focus,.fld select:focus,.fld textarea:focus{border-color:var(--rv-ink)}
  .fld textarea{resize:vertical;min-height:88px}
  .fld--row{display:grid;grid-template-columns:1fr 1fr;gap:16px}
  @media(max-width:480px){.fld--row{grid-template-columns:1fr}}
  .pantao-reserve__consent{display:flex;align-items:flex-start;gap:10px;margin:clamp(10px,1.5vw,16px) 0 clamp(20px,2.5vw,26px);font-size:12px;color:var(--rv-muted);line-height:1.5}
  .pantao-reserve__consent input{margin-top:2px}
  .pantao-reserve__submit{width:100%;justify-content:center;display:inline-flex;align-items:center;gap:.6em;
    font-family:var(--rv-sans);font-size:11px;font-weight:500;letter-spacing:.2em;text-transform:uppercase;cursor:pointer;
    padding:15px 26px;border-radius:100px;border:1px solid var(--rv-ink);background:var(--rv-ink);color:var(--color-background,#f4f4f2);
    transition:background-color .3s,border-color .3s}
  .pantao-reserve__submit:hover{background:var(--manila,#b5271f);border-color:var(--manila,#b5271f)}
  .pantao-reserve__err{color:var(--color-error,#8B0000);font-size:13px;margin:0 0 16px}
  .pantao-reserve__success{text-align:center;padding:clamp(14px,3vw,30px) 0}
  .pantao-reserve__check{width:44px;height:44px;border-radius:50%;border:1px solid var(--rv-line);display:grid;place-items:center;margin:0 auto 22px;color:var(--manila,#b5271f)}
  .pantao-reserve__success h3{font-family:var(--rv-serif);font-weight:500;font-size:clamp(1.5rem,3vw,2rem);margin:0 0 12px}
  .pantao-reserve__success p{color:var(--rv-muted);line-height:1.6;max-width:36ch;margin:0 auto}
</style>

{% schema %}
{
  "name": "PANTAO Reserve",
  "tag": "section",
  "class": "section-wrapper",
  "enabled_on": { "templates": ["page"] },
  "settings": [
    { "type": "url", "id": "back_url", "label": "Back link URL", "info": "e.g. your Events page" },
    { "type": "text", "id": "back_label", "label": "Back link label", "default": "Back to events" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Reserve · Private Track Day" },
    { "type": "text", "id": "title", "label": "Title", "default": "Reserve your spot." },
    { "type": "richtext", "id": "intro", "label": "Intro", "default": "<p>Spots are limited and confirmed by email in the order requested. This holds your place — it isn't final until we write back.</p>" },
    { "type": "header", "content": "Summary" },
    { "type": "text", "id": "event_name", "label": "Event name", "default": "Private Track Day" },
    { "type": "text", "id": "date", "label": "Date", "default": "07 Feb 2026" },
    { "type": "text", "id": "location", "label": "Location", "default": "Clark Int'l Speedway" },
    { "type": "text", "id": "spots", "label": "Spots", "default": "12 · filling" },
    { "type": "header", "content": "Confirmation" },
    { "type": "text", "id": "success_heading", "label": "Success heading", "default": "You're on the list." },
    { "type": "textarea", "id": "success_text", "label": "Success text", "default": "We'll confirm your spot by email — spots are released in the order requested. Watch for a note from Manila." }
  ],
  "presets": [ { "name": "PANTAO Reserve" } ]
}
{% endschema %}
