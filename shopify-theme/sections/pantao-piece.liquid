{%- comment -%}
  Pantao — The Piece
  --------------------------------------------------------
  A single product, presented editorially, with real commerce.

  The layout, copy, and feeling are ours. The buying is the theme's own,
  tested machinery: the `variant-picker` and `buy-buttons` blocks are
  rendered with `closest.product` set to the chosen product, so size
  selection, add-to-bag (opens the cart drawer), and Buy Now (accelerated
  checkout) behave exactly as they do on a product page. Nothing about
  checkout is reinvented here.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign product = s.product
  if product == blank
    assign product = collections.all.products.first
  endif
  assign variant = product.selected_or_first_available_variant
-%}

{% render 'buy-buttons-styles' %}

<div
  class="pantao-piece color-{{ s.color_scheme }} pantao-piece--{{ s.layout }}"
  data-section-id="{{ section.id }}"
>
  <div class="pantao-piece__grid">

    {%- comment -%} ---------- Media ---------- {%- endcomment -%}
    <div class="pantao-piece__media" data-reveal>
      <div class="pantao-piece__frame">
        {%- if product.featured_media -%}
          {{
            product.featured_media
            | image_url: width: 1600
            | image_tag:
              loading: 'lazy',
              widths: '400, 600, 800, 1000, 1200, 1600',
              sizes: '(min-width: 750px) 50vw, 100vw',
              class: 'pantao-piece__img',
              alt: product.title | escape
          }}
          {%- if product.media[1] -%}
            {{
              product.media[1]
              | image_url: width: 1600
              | image_tag:
                loading: 'lazy',
                widths: '400, 600, 800, 1000, 1200, 1600',
                sizes: '(min-width: 750px) 50vw, 100vw',
                class: 'pantao-piece__img pantao-piece__img--alt',
                alt: product.title | escape
            }}
          {%- endif -%}
        {%- else -%}
          <div class="pantao-piece__placeholder">
            {{ 'product-1' | placeholder_svg_tag: 'pantao-piece__placeholder-svg' }}
          </div>
        {%- endif -%}
      </div>
    </div>

    {%- comment -%} ---------- Details ---------- {%- endcomment -%}
    <div class="pantao-piece__details" data-reveal>
      <div class="pantao-piece__inner">

        {%- if s.eyebrow != blank -%}
          <p class="pantao-piece__eyebrow">{{ s.eyebrow | escape }}</p>
        {%- endif -%}

        <h2 class="pantao-piece__name">{{ product.title | default: 'The Piece' }}</h2>

        <p class="pantao-piece__price">
          {%- if product.price_varies -%}
            <span class="pantao-piece__from">From</span> {{ product.price_min | money }}
          {%- else -%}
            {{ product.price | money }}
          {%- endif -%}
        </p>

        {%- if s.story != blank -%}
          <div class="pantao-piece__story rte">{{ s.story }}</div>
        {%- elsif product.description != blank -%}
          <div class="pantao-piece__story rte">{{ product.description }}</div>
        {%- endif -%}

        <div class="pantao-piece__buy">
          {%- comment -%} size / variant selection — theme's own block {%- endcomment -%}
          {% content_for 'block', type: 'variant-picker', id: 'piece-variant-picker', closest.product: product %}

          {%- comment -%} add-to-bag (opens cart drawer) + Buy Now — theme's own block {%- endcomment -%}
          {% content_for 'block', type: 'buy-buttons', id: 'piece-buy-buttons', closest.product: product %}
        </div>

        {%- if s.reassurance != blank -%}
          <p class="pantao-piece__reassurance">{{ s.reassurance | escape }}</p>
        {%- endif -%}

      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .pantao-piece {
    background: var(--color-background);
    color: var(--color-foreground);
    padding: 5rem 1.5rem;
  }

  @media (min-width: 750px) {
    .pantao-piece { padding: 7rem 3rem; }
  }

  @media (min-width: 1200px) {
    .pantao-piece { padding: 8rem 5rem; }
  }

  .pantao-piece__grid {
    max-width: 82rem;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 750px) {
    .pantao-piece__grid {
      grid-template-columns: 1fr 1fr;
      gap: clamp(2.5rem, 6vw, 6rem);
    }
    .pantao-piece--media-right .pantao-piece__media { order: 2; }
  }

  /* ---------- Media ---------- */
  .pantao-piece__frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: var(--color-background-secondary, #ececec);
  }

  .pantao-piece__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 1.2s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.8s ease;
  }

  .pantao-piece__frame:hover .pantao-piece__img {
    transform: scale(1.04);
  }

  /* second image crossfades in on hover, if present */
  .pantao-piece__img--alt {
    opacity: 0;
  }

  .pantao-piece__frame:hover .pantao-piece__img--alt {
    opacity: 1;
  }

  .pantao-piece__placeholder,
  .pantao-piece__placeholder-svg,
  .pantao-piece__placeholder svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ---------- Details ---------- */
  .pantao-piece__inner {
    max-width: 30rem;
  }

  .pantao-piece__eyebrow {
    font-family: var(--font-body--family);
    font-size: var(--font-size--3xs);
    letter-spacing: 0.32em;
    text-transform: uppercase;
    margin: 0 0 1.4rem 0;
    opacity: 0.6;
  }

  .pantao-piece__name {
    font-family: var(--font-accent--family);
    font-style: var(--font-accent--style, normal);
    font-weight: var(--font-accent--weight, 500);
    font-size: clamp(2rem, 3.5vw + 0.5rem, 3.4rem);
    line-height: 1.05;
    margin: 0 0 0.75rem 0;
    text-wrap: balance;
  }

  .pantao-piece__price {
    font-family: var(--font-accent--family);
    font-size: clamp(1.25rem, 1.5vw + 0.5rem, 1.6rem);
    margin: 0 0 1.75rem 0;
    opacity: 0.9;
  }

  .pantao-piece__story {
    font-family: var(--font-body--family);
    font-size: var(--font-size--md);
    line-height: 1.7;
    opacity: 0.82;
    margin-bottom: 2rem;
  }

  .pantao-piece__story p { margin: 0 0 1em 0; }
  .pantao-piece__story p:last-child { margin-bottom: 0; }

  /* give the theme's variant + buy blocks room to breathe */
  .pantao-piece__buy {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-top: 0.5rem;
  }

  .pantao-piece__reassurance {
    font-family: var(--font-body--family);
    font-size: var(--font-size--3xs);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    opacity: 0.5;
    margin: 1.75rem 0 0 0;
  }

  /* ---------- Commerce controls: visible + rounded ---------- */
  .pantao-piece .add-to-cart-button {
    border-radius: 100px;
  }

  .pantao-piece .quantity-selector {
    border-radius: 100px;
    overflow: hidden;
  }

  /* keep the sold-out / disabled button legible (never invisible) */
  .pantao-piece .add-to-cart-button:disabled,
  .pantao-piece .add-to-cart-button[disabled],
  .pantao-piece .add-to-cart-button[aria-disabled='true'] {
    opacity: 1;
    background: rgb(var(--color-foreground-rgb) / 0.12);
    color: var(--color-foreground);
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.22);
    cursor: not-allowed;
  }

  /* ---------- Reveal ---------- */
  .pantao-piece [data-reveal] {
    opacity: 0;
    transform: translateY(1.5rem);
    transition: opacity 0.9s cubic-bezier(0.22, 1, 0.36, 1), transform 0.9s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .pantao-piece [data-reveal].is-visible {
    opacity: 1;
    transform: none;
  }

  .pantao-piece__details[data-reveal] { transition-delay: 0.1s; }

  @media (prefers-reduced-motion: reduce) {
    .pantao-piece [data-reveal] { opacity: 1; transform: none; transition: none; }
    .pantao-piece__img { transition: none; }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    function reveal(root) {
      if (!root || root.dataset.pieceReady === 'true') return;
      root.dataset.pieceReady = 'true';
      var items = root.querySelectorAll('[data-reveal]');
      if (!('IntersectionObserver' in window)) {
        items.forEach(function (el) { el.classList.add('is-visible'); });
        return;
      }
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (en) {
          if (en.isIntersecting) { en.target.classList.add('is-visible'); io.unobserve(en.target); }
        });
      }, { threshold: 0.15, rootMargin: '0px 0px -8% 0px' });
      items.forEach(function (el) { io.observe(el); });
    }
    function initAll() { document.querySelectorAll('.pantao-piece').forEach(reveal); }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAll);
    } else { initAll(); }
    document.addEventListener('shopify:section:load', initAll);
  })();
{% endjavascript %}

{% schema %}
{
  "name": "The piece",
  "tag": "section",
  "class": "section-pantao-piece",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "info": "The single piece featured on the homepage. Leave blank to preview the first product in your catalog."
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Media side",
      "options": [
        { "value": "media-left",  "label": "Left" },
        { "value": "media-right", "label": "Right" }
      ],
      "default": "media-left"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The Piece · Edition V"
    },
    {
      "type": "richtext",
      "id": "story",
      "label": "Story",
      "info": "Overrides the product description here. Leave blank to use the product's own description.",
      "default": "<p>Open-gauge merino, distressed by hand. The openwork is worked deliberately at the wrist and the throat, so a watch reads at the cuff and a chain sits clear at the collarbone. Made in a count we can name.</p>"
    },
    {
      "type": "text",
      "id": "reassurance",
      "label": "Reassurance line",
      "default": "Numbered · limited count · ships worldwide"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "The piece",
      "blocks": {
        "piece-variant-picker": {
          "type": "variant-picker",
          "static": true
        },
        "piece-buy-buttons": {
          "type": "buy-buttons",
          "static": true,
          "blocks": {
            "quantity": {
              "type": "quantity",
              "static": true
            },
            "add-to-cart": {
              "type": "add-to-cart",
              "static": true,
              "settings": {
                "style_class": "button"
              }
            },
            "accelerated-checkout": {
              "type": "accelerated-checkout",
              "static": true
            }
          }
        }
      }
    }
  ]
}
{% endschema %}
