{%- comment -%}
  Footer custom code
  --------------------------------------------------------
  A footer-group-enabled Custom Liquid section: paste raw Liquid/HTML/CSS
  into the "Custom Liquid" field and it renders in the footer. Used to drop
  the Pantao "Ledger" footer in directly from the theme editor, with no
  dependency on GitHub section-group syncing.
{%- endcomment -%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--{{ section.settings.section_width }} spacing-style {% if section.settings.color_scheme != blank %}color-{{ section.settings.color_scheme }}{% endif %}"
  style="{% render 'spacing-style', settings: section.settings %}"
  {{ section.shopify_attributes }}
>
  {{ section.settings.custom_liquid }}
</div>

{% schema %}
{
  "name": "Footer custom code",
  "tag": "div",
  "class": "section-wrapper",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "liquid",
      "id": "custom_liquid",
      "label": "Custom Liquid",
      "info": "Paste the Pantao footer code here."
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding-block-start", "label": "Top", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding-block-end", "label": "Bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 32 }
  ],
  "presets": [
    {
      "name": "Footer custom code",
      "category": "Footer"
    }
  ]
}
{% endschema %}
