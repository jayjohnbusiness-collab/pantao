{%- comment -%}
  Pantao — The Name
  --------------------------------------------------------
  The etymology moment. Establishes that PANTAO is Tagalog — from `tao`,
  a person, a people; pang-tao, "for the people." Centered, quiet, one idea.

  Deliberately constrained, like the dispatch: an eyebrow, the pronunciation,
  a definition, a gloss, and a short body. The restraint is the point.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
-%}

<div
  class="pantao-name color-{{ s.color_scheme }}"
  data-section-id="{{ section.id }}"
>
  <div class="pantao-name__container">

    {%- if s.eyebrow != blank -%}
      <p class="pantao-name__eyebrow">{{ s.eyebrow | escape }}</p>
    {%- endif -%}

    {%- if s.pronunciation != blank -%}
      <p class="pantao-name__pron">{{ s.pronunciation | escape }}</p>
    {%- endif -%}

    {%- if s.definition != blank -%}
      <div class="pantao-name__def rte">{{ s.definition }}</div>
    {%- endif -%}

    {%- if s.gloss != blank -%}
      <p class="pantao-name__gloss">{{ s.gloss | escape }}</p>
    {%- endif -%}

    {%- if s.body != blank -%}
      <div class="pantao-name__body rte">{{ s.body }}</div>
    {%- endif -%}

  </div>
</div>

{% stylesheet %}
  .pantao-name {
    background: var(--color-background);
    color: var(--color-foreground);
    padding: 6rem 1.5rem;
  }

  @media (min-width: 750px) {
    .pantao-name {
      padding: 9rem 3rem;
    }
  }

  @media (min-width: 1200px) {
    .pantao-name {
      padding: 11rem 5rem;
    }
  }

  .pantao-name__container {
    max-width: 46rem;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .pantao-name__eyebrow {
    font-family: var(--font-body--family);
    font-size: var(--font-size--3xs);
    letter-spacing: 0.32em;
    text-transform: uppercase;
    margin: 0;
    opacity: 0.6;
  }

  .pantao-name__pron {
    font-family: var(--font-heading--family);
    font-style: italic;
    font-weight: var(--font-heading--weight);
    font-size: clamp(2.5rem, 6vw + 1rem, 5.5rem);
    line-height: 1;
    margin: 1.4rem 0 1.6rem 0;
    text-wrap: balance;
  }

  .pantao-name__def {
    font-family: var(--font-heading--family);
    font-size: clamp(1.35rem, 2.2vw + 0.6rem, 2.25rem);
    line-height: 1.3;
    max-width: 34rem;
    text-wrap: balance;
  }

  .pantao-name__def p {
    margin: 0;
  }

  .pantao-name__def em {
    font-style: italic;
  }

  .pantao-name__gloss {
    font-family: var(--font-body--family);
    font-size: var(--font-size--3xs);
    letter-spacing: 0.28em;
    text-transform: uppercase;
    margin: 1.6rem 0 0 0;
    opacity: 0.7;
  }

  .pantao-name__body {
    font-family: var(--font-body--family);
    font-size: var(--font-size--md);
    line-height: 1.7;
    max-width: 32rem;
    margin-top: 2rem;
    opacity: 0.8;
  }

  .pantao-name__body p {
    margin: 0 0 1.1em 0;
  }

  .pantao-name__body p:last-child {
    margin-bottom: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "The name",
  "tag": "section",
  "class": "section-pantao-name",
  "settings": [
    {
      "type": "header",
      "content": "The name"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The Name"
    },
    {
      "type": "text",
      "id": "pronunciation",
      "label": "Pronunciation",
      "info": "Shown large, in the heading face.",
      "default": "pan·tao"
    },
    {
      "type": "richtext",
      "id": "definition",
      "label": "Definition",
      "info": "Use italics for the root word.",
      "default": "<p>From the Tagalog <em>tao</em> — a person, a people.</p>"
    },
    {
      "type": "text",
      "id": "gloss",
      "label": "Gloss",
      "info": "Small uppercase line beneath the definition.",
      "default": "PANG-TAO · FOR THE PEOPLE"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>We take the name as an instruction. Clothing cut for the body and the life around it — worn gently, worn often, made in numbers that let us answer for each one. Not for the few. For the people who wear it.</p>"
    },

    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "The name"
    }
  ]
}
{% endschema %}
