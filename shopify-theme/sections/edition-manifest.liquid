{%- comment -%}
  Pantao Edition Manifest
  --------------------------------------------------------
  A numbered manifest of the pieces in the current edition. Pulls
  products from a collection (set in section settings); auto-numbers
  them by their position in the collection.

  This is the commercial workhorse of the landing page. Restrained
  visually — no images, no prices stacked together, no "Add to cart"
  buttons. Each row is a piece, numbered, named, with optional price
  and a link to the PDP.

  To reorder the manifest, reorder the collection in the Shopify admin.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign collection = collections[s.collection]
  assign edition_prefix = s.edition_prefix | default: 'V'
  assign max_items = s.max_items | default: 12
-%}

<div
  class="manifest color-{{ s.color_scheme }}"
  data-section-id="{{ section.id }}"
>
  <div class="manifest__container">

    <header class="manifest__header">
      {%- if s.eyebrow != blank -%}
        <p class="manifest__eyebrow">{{ s.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if s.heading != blank -%}
        <h2 class="manifest__heading">{{ s.heading }}</h2>
      {%- endif -%}

      {%- if s.intro != blank -%}
        <div class="manifest__intro rte">{{ s.intro }}</div>
      {%- endif -%}
    </header>

    <ol class="manifest__list" role="list">
      {%- if collection != blank and collection.products.size > 0 -%}
        {%- for product in collection.products limit: max_items -%}
          {%- liquid
            assign piece_number = forloop.index
            assign piece_label = piece_number | prepend: '0' | slice: -2, 2
            assign piece_id = edition_prefix | append: '.' | append: piece_label
          -%}
          <li class="manifest__item">
            <a class="manifest__link" href="{{ product.url }}">
              <span class="manifest__number">{{ piece_id }}</span>
              <span class="manifest__rule" aria-hidden="true"></span>
              <span class="manifest__name">{{ product.title | escape }}</span>
              {%- if s.show_price and product.price != blank -%}
                <span class="manifest__price">
                  {%- if product.price_varies -%}
                    {{ s.price_from_label | default: 'from' }} {{ product.price_min | money }}
                  {%- else -%}
                    {{ product.price | money }}
                  {%- endif -%}
                </span>
              {%- endif -%}
              {%- if product.available == false and s.show_status -%}
                <span class="manifest__status">{{ s.sold_out_label | default: 'Sold out' }}</span>
              {%- endif -%}
            </a>
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- comment -%} Placeholder rows for the theme editor before a collection is set. {%- endcomment -%}
        {%- for i in (1..3) -%}
          <li class="manifest__item manifest__item--placeholder">
            <span class="manifest__link">
              <span class="manifest__number">{{ edition_prefix }}.0{{ i }}</span>
              <span class="manifest__rule" aria-hidden="true"></span>
              <span class="manifest__name">Choose a collection in section settings</span>
            </span>
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ol>

    {%- if s.footnote != blank -%}
      <p class="manifest__footnote">{{ s.footnote }}</p>
    {%- endif -%}

    {%- if s.show_view_all_link and collection != blank -%}
      <a class="manifest__view-all" href="{{ collection.url }}">
        <span>{{ s.view_all_label | default: 'View the full edition' }}</span>
        <span class="manifest__view-all-arrow" aria-hidden="true">&rarr;</span>
      </a>
    {%- endif -%}

  </div>
</div>

{% stylesheet %}
  .manifest {
    background: var(--color-background);
    color: var(--color-foreground);
    padding: 5rem 1.5rem;
  }

  @media (min-width: 750px) {
    .manifest {
      padding: 7rem 3rem;
    }
  }

  @media (min-width: 1200px) {
    .manifest {
      padding: 9rem 5rem;
    }
  }

  .manifest__container {
    max-width: 56rem;
    margin: 0 auto;
  }

  /* ---------- Header ---------- */
  .manifest__header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 3.5rem;
    text-align: left;
    max-width: 40rem;
  }

  @media (min-width: 750px) {
    .manifest__header {
      margin-bottom: 5rem;
    }
  }

  .manifest__eyebrow {
    font-family: var(--font-body--family);
    font-size: var(--font-size--3xs);
    letter-spacing: 0.32em;
    text-transform: uppercase;
    margin: 0;
    opacity: 0.6;
  }

  .manifest__heading {
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: clamp(1.5rem, 2.5vw + 0.5rem, 2.5rem);
    line-height: 1.1;
    letter-spacing: -0.005em;
    margin: 0;
    text-wrap: balance;
  }

  .manifest__intro {
    font-family: var(--font-body--family);
    font-size: var(--font-size--md);
    line-height: 1.6;
    margin-top: 0.5rem;
    opacity: 0.85;
  }

  .manifest__intro p {
    margin: 0 0 1em 0;
  }

  .manifest__intro p:last-child {
    margin-bottom: 0;
  }

  /* ---------- List ---------- */
  .manifest__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid currentColor;
  }

  .manifest__item {
    border-bottom: 1px solid currentColor;
  }

  .manifest__link {
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-areas: 'number rule name';
    align-items: baseline;
    gap: 1.25rem;
    padding: 1.5rem 0;
    color: inherit;
    text-decoration: none;
    font-family: var(--font-body--family);
    transition: opacity 0.2s ease, padding 0.25s ease;
  }

  @media (min-width: 750px) {
    .manifest__link {
      grid-template-columns: auto 1fr auto auto;
      grid-template-areas: 'number rule name price';
      gap: 2rem;
      padding: 1.75rem 0;
    }
  }

  a.manifest__link:hover {
    opacity: 0.6;
    padding-left: 0.5rem;
  }

  .manifest__number {
    grid-area: number;
    font-feature-settings: 'tnum';
    font-variant-numeric: tabular-nums;
    font-size: var(--font-size--xs);
    letter-spacing: 0.18em;
    opacity: 0.65;
    min-width: 3.5em;
  }

  .manifest__rule {
    grid-area: rule;
    height: 1px;
    background: currentColor;
    opacity: 0.15;
    align-self: center;
    margin-top: 0.4em;
  }

  .manifest__name {
    grid-area: name;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: clamp(1.125rem, 1.5vw + 0.25rem, 1.5rem);
    line-height: 1.2;
    letter-spacing: -0.005em;
    text-wrap: balance;
  }

  .manifest__price {
    grid-area: name;
    justify-self: end;
    font-feature-settings: 'tnum';
    font-variant-numeric: tabular-nums;
    font-size: var(--font-size--xs);
    letter-spacing: 0.05em;
    opacity: 0.7;
    margin-left: 1.5rem;
  }

  @media (min-width: 750px) {
    .manifest__price {
      grid-area: price;
      margin-left: 0;
    }
  }

  .manifest__status {
    grid-area: name;
    justify-self: end;
    font-size: var(--font-size--3xs);
    letter-spacing: 0.28em;
    text-transform: uppercase;
    opacity: 0.5;
    margin-left: 1.5rem;
  }

  @media (min-width: 750px) {
    .manifest__status {
      grid-area: price;
      margin-left: 0;
    }
  }

  .manifest__item--placeholder .manifest__name {
    opacity: 0.4;
    font-style: italic;
  }

  /* ---------- Footer ---------- */
  .manifest__footnote {
    font-family: var(--font-body--family);
    font-size: var(--font-size--3xs);
    letter-spacing: 0.05em;
    line-height: 1.6;
    margin: 2.5rem 0 0 0;
    opacity: 0.55;
    max-width: 32rem;
  }

  .manifest__view-all {
    display: inline-flex;
    align-items: center;
    gap: 0.75em;
    margin-top: 3rem;
    font-family: var(--font-body--family);
    font-size: var(--font-size--xs);
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: inherit;
    text-decoration: none;
    transition: gap 0.25s ease;
  }

  .manifest__view-all:hover {
    gap: 1.25em;
  }

  .manifest__view-all-arrow {
    font-size: 1.1em;
    transition: transform 0.25s ease;
  }

  .manifest__view-all:hover .manifest__view-all-arrow {
    transform: translateX(4px);
  }

  @media (prefers-reduced-motion: reduce) {
    .manifest__link,
    .manifest__view-all,
    .manifest__view-all-arrow {
      transition: none;
    }
    a.manifest__link:hover {
      padding-left: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Edition manifest",
  "tag": "section",
  "class": "section-manifest",
  "settings": [
    {
      "type": "header",
      "content": "Source"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Reorder the collection in the Shopify admin to reorder the manifest."
    },
    {
      "type": "range",
      "id": "max_items",
      "label": "Maximum pieces",
      "min": 3,
      "max": 24,
      "step": 1,
      "default": 12
    },

    {
      "type": "header",
      "content": "Numbering"
    },
    {
      "type": "text",
      "id": "edition_prefix",
      "label": "Edition prefix",
      "info": "Shown before each piece number, e.g. \"V.01\".",
      "default": "V"
    },

    {
      "type": "header",
      "content": "Header copy"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "THE EDITION"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Twelve pieces."
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro",
      "default": "<p>Each piece is numbered, made in limited count, and named. The list below is the manifest in full.</p>"
    },

    {
      "type": "header",
      "content": "Display"
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show price",
      "default": false
    },
    {
      "type": "text",
      "id": "price_from_label",
      "label": "\"From\" label",
      "info": "Shown before price for products with multiple variants.",
      "default": "from",
      "visible_if": "{{ section.settings.show_price }}"
    },
    {
      "type": "checkbox",
      "id": "show_status",
      "label": "Show \"Sold out\" status",
      "default": true
    },
    {
      "type": "text",
      "id": "sold_out_label",
      "label": "Sold out label",
      "default": "Sold out",
      "visible_if": "{{ section.settings.show_status }}"
    },

    {
      "type": "header",
      "content": "Footer"
    },
    {
      "type": "richtext",
      "id": "footnote",
      "label": "Footnote",
      "info": "Small print beneath the manifest. Optional.",
      "default": "<p>Pieces are made in limited number. Once the edition closes, it does not reopen.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_view_all_link",
      "label": "Show \"View the full edition\" link",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View all label",
      "default": "View the full edition",
      "visible_if": "{{ section.settings.show_view_all_link }}"
    },

    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Edition manifest"
    }
  ]
}
{% endschema %}
