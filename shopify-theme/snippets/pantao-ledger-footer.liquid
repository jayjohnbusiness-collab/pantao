{%- comment -%}
  Pantao minimal footer — shared render
  --------------------------------------------------------
  A single slim line of links + copyright, in the Gentle Monster minimal
  register, on the PANTAO paper palette. Rendered from whichever footer
  section includes it (footer / footer-utilities), so it is driven by
  section CODE (syncs reliably from GitHub) and cannot be overwritten by
  the theme editor's group JSON.

  The including section wraps this in a color-scheme `.section` with large
  inline padding; we neutralise that wrapper (scoped to this section id) so
  the footer stays slim and on paper regardless of the assigned scheme.

  Links come from a chosen "Footer menu" (section setting `footer_menu`);
  if unset, they fall back to the legacy Client Care / Legal / Socials
  menus combined, then to the shop's policy pages — so real links always
  render without any editor action.

  @param {object} section - The including section (for its settings + id)
{%- endcomment -%}

{%- liquid
  assign fmenu = section.settings.footer_menu
  assign use_combined = false
  if fmenu == blank or fmenu.links.size == 0
    assign use_combined = true
  endif

  assign col1 = section.settings.col1_menu
  assign col2 = section.settings.col2_menu
  assign col3 = section.settings.col3_menu
  assign has_cols = false
  if col1 != blank or col2 != blank or col3 != blank
    assign has_cols = true
  endif

  assign brand = section.settings.brand_name | default: 'PANTAO'
  assign suffix = section.settings.copyright_suffix | default: 'Manila'
  assign year = 'now' | date: '%Y'
-%}

<div class="pantao-minfoot" data-section-id="{{ section.id }}">
  <div class="pantao-minfoot__wrap">
    <nav class="pantao-minfoot__links" aria-label="{{ 'sections.footer.navigation' | t | default: 'Footer' }}">
      {%- if use_combined -%}
        {%- if has_cols -%}
          {%- for link in col1.links -%}<a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>{%- endfor -%}
          {%- for link in col2.links -%}<a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>{%- endfor -%}
          {%- for link in col3.links -%}<a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>{%- endfor -%}
        {%- else -%}
          {%- for policy in shop.policies -%}
            {%- if policy != blank -%}<a href="{{ policy.url }}">{{ policy.title | escape }}</a>{%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      {%- else -%}
        {%- for link in fmenu.links -%}<a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>{%- endfor -%}
      {%- endif -%}

      {%- if localization.available_countries and localization.available_countries.size > 1 -%}
        {%- form 'localization', class: 'pantao-minfoot__loc' -%}
          <span class="pantao-minfoot__loc-label">{{ 'localization.country_label' | t | default: 'Country' }}:</span>
          <span class="pantao-minfoot__loc-field">
            <select name="country_code" aria-label="{{ 'localization.country_label' | t | default: 'Country' }}" onchange="this.form.submit()">
              {%- for country in localization.available_countries -%}
                <option value="{{ country.iso_code }}"{% if country.iso_code == localization.country.iso_code %} selected{% endif %}>{{ country.name }}</option>
              {%- endfor -%}
            </select>
          </span>
          <input type="hidden" name="return_to" value="{{ request.path }}">
        {%- endform -%}
      {%- endif -%}
    </nav>

    <div class="pantao-minfoot__copy">&copy; {{ year }} {{ brand | escape }}{% if suffix != blank %} &middot; {{ suffix | escape }}{% endif %}</div>
  </div>
</div>

<style>
  /* Neutralise the theme's section wrapper so the footer is slim + on paper,
     regardless of the color scheme / padding the editor assigns. Scoped to
     this section id. Padding is applied inline by the section, so !important
     is required to override it. */
  #shopify-section-{{ section.id }} { background: #f4f4f2; }
  #shopify-section-{{ section.id }} .section-background { display: none !important; }
  #shopify-section-{{ section.id }} .section {
    padding: 0 !important;
    margin: 0 !important;
    max-width: none !important;
    width: 100% !important;
  }

  .pantao-minfoot {
    --pf-ink: #16181c;
    --pf-paper: #f4f4f2;
    --pf-muted: rgba(22, 24, 28, 0.52);
    --pf-line: rgba(22, 24, 28, 0.12);
    --pf-accent: #b5271f;
    background: var(--pf-paper);
    color: var(--pf-ink);
    border-top: 1px solid var(--pf-line);
    font-family: var(--font-body--family, -apple-system, system-ui, sans-serif);
  }
  .pantao-minfoot__wrap {
    max-width: 1600px;
    margin: 0 auto;
    padding: 14px clamp(20px, 4vw, 48px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px 30px;
    flex-wrap: wrap;
  }
  .pantao-minfoot__links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: clamp(14px, 1.9vw, 28px);
  }
  .pantao-minfoot__links > a {
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.01em;
    line-height: 1;
    color: var(--pf-ink);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .pantao-minfoot__links > a:hover,
  .pantao-minfoot__links > a:focus-visible { color: var(--pf-accent); }

  /* Country selector — styled as inline text: "Country: Value" underlined. */
  .pantao-minfoot__loc {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-size: 12px;
    color: var(--pf-muted);
  }
  .pantao-minfoot__loc-field {
    position: relative;
    color: var(--pf-ink);
    border-bottom: 1px solid var(--pf-line);
  }
  .pantao-minfoot__loc select {
    appearance: none;
    -webkit-appearance: none;
    border: 0;
    background: transparent;
    font: inherit;
    color: var(--pf-ink);
    padding: 2px 16px 2px 0;
    cursor: pointer;
  }
  .pantao-minfoot__loc-field::after {
    content: "";
    position: absolute;
    right: 2px;
    top: 50%;
    width: 6px; height: 6px;
    border-right: 1px solid var(--pf-muted);
    border-bottom: 1px solid var(--pf-muted);
    transform: translateY(-70%) rotate(45deg);
    pointer-events: none;
  }
  .pantao-minfoot__loc select:hover { color: var(--pf-accent); }

  .pantao-minfoot__copy {
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--pf-muted);
    white-space: nowrap;
  }

  @media screen and (max-width: 720px) {
    .pantao-minfoot__wrap { flex-direction: column; align-items: flex-start; gap: 14px; }
    .pantao-minfoot__links { gap: 12px 18px; }
  }
</style>
