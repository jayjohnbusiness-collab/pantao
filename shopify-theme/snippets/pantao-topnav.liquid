{%- comment -%}
  Pantao top nav — pill items with a hover slide fill.
  ----------------------------------------------------------------
  Styles the desktop horizontal menu (.header-menu, shown when the menu
  block's style is "Menu"). Each item rests in a compact pill; on hover the
  pill fills from the left (a slide) and the label inverts.

  The theme sets .menu-list__link { height: 100% } so links stretch to the
  full header height — we reset that to keep the pills compact, and move the
  horizontal padding onto the pill itself. Loads once (rendered from the
  header menu block). Inert on mobile / drawer.
{%- endcomment -%}
<style>
  @media screen and (min-width: 750px) {
    #header-component .header-menu .menu-list__list {
      gap: clamp(0.4rem, 1vw, 0.8rem);
      align-items: center;
    }

    /* Compact pill — override the theme's full-height link. */
    #header-component .header-menu .menu-list__link {
      height: auto;
      align-self: center;
      position: relative;
      overflow: hidden;
      line-height: 1;
      border: 1px solid rgb(var(--color-foreground-rgb, 22 24 28) / 0.22);
      border-radius: 100px;
      padding: 0.5rem 1.1rem;
      transition: border-color 0.35s ease;
    }

    /* Text carries no extra inline padding — the pill controls it. */
    #header-component .header-menu .menu-list__link-title {
      padding-inline: 0;
      position: relative;
      z-index: 1;
      transition: color 0.3s ease;
    }

    /* The slide: pill fills from the left on hover. */
    #header-component .header-menu .menu-list__link::before {
      content: '';
      position: absolute;
      inset: 0;
      background: var(--color-foreground);
      transform: scaleX(0);
      transform-origin: left center;
      transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
      pointer-events: none;
    }

    #header-component .header-menu .menu-list__link:hover::before,
    #header-component .header-menu .menu-list__link:focus-visible::before {
      transform: scaleX(1);
    }

    #header-component .header-menu .menu-list__link:hover .menu-list__link-title,
    #header-component .header-menu .menu-list__link:focus-visible .menu-list__link-title {
      color: var(--color-background);
    }

    #header-component .header-menu .menu-list__link:hover,
    #header-component .header-menu .menu-list__link:focus-visible {
      border-color: var(--color-foreground);
    }

    /* Current page: a quietly emphasized pill outline. */
    #header-component .header-menu .menu-list__link--active {
      border-color: rgb(var(--color-foreground-rgb, 22 24 28) / 0.55);
    }

    @media (prefers-reduced-motion: reduce) {
      #header-component .header-menu .menu-list__link::before {
        transition: none;
      }
    }
  }
</style>
