{% doc %}
  @prompt
    Create a clickable text link that you can attach an image pop-up to. Settings should include options to adjust link text, link image, adjust text fonts/size, theme adjustment, and orientation., keep all settings the same, but add options to add an icon next to text. include, measuring tape and ruler icons
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-image-link-popup-{{ ai_gen_id }} {
    display: inline-block;
    position: relative;
  }

  .ai-image-link-popup__link-{{ ai_gen_id }} {
    font-family: {{ block.settings.link_font.family }}, {{ block.settings.link_font.fallback_families }};
    font-weight: {{ block.settings.link_font.weight }};
    font-size: {{ block.settings.link_font_size }}px;
    color: {{ block.settings.link_color }};
    text-decoration: {{ block.settings.link_underline }};
    cursor: pointer;
    transition: color 0.3s ease;
    display: inline-flex;
    align-items: center;
    gap: {{ block.settings.icon_spacing }}px;
  }

  .ai-image-link-popup__link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.link_hover_color }};
  }

  .ai-image-link-popup__icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    flex-shrink: 0;
    {% if block.settings.icon_position == 'right' %}
      order: 2;
    {% endif %}
  }

  .ai-image-link-popup__overlay-{{ ai_gen_id }} {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.overlay_color }};
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
    z-index: 999;
  }

  .ai-image-link-popup__overlay-{{ ai_gen_id }}.active {
    opacity: 1;
    visibility: visible;
  }

  .ai-image-link-popup__modal-{{ ai_gen_id }} {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scale(0.9);
    max-width: {{ block.settings.popup_max_width }}px;
    width: 90%;
    max-height: 90vh;
    background-color: {{ block.settings.popup_bg_color }};
    border-radius: {{ block.settings.popup_border_radius }}px;
    padding: {{ block.settings.popup_padding }}px;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease, transform 0.3s ease;
    z-index: 1000;
    overflow: auto;
  }

  .ai-image-link-popup__modal-{{ ai_gen_id }}.active {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, -50%) scale(1);
  }

  .ai-image-link-popup__close-{{ ai_gen_id }} {
    position: absolute;
    top: {{ block.settings.popup_padding }}px;
    {% if block.settings.close_button_position == 'left' %}
      left: {{ block.settings.popup_padding }}px;
    {% else %}
      right: {{ block.settings.popup_padding }}px;
    {% endif %}
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    color: {{ block.settings.close_button_color }};
    opacity: 0.7;
    transition: opacity 0.3s ease;
    z-index: 1;
  }

  .ai-image-link-popup__close-{{ ai_gen_id }}:hover {
    opacity: 1;
  }

  .ai-image-link-popup__close-{{ ai_gen_id }} svg {
    width: {{ block.settings.close_button_size }}px;
    height: {{ block.settings.close_button_size }}px;
  }

  .ai-image-link-popup__image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .ai-image-link-popup__image-{{ ai_gen_id }} {
    max-width: 100%;
    height: auto;
    display: block;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-image-link-popup__placeholder-{{ ai_gen_id }} {
    width: 100%;
    max-width: 400px;
    background-color: #f4f4f4;
    border-radius: {{ block.settings.image_border_radius }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-image-link-popup__placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
  }

  .ai-image-link-popup__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  @media screen and (max-width: 749px) {
    .ai-image-link-popup__modal-{{ ai_gen_id }} {
      max-width: 95%;
      padding: {{ block.settings.popup_padding | times: 0.7 }}px;
    }

    .ai-image-link-popup__link-{{ ai_gen_id }} {
      font-size: {{ block.settings.link_font_size | times: 0.9 }}px;
    }

    .ai-image-link-popup__icon-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size | times: 0.9 }}px;
      height: {{ block.settings.icon_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<image-link-popup-{{ ai_gen_id }} class="ai-image-link-popup-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <a
    href="#"
    class="ai-image-link-popup__link-{{ ai_gen_id }}"
    data-popup-trigger
    aria-label="Open image popup"
  >
    {% if block.settings.show_icon %}
      <span class="ai-image-link-popup__icon-{{ ai_gen_id }}">
        {% if block.settings.icon_type == 'measuring_tape' %}
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 3v18h18"></path>
            <path d="M7 3v4"></path>
            <path d="M11 3v4"></path>
            <path d="M15 3v4"></path>
            <path d="M19 3v4"></path>
            <path d="M3 7h4"></path>
            <path d="M3 11h4"></path>
            <path d="M3 15h4"></path>
            <path d="M3 19h4"></path>
            <circle cx="14" cy="14" r="3"></circle>
            <path d="M16.5 16.5L21 21"></path>
          </svg>
        {% elsif block.settings.icon_type == 'ruler' %}
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21.3 15.3a2.4 2.4 0 0 1 0 3.4l-2.6 2.6a2.4 2.4 0 0 1-3.4 0L2.7 8.7a2.4 2.4 0 0 1 0-3.4l2.6-2.6a2.4 2.4 0 0 1 3.4 0Z"></path>
            <path d="m14.5 12.5 2-2"></path>
            <path d="m11.5 9.5 2-2"></path>
            <path d="m8.5 6.5 2-2"></path>
            <path d="m17.5 15.5 2-2"></path>
          </svg>
        {% endif %}
      </span>
    {% endif %}
    <span>{{ block.settings.link_text }}</span>
  </a>

  <div class="ai-image-link-popup__overlay-{{ ai_gen_id }}" data-popup-overlay></div>

  <div
    class="ai-image-link-popup__modal-{{ ai_gen_id }}"
    role="dialog"
    aria-modal="true"
    data-popup-modal
  >
    <button
      class="ai-image-link-popup__close-{{ ai_gen_id }}"
      data-popup-close
      aria-label="Close popup"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <div class="ai-image-link-popup__image-wrapper-{{ ai_gen_id }}">
      {% if block.settings.popup_image %}
        <img
          src="{{ block.settings.popup_image | image_url: width: 2000 }}"
          alt="{{ block.settings.popup_image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.popup_image.width }}"
          height="{{ block.settings.popup_image.height }}"
          class="ai-image-link-popup__image-{{ ai_gen_id }}"
        >
      {% else %}
        <div class="ai-image-link-popup__placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
          <div class="ai-image-link-popup__empty-state-{{ ai_gen_id }}">
            Next, add a popup image
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</image-link-popup-{{ ai_gen_id }}>

<script>
  (function() {
    class ImageLinkPopup{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.trigger = this.querySelector('[data-popup-trigger]');
        this.overlay = this.querySelector('[data-popup-overlay]');
        this.modal = this.querySelector('[data-popup-modal]');
        this.closeButton = this.querySelector('[data-popup-close]');

        this.setupEventListeners();
      }

      setupEventListeners() {
        this.trigger.addEventListener('click', (e) => {
          e.preventDefault();
          this.openPopup();
        });

        this.closeButton.addEventListener('click', () => {
          this.closePopup();
        });

        this.overlay.addEventListener('click', () => {
          this.closePopup();
        });

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && this.modal.classList.contains('active')) {
            this.closePopup();
          }
        });
      }

      openPopup() {
        this.overlay.classList.add('active');
        this.modal.classList.add('active');
        document.body.style.overflow = 'hidden';
      }

      closePopup() {
        this.overlay.classList.remove('active');
        this.modal.classList.remove('active');
        document.body.style.overflow = '';
      }
    }

    customElements.define('image-link-popup-{{ ai_gen_id }}', ImageLinkPopup{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Image popup link",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Link text"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Text",
      "default": "View image"
    },
    {
      "type": "font_picker",
      "id": "link_font",
      "label": "Font",
      "default": "sans_serif_n4"
    },
    {
      "type": "range",
      "id": "link_font_size",
      "min": 10,
      "max": 48,
      "step": 1,
      "unit": "px",
      "label": "Font size",
      "default": 16
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "link_hover_color",
      "label": "Hover color",
      "default": "#666666"
    },
    {
      "type": "select",
      "id": "link_underline",
      "label": "Underline",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "underline",
          "label": "Underline"
        }
      ],
      "default": "underline"
    },
    {
      "type": "header",
      "content": "Icon"
    },
    {
      "type": "checkbox",
      "id": "show_icon",
      "label": "Show icon",
      "default": false
    },
    {
      "type": "select",
      "id": "icon_type",
      "label": "Icon type",
      "options": [
        {
          "value": "measuring_tape",
          "label": "Measuring tape"
        },
        {
          "value": "ruler",
          "label": "Ruler"
        }
      ],
      "default": "measuring_tape"
    },
    {
      "type": "select",
      "id": "icon_position",
      "label": "Position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 12,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Size",
      "default": 20
    },
    {
      "type": "range",
      "id": "icon_spacing",
      "min": 2,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Spacing",
      "default": 8
    },
    {
      "type": "header",
      "content": "Popup image"
    },
    {
      "type": "image_picker",
      "id": "popup_image",
      "label": "Image"
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Image border radius",
      "default": 0
    },
    {
      "type": "header",
      "content": "Popup style"
    },
    {
      "type": "range",
      "id": "popup_max_width",
      "min": 300,
      "max": 1200,
      "step": 50,
      "unit": "px",
      "label": "Maximum width",
      "default": 800
    },
    {
      "type": "range",
      "id": "popup_padding",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "label": "Padding",
      "default": 30
    },
    {
      "type": "range",
      "id": "popup_border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Border radius",
      "default": 8
    },
    {
      "type": "color",
      "id": "popup_bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "rgba(0, 0, 0, 0.7)"
    },
    {
      "type": "header",
      "content": "Close button"
    },
    {
      "type": "select",
      "id": "close_button_position",
      "label": "Position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "right"
    },
    {
      "type": "range",
      "id": "close_button_size",
      "min": 16,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Size",
      "default": 24
    },
    {
      "type": "color",
      "id": "close_button_color",
      "label": "Color",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "Image popup link"
    }
  ]
}
{% endschema %}
