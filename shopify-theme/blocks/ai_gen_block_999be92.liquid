{% doc %}
  @prompt
    CREATE A FOOTER THAT GIVES ME THREE SECTIONS TO LINK DIFFERENT MENUS. GIVE ME THE OPTION TO ADJUST THE ALIGNMENT, INPUT A HEADER, MENU TEXT SIZE/FONT, TOGGLE THE MENU ADAPTS TO THE CURRENT PAGE THEME, OPTIONS TO CHOOSE A DIFFERENT THEME, ADJUSTABLE MARGINS IN BETWEEN EACH MENU, VISIBILITY TOGGLE FOR EACH MENU, INCLUDE HEADER FONT AND STYLE OPTIONS, INCLUDE HEADER FONT STYLES, INCLUDE TOGGLE SETTINGS FOR THE MENU LAYOUT FOR FULL PAGE OR PAGE WIDTH, INCLUDE SETTINGS TO ADJUST THE PADDING OF THE FOOTER, INCLUDE A TOGGLE SETTING FOR MOBILE VIEW WHETHER THE MENU ARE VERTICAL OR HORIZONTAL AND IF THE MENUS BECOME DROP DOWNS, INCLUDE A TOGGLE OPTION IF THE MOBILE DROPDOWN MENU HAS AN UNDERLINE OR NOT. WHEN THE MENU DROP DOWN IS PRESSED THE FULL MENU SHOULD APPEAR ACCORDINGLY, INCLUDE DROPDOWN MENU ICON OPTIONS. INCLUDE: PLUS, DOWN ARROW, UP ARROW, UP CARET, AND DOWN CARET, MAKE SURE THE DROPDOWN ICON STICKS TO THE HEADER TITLE WHEN SHIFTING FROM MOBILE AND DESKTOP.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-footer-{{ ai_gen_id }} {
    width: 100%;
    {% if block.settings.use_page_width %}
      max-width: 1200px;
      margin: 0 auto;
    {% endif %}
    padding-top: {{ block.settings.padding_top }}px;
    padding-bottom: {{ block.settings.padding_bottom }}px;
    padding-left: {{ block.settings.padding_horizontal }}px;
    padding-right: {{ block.settings.padding_horizontal }}px;
  }

  .ai-footer-container-{{ ai_gen_id }} {
    display: flex;
    justify-content: {{ block.settings.alignment }};
    gap: {{ block.settings.menu_spacing }}px;
    flex-wrap: wrap;
  }

  .ai-footer-menu-section-{{ ai_gen_id }} {
    flex: 1;
    min-width: 200px;
  }

  .ai-footer-menu-header-{{ ai_gen_id }} {
    margin: 0 0 16px 0;
    font-family: {{ block.settings.header_font.family }}, {{ block.settings.header_font.fallback_families }};
    font-weight: {{ block.settings.header_font.weight }};
    font-style: {{ block.settings.header_font_style }};
    font-size: {{ block.settings.header_font_size }}px;
    {% if block.settings.header_text_transform == 'uppercase' %}
      text-transform: uppercase;
    {% endif %}
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .ai-footer-dropdown-icon-{{ ai_gen_id }} {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    margin-left: 8px;
    display: none;
    transition: transform 0.3s ease;
  }

  .ai-footer-menu-list-{{ ai_gen_id }} {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .ai-footer-menu-item-{{ ai_gen_id }} {
    margin-bottom: 12px;
  }

  .ai-footer-menu-link-{{ ai_gen_id }} {
    text-decoration: none;
    font-family: {{ block.settings.menu_font.family }}, {{ block.settings.menu_font.fallback_families }};
    font-weight: {{ block.settings.menu_font.weight }};
    font-size: {{ block.settings.menu_font_size }}px;
    transition: opacity 0.2s ease;
  }

  .ai-footer-menu-link-{{ ai_gen_id }}:hover {
    opacity: 0.7;
  }

  .ai-footer-menu-link-{{ ai_gen_id }}.active {
    font-weight: 600;
  }

  @media screen and (max-width: 749px) {
    .ai-footer-container-{{ ai_gen_id }} {
      {% if block.settings.mobile_layout == 'vertical' %}
        flex-direction: column;
        gap: 24px;
      {% else %}
        flex-direction: row;
      {% endif %}
    }

    {% if block.settings.mobile_dropdown %}
      .ai-footer-menu-section-{{ ai_gen_id }} {
        border-bottom: {% if block.settings.mobile_dropdown_underline %}1px solid rgba(0, 0, 0, 0.1){% else %}none{% endif %};
        padding-bottom: 12px;
      }

      .ai-footer-menu-header-{{ ai_gen_id }} {
        cursor: pointer;
        margin-bottom: 0;
        user-select: none;
      }

      .ai-footer-dropdown-icon-{{ ai_gen_id }} {
        display: block;
      }

      .ai-footer-menu-header-{{ ai_gen_id }}.active .ai-footer-dropdown-icon-{{ ai_gen_id }} {
        {% if block.settings.dropdown_icon == 'plus' %}
          transform: rotate(45deg);
        {% elsif block.settings.dropdown_icon == 'down_arrow' or block.settings.dropdown_icon == 'down_caret' %}
          transform: rotate(180deg);
        {% elsif block.settings.dropdown_icon == 'up_arrow' or block.settings.dropdown_icon == 'up_caret' %}
          transform: rotate(180deg);
        {% endif %}
      }

      .ai-footer-menu-list-{{ ai_gen_id }} {
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.3s ease;
      }

      .ai-footer-menu-list-{{ ai_gen_id }}.active {
        max-height: 500px;
        margin-top: 16px;
      }
    {% endif %}
  }
{% endstyle %}

<footer-menus-{{ ai_gen_id }} class="ai-footer-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
