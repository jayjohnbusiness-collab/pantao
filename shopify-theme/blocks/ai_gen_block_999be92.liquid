<script>
  (function() {
    class FooterMenus{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.isMobile = window.innerWidth < 750;
        this.mobileDropdown = {{ block.settings.mobile_dropdown | json }};
      }

      connectedCallback() {
        if (this.isMobile && this.mobileDropdown) {
          this.setupMobileDropdowns();
        }

        window.addEventListener('resize', () => {
          const wasMobile = this.isMobile;
          this.isMobile = window.innerWidth < 750;
          
          if (wasMobile !== this.isMobile) {
            if (this.isMobile && this.mobileDropdown) {
              this.setupMobileDropdowns();
            } else {
              this.removeMobileDropdowns();
            }
          }
        });
      }

      setupMobileDropdowns() {
        const headers = this.querySelectorAll('.ai-footer-menu-header-{{ ai_gen_id }}');
        
        headers.forEach((header) => {
          const list = header.nextElementSibling;
          
          if (list && list.classList.contains('ai-footer-menu-list-{{ ai_gen_id }}')) {
            list.classList.remove('active');
            header.classList.remove('active');
            
            header.addEventListener('click', this.toggleDropdown.bind(this));
          }
        });
      }

      removeMobileDropdowns() {
        const headers = this.querySelectorAll('.ai-footer-menu-header-{{ ai_gen_id }}');
        const lists = this.querySelectorAll('.ai-footer-menu-list-{{ ai_gen_id }}');
        
        headers.forEach((header) => {
          header.classList.remove('active');
          header.removeEventListener('click', this.toggleDropdown);
        });
        
        lists.forEach((list) => {
          list.classList.add('active');
        });
      }

      toggleDropdown(event) {
        const header = event.currentTarget;
        const list = header.nextElementSibling;
        
        if (list && list.classList.contains('ai-footer-menu-list-{{ ai_gen_id }}')) {
          const isActive = list.classList.contains('active');
          
          list.classList.toggle('active');
          header.classList.toggle('active');
        }
      }
    }

    customElements.define('footer-menus-{{ ai_gen_id }}', FooterMenus{{ ai_gen_id }});
  })();
</script>

