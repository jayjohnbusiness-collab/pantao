{% doc %}
  @prompt
    CREATE A FEATURED PRODUCT GRID THAT I CAN ADJUST THE HEIGHT AND WIDTH OF EACH LINKED PRODUCT AND THE LAYOUT ON DESKTOP AND MOBILE. INCLUDE SETTINGS FOR PADDING. INCLUDE ADJUSTABLE SETTINGS FOR PRODUCT TITLE, PRICE, SWATCH, AND MAKE IT COMPATIBLE WITH THE NOTIFY ME APP.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-featured-grid-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_horizontal }}px {{ block.settings.padding_bottom }}px;
  }

  .ai-featured-grid__container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    width: 100%;
  }

  .ai-featured-grid__item-{{ ai_gen_id }} {
    position: relative;
    display: flex;
    flex-direction: column;
    height: {{ block.settings.card_height }}px;
    background-color: {{ block.settings.card_background }};
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    transition: transform 0.3s ease;
  }

  .ai-featured-grid__item-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
  }

  .ai-featured-grid__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: {{ block.settings.image_height }}px;
    overflow: hidden;
    flex-shrink: 0;
  }

  .ai-featured-grid__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-featured-grid__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-featured-grid__image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
  }

  .ai-featured-grid__content-{{ ai_gen_id }} {
    padding: {{ block.settings.content_padding }}px;
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.content_gap }}px;
    flex-grow: 1;
  }

  .ai-featured-grid__title-{{ ai_gen_id }} {
    margin: 0;
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    text-transform: {{ block.settings.title_case }};
    line-height: 1.2;
  }

  {% if block.settings.show_title == false %}
    .ai-featured-grid__title-{{ ai_gen_id }} {
      display: none;
    }
  {% endif %}

  .ai-featured-grid__price-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_size }}px;
    color: {{ block.settings.price_color }};
    font-weight: 600;
  }

  {% if block.settings.show_price == false %}
    .ai-featured-grid__price-{{ ai_gen_id }} {
      display: none;
    }
  {% endif %}

  .ai-featured-grid__price-compare-{{ ai_gen_id }} {
    text-decoration: line-through;
    opacity: 0.6;
    margin-left: 8px;
  }

  .ai-featured-grid__swatches-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  {% if block.settings.show_swatches == false %}
    .ai-featured-grid__swatches-{{ ai_gen_id }} {
      display: none;
    }
  {% endif %}

  .ai-featured-grid__swatch-{{ ai_gen_id }} {
    width: {{ block.settings.swatch_size }}px;
    height: {{ block.settings.swatch_size }}px;
    border-radius: {{ block.settings.swatch_border_radius }}px;
    border: 1px solid {{ block.settings.swatch_border_color }};
    cursor: pointer;
    transition: transform 0.2s ease;
  }

  .ai-featured-grid__swatch-{{ ai_gen_id }}:hover {
    transform: scale(1.1);
  }

  .ai-featured-grid__notify-wrapper-{{ ai_gen_id }} {
    margin-top: auto;
  }

  {% if block.settings.show_notify_me == false %}
    .ai-featured-grid__notify-wrapper-{{ ai_gen_id }} {
      display: none;
    }
  {% endif %}

  @media screen and (max-width: 749px) {
    .ai-featured-grid__container-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }

    .ai-featured-grid__item-{{ ai_gen_id }} {
      height: {{ block.settings.card_height_mobile }}px;
    }

    .ai-featured-grid__image-wrapper-{{ ai_gen_id }} {
      height: {{ block.settings.image_height_mobile }}px;
    }
  }
{% endstyle %}

<featured-product-grid-{{ ai_gen_id }}
  class="ai-featured-grid-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-featured-grid__container-{{ ai_gen_id }}">
    {% for i in (1..12) %}
      {% liquid
        assign product_key = 'product_' | append: i
        assign product = block.settings[product_key]
      %}

      {% if product != blank %}
        <a
          href="{{ product.url }}"
          class="ai-featured-grid__item-{{ ai_gen_id }}"
        >
          <div class="ai-featured-grid__image-wrapper-{{ ai_gen_id }}">
            {% if product.featured_image %}
              <img
                src="{{ product.featured_image | image_url: width: 800 }}"
                alt="{{ product.featured_image.alt | escape }}"
                loading="lazy"
                width="800"
                height="800"
                class="ai-featured-grid__image-{{ ai_gen_id }}"
              >
            {% else %}
              <div class="ai-featured-grid__image-placeholder-{{ ai_gen_id }}">
                {{ 'product-1' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>

          <div class="ai-featured-grid__content-{{ ai_gen_id }}">
            <h3 class="ai-featured-grid__title-{{ ai_gen_id }}">
              {{ product.title }}
            </h3>

            <div class="ai-featured-grid__price-{{ ai_gen_id }}">
              {{ product.price | money }}
              {% if product.compare_at_price > product.price %}
                <span class="ai-featured-grid__price-compare-{{ ai_gen_id }}">
                  {{ product.compare_at_price | money }}
                </span>
              {% endif %}
            </div>

            {% if product.options_with_values.size > 0 %}
              <div class="ai-featured-grid__swatches-{{ ai_gen_id }}">
                {% assign color_option = product.options_with_values | where: 'name', 'Color' | first %}
                {% if color_option %}
                  {% for value in color_option.values limit: block.settings.max_swatches %}
                    <div
                      class="ai-featured-grid__swatch-{{ ai_gen_id }}"
                      style="background-color: {{ value | handleize }};"
                      title="{{ value }}"
                    ></div>
                  {% endfor %}
                {% endif %}
              </div>
            {% endif %}

            <div class="ai-featured-grid__notify-wrapper-{{ ai_gen_id }}">
              <div class="notify-me-wrapper" data-product-id="{{ product.id }}"></div>
            </div>
          </div>
        </a>
      {% endif %}
    {% endfor %}
  </div>
</featured-product-grid-{{ ai_gen_id }}>

<script>
  (function() {
    class FeaturedProductGrid{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.initNotifyMe();
      }

      initNotifyMe() {
        if (typeof window.NotifyMe !== 'undefined') {
          const notifyWrappers = this.querySelectorAll('.notify-me-wrapper');
          notifyWrappers.forEach(wrapper => {
            const productId = wrapper.getAttribute('data-product-id');
            if (productId && window.NotifyMe) {
              window.NotifyMe.init(wrapper, productId);
            }
          });
        }
      }
    }

    customElements.define('featured-product-grid-{{ ai_gen_id }}', FeaturedProductGrid{{ ai_gen_id }});
  })();
</script>

