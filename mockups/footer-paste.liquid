{%- comment -%} PANTAO — Ledger footer. Paste this whole block into a Custom Liquid field. {%- endcomment -%}
{%- assign col1 = linklists['client-care'] -%}
{%- assign col2 = linklists['legal'] -%}
{%- assign col3 = linklists['social'] -%}

<div class="pantao-footer">
  <div class="pantao-footer__grid">

    <div class="pantao-footer__signup">
      <p class="pantao-footer__kicker">Be told when the doors open.</p>
      <p class="pantao-footer__sub">One note a year, ahead of the edition. Nothing else.</p>
      <form method="post" action="/contact#footer-newsletter" accept-charset="UTF-8" class="pantao-footer__form">
        <input type="hidden" name="form_type" value="customer">
        <input type="hidden" name="utf8" value="✓">
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="pantao-footer__field">
          <input type="email" name="contact[email]" required placeholder="Email address" aria-label="Email">
          <button type="submit" class="pantao-footer__join">Join</button>
        </div>
      </form>
    </div>

    {%- if col1.links.size > 0 -%}
      <nav class="pantao-footer__col" aria-label="Client Care">
        <h4 class="pantao-footer__col-heading">Client Care</h4>
        <ul class="pantao-footer__col-list">
          {%- for link in col1.links -%}<li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>{%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}

    {%- if col2.links.size > 0 -%}
      <nav class="pantao-footer__col" aria-label="Legal">
        <h4 class="pantao-footer__col-heading">Legal</h4>
        <ul class="pantao-footer__col-list">
          {%- for link in col2.links -%}<li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>{%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}

    {%- if col3.links.size > 0 -%}
      <nav class="pantao-footer__col" aria-label="Socials">
        <h4 class="pantao-footer__col-heading">Socials</h4>
        <ul class="pantao-footer__col-list">
          {%- for link in col3.links -%}<li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>{%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}

  </div>

  <div class="pantao-footer__base">
    <span class="pantao-footer__wordmark">PANTAO</span>
    <span class="pantao-footer__copy">&copy; {{ 'now' | date: '%Y' }} PANTAO &middot; Manila</span>
    {%- if shop.enabled_payment_types.size > 0 -%}
      <span class="pantao-footer__pay">
        {%- for type in shop.enabled_payment_types -%}{{ type | payment_type_svg_tag: class: 'pantao-footer__pay-svg' }}{%- endfor -%}
      </span>
    {%- endif -%}
  </div>
</div>

<style>
  .pantao-footer { width: 100%; color: var(--color-foreground); font-family: var(--font-body--family); }
  .pantao-footer__grid { display: grid; grid-template-columns: 1fr; gap: 2.5rem; align-items: start; }
  @media (min-width: 750px) { .pantao-footer__grid { grid-template-columns: 1fr 1fr; gap: clamp(2rem,5vw,4rem); } }
  @media (min-width: 990px) { .pantao-footer__grid { grid-template-columns: 1.3fr 1fr 1fr 1fr; } }
  .pantao-footer__kicker { font-family: var(--font-accent--family); font-style: italic; font-weight: 500; font-size: clamp(1.5rem,2.4vw,2rem); line-height: 1.1; margin: 0 0 .4rem; text-wrap: balance; }
  .pantao-footer__sub { font-size: .8125rem; letter-spacing: .02em; line-height: 1.6; margin: 0 0 1.4rem; max-width: 19rem; opacity: .62; }
  .pantao-footer__field { display: flex; align-items: center; gap: .5rem; border: 1px solid var(--color-border); border-radius: 100px; padding: 6px 6px 6px 18px; max-width: 22rem; background: var(--color-background); }
  .pantao-footer__field input { flex: 1 1 auto; min-width: 0; border: 0; outline: 0; background: transparent; font-family: inherit; font-size: 12px; letter-spacing: .14em; text-transform: uppercase; color: var(--color-foreground); }
  .pantao-footer__field input::placeholder { color: var(--color-foreground); opacity: .4; }
  .pantao-footer__join { flex: 0 0 auto; border: 0; border-radius: 100px; background: var(--color-foreground); color: var(--color-background); font-family: inherit; font-size: 11px; letter-spacing: .18em; text-transform: uppercase; padding: 11px 20px; cursor: pointer; transition: opacity .3s ease; }
  .pantao-footer__join:hover { opacity: .85; }
  .pantao-footer__col-heading { font-weight: 500; font-size: 11px; letter-spacing: .24em; text-transform: uppercase; margin: 0 0 1.1rem; }
  .pantao-footer__col-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: .7rem; }
  .pantao-footer__col-list a { font-size: 13px; letter-spacing: .02em; color: var(--color-foreground); opacity: .62; text-decoration: none; transition: opacity .25s ease; }
  .pantao-footer__col-list a:hover { opacity: 1; }
  .pantao-footer__base { margin-top: clamp(40px,5vw,60px); padding-top: 1.5rem; border-top: 1px solid var(--color-border); display: grid; grid-template-columns: 1fr; justify-items: center; gap: 1.2rem; text-align: center; }
  @media (min-width: 750px) { .pantao-footer__base { grid-template-columns: auto 1fr auto; align-items: center; gap: 1.5rem; text-align: left; } }
  .pantao-footer__wordmark { font-family: var(--font-accent--family); font-weight: 500; font-size: 1.5rem; letter-spacing: .04em; justify-self: start; }
  .pantao-footer__copy { font-size: 11px; letter-spacing: .14em; text-transform: uppercase; opacity: .55; }
  @media (min-width: 750px) { .pantao-footer__copy { justify-self: center; } }
  .pantao-footer__pay { display: flex; flex-wrap: wrap; gap: .5rem; align-items: center; justify-content: center; }
  @media (min-width: 750px) { .pantao-footer__pay { justify-self: end; } }
  .pantao-footer__pay-svg { height: 22px; width: auto; display: block; border-radius: 4px; }
</style>
