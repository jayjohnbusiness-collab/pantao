{%- comment -%}
  PANTAO minimal footer — Custom Liquid paste
  ------------------------------------------------------------------
  Paste this whole block into a "Custom Liquid" section in the theme editor
  (Footer group). It is self-contained: no {% render %}, no {% form %} tag,
  no theme snippets — so it works inside Custom Liquid and does NOT depend
  on GitHub sync. Links use your real menus/policies; the little script
  flattens the host section so the footer stays slim and on paper.
{%- endcomment -%}

{%- liquid
  assign fmenu = linklists.footer
  assign use_combined = false
  if fmenu == blank or fmenu.links.size == 0
    assign use_combined = true
  endif
  assign col1 = linklists['client-care']
  assign col2 = linklists['legal']
  assign col3 = linklists['social']
  assign has_cols = false
  if col1.links.size > 0 or col2.links.size > 0 or col3.links.size > 0
    assign has_cols = true
  endif
  assign year = 'now' | date: '%Y'
-%}

<div class="pmf">
  <div class="pmf__wrap">
    <nav class="pmf__links" aria-label="Footer">
      {%- if use_combined -%}
        {%- if has_cols -%}
          {%- for link in col1.links -%}<a href="{{ link.url }}">{{ link.title | escape }}</a>{%- endfor -%}
          {%- for link in col2.links -%}<a href="{{ link.url }}">{{ link.title | escape }}</a>{%- endfor -%}
          {%- for link in col3.links -%}<a href="{{ link.url }}">{{ link.title | escape }}</a>{%- endfor -%}
        {%- else -%}
          {%- for policy in shop.policies -%}
            {%- if policy != blank -%}<a href="{{ policy.url }}">{{ policy.title | escape }}</a>{%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      {%- else -%}
        {%- for link in fmenu.links -%}<a href="{{ link.url }}">{{ link.title | escape }}</a>{%- endfor -%}
      {%- endif -%}

      {%- if localization.available_countries and localization.available_countries.size > 1 -%}
        <form method="post" action="/localization" accept-charset="UTF-8" class="pmf__loc">
          <input type="hidden" name="form_type" value="localization">
          <input type="hidden" name="utf8" value="✓">
          <span class="pmf__loc-label">Country:</span>
          <span class="pmf__loc-field">
            <select name="country_code" aria-label="Country" onchange="this.form.submit()">
              {%- for c in localization.available_countries -%}
                <option value="{{ c.iso_code }}"{% if c.iso_code == localization.country.iso_code %} selected{% endif %}>{{ c.name }}</option>
              {%- endfor -%}
            </select>
          </span>
          <input type="hidden" name="return_to" value="{{ request.path }}">
        </form>
      {%- endif -%}
    </nav>

    <div class="pmf__copy">&copy; {{ year }} PANTAO &middot; Manila</div>
  </div>
</div>

<style>
  .pmf {
    --pmf-ink: #16181c;
    --pmf-paper: #f4f4f2;
    --pmf-muted: rgba(22, 24, 28, 0.52);
    --pmf-line: rgba(22, 24, 28, 0.12);
    --pmf-accent: #b5271f;
    background: var(--pmf-paper);
    color: var(--pmf-ink);
    border-top: 1px solid var(--pmf-line);
    font-family: var(--font-body--family, -apple-system, system-ui, sans-serif);
  }
  .pmf__wrap {
    max-width: 1600px;
    margin: 0 auto;
    padding: 14px clamp(20px, 4vw, 48px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px 30px;
    flex-wrap: wrap;
  }
  .pmf__links { display: flex; align-items: center; flex-wrap: wrap; gap: clamp(14px, 1.9vw, 28px); }
  .pmf__links > a {
    font-size: 12px; font-weight: 400; letter-spacing: 0.01em; line-height: 1;
    color: var(--pmf-ink); text-decoration: none; transition: color 0.2s ease;
  }
  .pmf__links > a:hover, .pmf__links > a:focus-visible { color: var(--pmf-accent); }

  .pmf__loc { display: inline-flex; align-items: center; gap: 0.4em; margin: 0; font-size: 12px; color: var(--pmf-muted); }
  .pmf__loc-field { position: relative; color: var(--pmf-ink); border-bottom: 1px solid var(--pmf-line); }
  .pmf__loc select {
    appearance: none; -webkit-appearance: none; border: 0; background: transparent; font: inherit;
    color: var(--pmf-ink); padding: 2px 16px 2px 0; cursor: pointer;
  }
  .pmf__loc-field::after {
    content: ""; position: absolute; right: 2px; top: 50%; width: 6px; height: 6px;
    border-right: 1px solid var(--pmf-muted); border-bottom: 1px solid var(--pmf-muted);
    transform: translateY(-70%) rotate(45deg); pointer-events: none;
  }
  .pmf__loc select:hover { color: var(--pmf-accent); }

  .pmf__copy {
    font-size: 11px; font-weight: 400; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--pmf-muted); white-space: nowrap;
  }

  @media screen and (max-width: 720px) {
    .pmf__wrap { flex-direction: column; align-items: flex-start; gap: 14px; }
    .pmf__links { gap: 12px 18px; }
  }
</style>

<script>
  (function () {
    var s = document.currentScript;
    var sec = s && s.closest ? s.closest('.shopify-section') : null;
    if (!sec) return;
    sec.style.setProperty('background', '#f4f4f2', 'important');
    sec.style.setProperty('padding', '0', 'important');
    var kill = sec.querySelectorAll('.section, .section-background, [class*="spacing-style"], .shopify-section__inner');
    for (var i = 0; i < kill.length; i++) {
      if (kill[i].className.indexOf('section-background') > -1) { kill[i].style.display = 'none'; continue; }
      kill[i].style.setProperty('padding', '0', 'important');
      kill[i].style.setProperty('margin', '0', 'important');
      kill[i].style.setProperty('max-width', 'none', 'important');
    }
  })();
</script>
