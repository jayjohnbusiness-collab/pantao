{% doc %}
  @prompt
    Generate a one row product collection menu in button style. Include button adjustment settings such as button edges, height, width, hover color, outline color, fill color, and fill color transparency toggle option. Include menu settings for padding, theme, background color, transparency. Include settings to link collections for each button and Menu should include menu wrapping settings.. Menu actions: Scroll left or right when a button is selected., Include menu stacking option for mobile. It should have the option to scroll or stack.

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-menu-{{ ai_gen_id }} {
    background-color: {% if block.settings.background_transparency %}rgba({{ block.settings.background_color | color_extract: 'red' }}, {{ block.settings.background_color | color_extract: 'green' }}, {{ block.settings.background_color | color_extract: 'blue' }}, {{ block.settings.background_opacity }}){% else %}{{ block.settings.background_color }}{% endif %};
    padding: {{ block.settings.menu_padding }}px;
    border-radius: {{ block.settings.menu_border_radius }}px;
    overflow: hidden;
  }

  .ai-collection-menu__container-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
  }

  .ai-collection-menu__wrapper-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.button_spacing }}px;
    overflow-x: auto;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
    {% if block.settings.menu_wrap %}
      flex-wrap: wrap;
    {% else %}
      flex-wrap: nowrap;
    {% endif %}
  }

  .ai-collection-menu__wrapper-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-collection-menu__button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: {{ block.settings.button_width }}px;
    height: {{ block.settings.button_height }}px;
    padding: 0 16px;
    background-color: {% if block.settings.fill_transparency %}rgba({{ block.settings.fill_color | color_extract: 'red' }}, {{ block.settings.fill_color | color_extract: 'green' }}, {{ block.settings.fill_color | color_extract: 'blue' }}, {{ block.settings.fill_opacity }}){% else %}{{ block.settings.fill_color }}{% endif %};
    color: {{ block.settings.text_color }};
    border: {{ block.settings.outline_width }}px solid {{ block.settings.outline_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    text-decoration: none;
    font-size: {{ block.settings.text_size }}px;
    font-weight: {{ block.settings.text_weight }};
    text-transform: {% if block.settings.text_uppercase %}uppercase{% else %}none{% endif %};
    cursor: pointer;
    transition: all0.3s ease;
    white-space: nowrap;
    flex-shrink: 0;}

  .ai-collection-menu__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.hover_color }};
    color: {{ block.settings.hover_text_color }};
    border-color: {{ block.settings.hover_outline_color }};
    transform: translateY(-2px);
  }

  .ai-collection-menu__button-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.active_color }};
    color: {{ block.settings.active_text_color }};
    border-color: {{ block.settings.active_outline_color }};
  }

  .ai-collection-menu__nav-button-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width:40px;
    height: 40px;
    background-color: {{ block.settings.nav_button_color }};
    border: none;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    transition: opacity 0.3s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .ai-collection-menu__nav-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.nav_button_hover_color }};
  }

  .ai-collection-menu__nav-button-{{ ai_gen_id }}.hidden {
    opacity: 0;
    pointer-events: none;
  }

  .ai-collection-menu__nav-button--left-{{ ai_gen_id }} {
    left: 10px;
  }

  .ai-collection-menu__nav-button--right-{{ ai_gen_id }} {
    right: 10px;
  }

  .ai-collection-menu__nav-button-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
    fill: {{ block.settings.nav_button_icon_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-collection-menu-{{ ai_gen_id }} {
      padding: {{ block.settings.menu_padding | times: 0.7 }}px;
    }

    .ai-collection-menu__button-{{ ai_gen_id }} {
      min-width: {{ block.settings.mobile_button_width }}px;
      height: {{ block.settings.mobile_button_height }}px;
      font-size: {{ block.settings.mobile_text_size }}px;
    }

    {% if block.settings.mobile_layout == 'stack' %}
      .ai-collection-menu__wrapper-{{ ai_gen_id }} {
        flex-direction: column;
        overflow-x: visible;
        align-items: {% if block.settings.mobile_alignment == 'left' %}flex-start{% elsif block.settings.mobile_alignment == 'center' %}center{% else %}flex-end{% endif %};
      }

      .ai-collection-menu__button-{{ ai_gen_id }} {
        width: {% if block.settings.mobile_button_full_width %}100%{% else %}auto{% endif %};
        flex-shrink: 1;
      }

      .ai-collection-menu__nav-button-{{ ai_gen_id }} {
        display: none;
      }
    {% elsif block.settings.mobile_layout == 'scroll' %}
      .ai-collection-menu__wrapper-{{ ai_gen_id }} {
        flex-wrap: nowrap;
        overflow-x: auto;
      }

      .ai-collection-menu__button-{{ ai_gen_id }} {
        flex-shrink: 0;
      }
    {% endif %}

    {% if block.settings.mobile_layout == 'grid' %}
      .ai-collection-menu__wrapper-{{ ai_gen_id }} {
        display: grid;
        grid-template-columns: repeat({{ block.settings.mobile_columns }}, 1fr);
        gap: {{ block.settings.button_spacing | times: 0.7 }}px;
        overflow-x: visible;
      }

      .ai-collection-menu__button-{{ ai_gen_id }} {
        min-width: auto;
        width: 100%;
        flex-shrink: 1;
      }

      .ai-collection-menu__nav-button-{{ ai_gen_id }} {
        display: none;
      }
    {% endif %}
  }
{% endstyle %}

<collection-menu-{{ ai_gen_id }}
  class="ai-collection-menu-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-collection-menu__container-{{ ai_gen_id }}">
    {% unless block.settings.menu_wrap %}
      <button
        class="ai-collection-menu__nav-button-{{ ai_gen_id }} ai-collection-menu__nav-button--left-{{ ai_gen_id }}"
        aria-label="Scroll left"
        data-direction="left"
      >
        <svg viewBox="0 0 24 24">
          <path d="M15 18l-6-6 6-6"/>
        </svg>
      </button>

      <button
        class="ai-collection-menu__nav-button-{{ ai_gen_id }} ai-collection-menu__nav-button--right-{{ ai_gen_id }}"
        aria-label="Scroll right"
        data-direction="right"
      >
        <svg viewBox="0 0 24 24">
          <path d="M9 18l6-6-6-6"/>
        </svg>
      </button>
    {% endunless %}

    <div class="ai-collection-menu__wrapper-{{ ai_gen_id }}">
      {% for i in (1..8) %}
        {% liquid
          assign collection_key = 'collection_' | append: i
          assign label_key = 'collection_' | append: i | append: '_label'
          assign collection = block.settings[collection_key]
          assign label = block.settings[label_key]
        %}

        {% if collection != blank %}
          <a
            href="{{ collection.url }}"
            class="ai-collection-menu__button-{{ ai_gen_id }}"
            data-collection-id="{{ collection.id }}"
          >
            {% if label != blank %}
              {{ label }}
            {% else %}
              {{ collection.title }}
            {% endif %}
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</collection-menu-{{ ai_gen_id }}><script>
  (function() {
    class CollectionMenu{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.wrapper = this.querySelector('.ai-collection-menu__wrapper-{{ ai_gen_id }}');
        this.leftButton = this.querySelector('.ai-collection-menu__nav-button--left-{{ ai_gen_id }}');
        this.rightButton = this.querySelector('.ai-collection-menu__nav-button--right-{{ ai_gen_id }}');
        this.buttons = this.querySelectorAll('.ai-collection-menu__button-{{ ai_gen_id }}');
      }

      connectedCallback() {
        this.setupNavigation();
        this.updateNavButtons();
        this.setActiveButton();
        this.handleResize();
        window.addEventListener('resize', () => this.handleResize());
      }

      setupNavigation() {
        if (this.leftButton && this.rightButton) {
          this.leftButton.addEventListener('click', () => this.scroll('left'));
          this.rightButton.addEventListener('click', () => this.scroll('right'));
          this.wrapper.addEventListener('scroll', () => this.updateNavButtons());
        }

        this.buttons.forEach(button => {
          button.addEventListener('click', (e) => {
            this.setActiveButton(button);
            this.scrollToButton(button);
          });
        });
      }

      handleResize() {
        setTimeout(() => {
          this.updateNavButtons();
        }, 100);
      }

      scroll(direction) {
        const scrollAmount = 200;
        const currentScroll = this.wrapper.scrollLeft;
        
        if (direction === 'left') {
          this.wrapper.scrollTo({
            left: currentScroll - scrollAmount,
            behavior: 'smooth'
          });
        } else {
          this.wrapper.scrollTo({
            left: currentScroll + scrollAmount,
            behavior: 'smooth'
          });
        }
      }

      scrollToButton(button) {
        if (window.innerWidth <= 749) {
          const mobileLayout = '{{ block.settings.mobile_layout }}';
          if (mobileLayout === 'stack' || mobileLayout === 'grid') {
            return;
          }
        }

        const buttonRect = button.getBoundingClientRect();
        const wrapperRect = this.wrapper.getBoundingClientRect();
        const scrollLeft = this.wrapper.scrollLeft;
        
        const buttonLeft = buttonRect.left - wrapperRect.left + scrollLeft;
        const buttonCenter = buttonLeft + (buttonRect.width / 2);
        const wrapperCenter = this.wrapper.offsetWidth / 2;
        
        this.wrapper.scrollTo({
          left: buttonCenter - wrapperCenter,
          behavior: 'smooth'
        });
      }

      updateNavButtons() {
        if (!this.leftButton || !this.rightButton) return;

        if (window.innerWidth <= 749) {
          const mobileLayout = '{{ block.settings.mobile_layout }}';
          if (mobileLayout === 'stack' || mobileLayout === 'grid') {
            this.leftButton.style.display = 'none';
            this.rightButton.style.display = 'none';
            return;
          } else {
            this.leftButton.style.display = 'flex';
            this.rightButton.style.display = 'flex';
          }
        }

        const isAtStart = this.wrapper.scrollLeft <= 0;
        const isAtEnd = this.wrapper.scrollLeft >= this.wrapper.scrollWidth - this.wrapper.offsetWidth;

        this.leftButton.classList.toggle('hidden', isAtStart);
        this.rightButton.classList.toggle('hidden', isAtEnd);
      }

      setActiveButton(clickedButton = null) {
        this.buttons.forEach(button => button.classList.remove('active'));
        if (clickedButton) {
          clickedButton.classList.add('active');
        } else {
          const currentPath = window.location.pathname;
          this.buttons.forEach(button => {
            if (button.getAttribute('href') === currentPath) {
              button.classList.add('active');
            }
          });
        }
      }
    }

    customElements.define('collection-menu-{{ ai_gen_id }}', CollectionMenu{{ ai_gen_id }});
  })();
</script>

